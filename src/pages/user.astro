---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import 'leaflet/dist/leaflet.css';
import FoodOrderPopup from '../components/campusmaas/FoodOrderPopup.astro';
import PrintOrderPopup from '../components/campusmaas/PrintOrderPopup.astro';
---

<MainLayout title="CampusMaaS">
  <main class="user-map-page">
    <div id="map" class="map map-local" aria-label="CampusMaaS campus map"></div>

    <section class="user-trip-card" aria-label="Campus trip">
      <div class="user-trip-field">
        <span>From</span>
        <strong id="userTripFrom">Point A</strong>
      </div>

      <div class="user-trip-divider" aria-hidden="true"></div>

      <div class="user-trip-field">
        <span>To</span>
        <strong id="userTripTo">Point B</strong>
      </div>

      <div class="user-trip-summary">
        <div>
          <span>Journey time</span>
          <strong id="userTripTime">—</strong>
        </div>
        <div>
          <span>Distance</span>
          <strong id="userTripDistance">—</strong>
        </div>
      </div>

      <div class="user-trip-profile">
        <span>Passenger</span>
        <div class="user-gender-toggle" role="group" aria-label="User gender">
          <button type="button" class="user-gender-button is-active" id="userGenderMale" data-user-group="boys" aria-pressed="true" aria-label="Male">
            <span class="user-gender-icon" aria-hidden="true">♂</span>
            <span>Male</span>
          </button>
          <button type="button" class="user-gender-button" id="userGenderFemale" data-user-group="girls" aria-pressed="false" aria-label="Female">
            <span class="user-gender-icon" aria-hidden="true">♀</span>
            <span>Female</span>
          </button>
        </div>
      </div>
    </section>

    <aside class="user-services-stack" id="userServicesCard" aria-label="Campus services">
      <div class="user-services-label">
        <span class="user-services-kicker">CAMPUS SERVICES</span>
        <strong>Place an order</strong>
      </div>

      <div id="userVendorList" class="user-vendor-list">
        <div class="user-services-empty">Loading services…</div>
      </div>

      <div id="userOrderComposer" class="user-order-composer" hidden></div>

      <section class="user-orders-card" aria-label="Your orders">
        <div class="user-orders-head">
          <div>
            <span class="user-services-kicker">YOUR ORDERS</span>
            <strong>Order history</strong>
          </div>
          <span id="userOrderCount">0 orders</span>
        </div>
        <div id="userOrderList" class="user-order-list">
          <div class="user-services-empty">No orders yet.</div>
        </div>
      </section>
    </aside>

    <FoodOrderPopup />
    <PrintOrderPopup />

    <script>
      import L from 'leaflet';


const PATH_COLORS = Object.freeze({
  'Main Road': '#e85d04',
  'Road': '#f2b134',
  'Ground': '#4f9d69',
  'Pedestrian Path': '#2563eb'
});

const PATH_WIDTHS = Object.freeze({
  'Main Road': 5.2,
  'Road': 4.3,
  'Ground': 4.4,
  'Pedestrian Path': 3.8
});

const normalizeCategory = (feature) => {
  const value = String(feature?.properties?.category || '').trim();

  if (PATH_COLORS[value]) return value;

  const highway = String(feature?.properties?.highway || '').toLowerCase();

  if (['motorway', 'trunk', 'primary', 'secondary', 'tertiary'].includes(highway)) {
    return 'Main Road';
  }

  if (['residential', 'unclassified', 'service', 'living_street', 'road', 'track'].includes(highway)) {
    return 'Road';
  }

  if (['path', 'footway', 'pedestrian', 'steps', 'custom'].includes(highway)) {
    return 'Pedestrian Path';
  }

  return 'Pedestrian Path';
};

const escapeHtml = (value) =>
  String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

const normalizeVendorStatus = (service) => {
  const status = String(service?.status || 'online').toLowerCase();
  return status === 'offline' || status === 'busy' ? status : 'online';
};

const vendorStatusLabel = (service) => {
  const status = normalizeVendorStatus(service);
  return status === 'offline' ? 'Offline' : status === 'busy' ? 'Busy' : 'Online';
};

const vendorStatusMessage = (service) => {
  const status = normalizeVendorStatus(service);
  return service?.status_message ||
    (status === 'offline'
      ? 'Currently unavailable'
      : status === 'busy'
        ? 'Currently serving customers'
        : 'Accepting new orders');
};

const vendorStatusMarkup = (service) => {
  const status = normalizeVendorStatus(service);
  return '<span class="user-vendor-status user-vendor-status-' + status + '">' +
    '<i aria-hidden="true"></i><span>' + vendorStatusLabel(service) + '</span></span>';
};

const distanceMeters = (a, b) =>
  L.latLng(Number(a[1]), Number(a[0]))
    .distanceTo(L.latLng(Number(b[1]), Number(b[0])));

const getRoadKind = (feature) =>
  String(feature?.properties?.highway || '').toLowerCase();

const isRoad = (feature) =>
  Boolean(feature?.properties?.highway || feature?.properties?.route);

const roadWidth = {
  motorway: 7,
  trunk: 6.5,
  primary: 6,
  secondary: 5.5,
  tertiary: 5,
  residential: 4.4,
  unclassified: 4,
  service: 3.4,
  footway: 2.7,
  path: 2.4
};

const roadStyle = (feature, casing = false) => {
  const kind = getRoadKind(feature);
  const width = roadWidth[kind] || 3.5;
  const major = ['motorway', 'trunk', 'primary', 'secondary', 'tertiary'].includes(kind);
  const mainExternalRoad =
    feature?.id === 'way/129894647' ||
    feature?.properties?.ref === 'MDR1137';

  return {
    color: casing
      ? '#c7c5c0'
      : (mainExternalRoad ? '#111827' : (major ? '#e9c67b' : '#ffffff')),
    weight: casing ? width + 2.2 : width,
    opacity: 0.96,
    lineCap: 'round',
    lineJoin: 'round'
  };
};

const findBuildingCenter = (places, nameFragment) => {
  const feature = (places?.features || []).find((item) =>
    String(item?.properties?.name || '')
      .toLowerCase()
      .includes(nameFragment.toLowerCase())
  );

  if (!feature?.geometry) return null;

  const layer = L.geoJSON(feature);
  const bounds = layer.getBounds();

  return bounds.isValid() ? bounds.getCenter() : null;
};

const USER_ROUTE_CONNECT_RADIUS_M = 40;
const USER_GATE_MATCH_RADIUS_M = 25;
const ALL_POLICY_DAYS = Object.freeze([
  'mon',
  'tue',
  'wed',
  'thu',
  'fri',
  'sat',
  'sun'
]);

const policyTemporalState = (timezone = 'Asia/Kolkata', date = new Date()) => {
  const parts = new Intl.DateTimeFormat('en-IN', {
    timeZone: timezone,
    weekday: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
  }).formatToParts(date);

  const read = (type) =>
    parts.find((part) => part.type === type)?.value || '';

  return {
    day: read('weekday').slice(0, 3).toLowerCase(),
    time: read('hour') + ':' + read('minute')
  };
};

const policyMatchesNow = (policy, temporal) => {
  if (policy?.enabled === false) return false;

  const days = Array.isArray(policy?.days) && policy.days.length
    ? policy.days
    : ALL_POLICY_DAYS;

  if (!days.includes(temporal.day)) return false;

  const windows =
    Array.isArray(policy?.windows)
      ? policy.windows
      : Array.isArray(policy?.condition?.time_windows)
        ? policy.condition.time_windows
        : [];

  if (!windows.length) return true;

  const current = minutesFromClockValue(temporal.time);

  return windows.some((window) => {
    const start = minutesFromClockValue(window?.start);
    const end = minutesFromClockValue(window?.end);
    return current >= start && current <= end;
  });
};

const minutesFromClockValue = (value) => {
  const [hours, minutes] = String(value || '00:00').split(':').map(Number);
  return hours * 60 + minutes;
};

const policyAppliesToGroup = (policy, group) => {
  const policyGroup = String(policy?.group || 'all');
  const userGroup = String(group || 'students');

  if (policyGroup === 'all' || policyGroup === userGroup) {
    return true;
  }

  /*
   * Boys/girls/hostellers/day scholars are student sub-groups.
   * A generic "students" policy therefore applies to all of them.
   */
  if (
    policyGroup === 'students' &&
    ['boys', 'girls', 'hostellers', 'day_scholars'].includes(userGroup)
  ) {
    return true;
  }

  return false;
};

const policyDirectionAllows = (policy, direction = '') => {
  const policyDirection = String(policy?.direction || 'in_out');

  return policyDirection === 'in_out' ||
    !direction ||
    policyDirection === direction;
};

const gatePoliciesForRoute = (gate, accessPolicy, group = 'students', direction = '') =>
  (accessPolicy?.policies || []).filter(
    (policy) =>
      policy?.target?.type === 'gate' &&
      String(policy?.target?.id) === String(gate?.id) &&
      policyAppliesToGroup(policy, group) &&
      policyDirectionAllows(policy, direction) &&
      policy?.enabled !== false
  );

const policyHasCondition = (policy) => {
  const windows =
    Array.isArray(policy?.windows)
      ? policy.windows
      : Array.isArray(policy?.condition?.time_windows)
        ? policy.condition.time_windows
        : [];

  const days = Array.isArray(policy?.days) ? policy.days : ALL_POLICY_DAYS;

  return windows.length > 0 ||
    days.length !== ALL_POLICY_DAYS.length ||
    days.some((day, index) => day !== ALL_POLICY_DAYS[index]);
};

const pathFeatureAllowed = (feature, accessPolicy, group = 'students') => {
  const temporal = policyTemporalState(accessPolicy?.timezone || 'Asia/Kolkata');
  const policies = (accessPolicy?.policies || []).filter(
    (policy) =>
      policy?.target?.type === 'path' &&
      String(policy?.target?.id) === String(feature?.id) &&
      policyAppliesToGroup(policy, group) &&
      policy?.enabled !== false
  );

  if (!policies.length) return true;

  const activePolicies = policies.filter((policy) =>
    policyMatchesNow(policy, temporal)
  );

  if (
    activePolicies.some(
      (policy) =>
        policy.mode === 'deny' ||
        policy.mode === 'deny_during'
    )
  ) {
    return false;
  }

  const allowOnlyPolicies = policies.filter(
    (policy) => policy.mode === 'allow_only_during'
  );

  if (allowOnlyPolicies.length) {
    return allowOnlyPolicies.some((policy) =>
      activePolicies.includes(policy)
    );
  }

  const conditionalAllowPolicies = policies.filter(
    (policy) =>
      policy.mode === 'allow' &&
      policyHasCondition(policy)
  );

  if (conditionalAllowPolicies.length) {
    return conditionalAllowPolicies.some((policy) =>
      activePolicies.includes(policy)
    );
  }

  return true;
};

const projectPointToPath = (pathData, latlng) => {
  let best = null;

  const referenceLat = latlng.lat * Math.PI / 180;
  const metersPerLat = 111320;
  const metersPerLng = 111320 * Math.cos(referenceLat);

  const project = (coordinate) => ({
    x: (Number(coordinate[0]) - latlng.lng) * metersPerLng,
    y: (Number(coordinate[1]) - latlng.lat) * metersPerLat
  });

  const unproject = (point) =>
    L.latLng(
      latlng.lat + point.y / metersPerLat,
      latlng.lng + point.x / metersPerLng
    );

  for (
    let featureIndex = 0;
    featureIndex < (pathData?.features || []).length;
    featureIndex += 1
  ) {
    const feature = pathData.features[featureIndex];

    if (feature?.geometry?.type !== 'LineString') continue;

    const coordinates = feature.geometry.coordinates;

    for (
      let segmentIndex = 0;
      segmentIndex < coordinates.length - 1;
      segmentIndex += 1
    ) {
      const a = coordinates[segmentIndex];
      const b = coordinates[segmentIndex + 1];
      const pa = project(a);
      const pb = project(b);
      const dx = pb.x - pa.x;
      const dy = pb.y - pa.y;
      const lengthSquared = dx * dx + dy * dy;

      const t = lengthSquared > 0
        ? Math.max(
            0,
            Math.min(
              1,
              -(pa.x * dx + pa.y * dy) / lengthSquared
            )
          )
        : 0;

      const projected = {
        x: pa.x + dx * t,
        y: pa.y + dy * t
      };

      const distance = Math.hypot(projected.x, projected.y);

      if (!best || distance < best.distance) {
        best = {
          point: unproject(projected),
          distance,
          featureIndex,
          segmentIndex,
          a,
          b
        };
      }
    }
  }

  return best;
};

/*
 * Exact user clicks are preserved as route endpoints.
 * The nearest path location is only a temporary internal routing anchor.
 */
/*
 * Build an intersection-aware user routing graph.
 *
 * The stored GeoJSON often contains lines that cross without sharing an
 * explicit coordinate. Those crossings must become graph nodes, otherwise
 * the router can miss the physically short route and take a large detour.
 *
 * User clicks remain exact endpoints. Multiple nearby path candidates are
 * connected to each endpoint; Dijkstra then chooses the best complete route.
 */
const routeSummary = (
  pathData,
  startPoint,
  endPoint,
  accessPolicy,
  userGroup = 'boys',
  gates = []
) => {
  const temporal = policyTemporalState(
    accessPolicy?.timezone || 'Asia/Kolkata'
  );

  const gateFeatureIsBlocked = (gate) => {
    const policies = gatePoliciesForRoute(gate, accessPolicy, userGroup, '');
    const universalPolicies = policies.filter(
      (policy) => String(policy?.direction || 'in_out') === 'in_out'
    );

    if (!universalPolicies.length) return false;

    if (
      universalPolicies.some(
        (policy) =>
          (policy.mode === 'deny' || policy.mode === 'deny_during') &&
          policyMatchesNow(policy, temporal)
      )
    ) {
      return true;
    }

    const allowOnly = universalPolicies.filter(
      (policy) => policy.mode === 'allow_only_during'
    );

    return allowOnly.length > 0 &&
      !allowOnly.some((policy) => policyMatchesNow(policy, temporal));
  };

  const blockedGates = (gates || []).filter(gateFeatureIsBlocked);

  const pointToFeatureDistance = (point, feature) => {
    const lines =
      feature?.geometry?.type === 'LineString'
        ? [feature.geometry.coordinates]
        : feature?.geometry?.type === 'MultiLineString'
          ? feature.geometry.coordinates
          : [];

    let best = Infinity;

    for (const line of lines) {
      if (!Array.isArray(line) || line.length < 2) continue;

      for (let index = 0; index < line.length - 1; index += 1) {
        const a = line[index];
        const b = line[index + 1];
        const projected = projectPointToPath(
          {
            features: [{
              geometry: {
                type: 'LineString',
                coordinates: [a, b]
              }
            }]
          },
          point
        );

        if (projected) best = Math.min(best, projected.distance);
      }
    }

    return best;
  };

  const pathPassesBlockedGate = (feature) =>
    blockedGates.some((gate) => {
      const coordinate =
        gate?.properties?.access_point ||
        gate?.properties?.center;

      if (!Array.isArray(coordinate) || coordinate.length < 2) return false;

      const gatePoint = L.latLng(
        Number(coordinate[1]),
        Number(coordinate[0])
      );

      const radius =
        Math.max(
          8,
          (Number(gate?.properties?.width_m) || 2) * 0.5 + 4
        );

      return pointToFeatureDistance(gatePoint, feature) <= radius;
    });

  const routablePathData = {
    ...pathData,
    features: (pathData?.features || [])
      .map((feature, index) => ({
        ...feature,
        id: String(
          feature?.id ||
          feature?.properties?.['@id'] ||
          feature?.properties?.id ||
          'path-' + (index + 1)
        )
      }))
      .filter((feature) =>
        pathFeatureAllowed(feature, accessPolicy, userGroup) &&
        !pathPassesBlockedGate(feature)
      )
  };

  const toRoutingXY = (coordinate) => {
    const scaleX =
      111320 *
      Math.cos(Number(centerForRoutingLat) * Math.PI / 180);
    const scaleY = 111320;

    return {
      x: Number(coordinate[0]) * scaleX,
      y: Number(coordinate[1]) * scaleY
    };
  };

  const centerForRoutingLat = Number(
    (
      (Number(startPoint.lat) + Number(endPoint.lat)) / 2
    )
  );

  const interpolateCoordinate = (a, b, fraction) => [
    Number(a[0]) + (Number(b[0]) - Number(a[0])) * fraction,
    Number(a[1]) + (Number(b[1]) - Number(a[1])) * fraction
  ];

  const distanceBetweenCoordinates = (a, b) =>
    L.latLng(Number(a[1]), Number(a[0]))
      .distanceTo(L.latLng(Number(b[1]), Number(b[0])));

  const cross2D = (a, b) =>
    a.x * b.y - a.y * b.x;

  const pointOnSegmentFraction = (point, a, b, toleranceMeters = 0.05) => {
    const p = toRoutingXY(point);
    const ax = toRoutingXY(a);
    const bx = toRoutingXY(b);

    const dx = bx.x - ax.x;
    const dy = bx.y - ax.y;
    const lengthSquared = dx * dx + dy * dy;

    if (lengthSquared === 0) return null;

    const fraction = Math.max(
      0,
      Math.min(
        1,
        ((p.x - ax.x) * dx + (p.y - ax.y) * dy) / lengthSquared
      )
    );

    const nearest = {
      x: ax.x + dx * fraction,
      y: ax.y + dy * fraction
    };

    if (
      Math.hypot(p.x - nearest.x, p.y - nearest.y) >
      toleranceMeters
    ) {
      return null;
    }

    return fraction;
  };

  const segmentIntersectionFractions = (first, second) => {
    const p = toRoutingXY(first.a);
    const p2 = toRoutingXY(first.b);
    const q = toRoutingXY(second.a);
    const q2 = toRoutingXY(second.b);

    const r = {
      x: p2.x - p.x,
      y: p2.y - p.y
    };

    const qMinusP = {
      x: q.x - p.x,
      y: q.y - p.y
    };

    const s = {
      x: q2.x - q.x,
      y: q2.y - q.y
    };

    const denominator = cross2D(r, s);
    const fractions = [];

    if (Math.abs(denominator) > 1e-9) {
      const t = cross2D(qMinusP, s) / denominator;
      const u = cross2D(qMinusP, r) / denominator;

      if (
        t >= -1e-9 &&
        t <= 1 + 1e-9 &&
        u >= -1e-9 &&
        u <= 1 + 1e-9
      ) {
        fractions.push({
          first: Math.max(0, Math.min(1, t)),
          second: Math.max(0, Math.min(1, u))
        });
      }

      return fractions;
    }

    /*
     * Parallel/collinear segments only connect when one segment endpoint
     * actually lies on the other segment. Merely nearby parallel paths
     * remain separate.
     */
    const firstStartOnSecond = pointOnSegmentFraction(
      first.a,
      second.a,
      second.b
    );

    if (firstStartOnSecond !== null) {
      fractions.push({
        first: 0,
        second: firstStartOnSecond
      });
    }

    const firstEndOnSecond = pointOnSegmentFraction(
      first.b,
      second.a,
      second.b
    );

    if (firstEndOnSecond !== null) {
      fractions.push({
        first: 1,
        second: firstEndOnSecond
      });
    }

    const secondStartOnFirst = pointOnSegmentFraction(
      second.a,
      first.a,
      first.b
    );

    if (secondStartOnFirst !== null) {
      fractions.push({
        first: secondStartOnFirst,
        second: 0
      });
    }

    const secondEndOnFirst = pointOnSegmentFraction(
      second.b,
      first.a,
      first.b
    );

    if (secondEndOnFirst !== null) {
      fractions.push({
        first: secondEndOnFirst,
        second: 1
      });
    }

    return fractions;
  };

  const rawSegments = [];

  for (
    let featureIndex = 0;
    featureIndex < (routablePathData.features || []).length;
    featureIndex += 1
  ) {
    const feature = routablePathData.features[featureIndex];
    const geometry = feature?.geometry;

    if (!geometry) continue;

    const lines =
      geometry.type === 'LineString'
        ? [geometry.coordinates]
        : geometry.type === 'MultiLineString'
          ? geometry.coordinates
          : [];

    for (
      let lineIndex = 0;
      lineIndex < lines.length;
      lineIndex += 1
    ) {
      const line = lines[lineIndex];

      if (!Array.isArray(line) || line.length < 2) continue;

      for (
        let segmentIndex = 0;
        segmentIndex < line.length - 1;
        segmentIndex += 1
      ) {
        const a = line[segmentIndex];
        const b = line[segmentIndex + 1];
        const distance = distanceBetweenCoordinates(a, b);

        if (distance <= 0) continue;

        rawSegments.push({
          featureId: String(feature.id),
          featureIndex,
          lineIndex,
          segmentIndex,
          a,
          b,
          distance
        });
      }
    }
  }

  if (!rawSegments.length) return null;

  const splitFractions = rawSegments.map(() => [0, 1]);

  for (
    let firstIndex = 0;
    firstIndex < rawSegments.length;
    firstIndex += 1
  ) {
    for (
      let secondIndex = firstIndex + 1;
      secondIndex < rawSegments.length;
      secondIndex += 1
    ) {
      const first = rawSegments[firstIndex];
      const second = rawSegments[secondIndex];

      if (
        first.featureId === second.featureId &&
        first.lineIndex === second.lineIndex &&
        Math.abs(first.segmentIndex - second.segmentIndex) <= 1
      ) {
        continue;
      }

      const intersections =
        segmentIntersectionFractions(first, second);

      for (const intersection of intersections) {
        splitFractions[firstIndex].push(intersection.first);
        splitFractions[secondIndex].push(intersection.second);
      }
    }
  }

  const graph = new Map();
  const coordinates = new Map();
  const graphSegments = [];

  const graphKey = (coordinate) =>
    Number(coordinate[0]).toFixed(7) + ',' +
    Number(coordinate[1]).toFixed(7);

  const addNode = (key, coordinate) => {
    if (!graph.has(key)) graph.set(key, []);
    coordinates.set(key, coordinate);
  };

  const addEdge = (fromKey, toKey, distance) => {
    if (fromKey === toKey || distance <= 0) return;

    if (!graph.has(fromKey)) graph.set(fromKey, []);
    if (!graph.has(toKey)) graph.set(toKey, []);

    graph.get(fromKey).push({
      node: toKey,
      distance
    });

    graph.get(toKey).push({
      node: fromKey,
      distance
    });
  };

  for (
    let segmentIndex = 0;
    segmentIndex < rawSegments.length;
    segmentIndex += 1
  ) {
    const segment = rawSegments[segmentIndex];

    const fractions = Array.from(
      new Set(
        splitFractions[segmentIndex]
          .map((value) =>
            Number(
              Math.max(0, Math.min(1, value)).toFixed(10)
            )
          )
      )
    ).sort((a, b) => a - b);

    const splitCoordinates = fractions.map((fraction) =>
      interpolateCoordinate(segment.a, segment.b, fraction)
    );

    for (
      let partIndex = 0;
      partIndex < splitCoordinates.length - 1;
      partIndex += 1
    ) {
      const a = splitCoordinates[partIndex];
      const b = splitCoordinates[partIndex + 1];
      const distance = distanceBetweenCoordinates(a, b);

      if (distance <= 0) continue;

      const aKey = graphKey(a);
      const bKey = graphKey(b);

      addNode(aKey, a);
      addNode(bKey, b);
      addEdge(aKey, bKey, distance);

      graphSegments.push({
        a,
        b,
        aKey,
        bKey,
        distance,
        sourceFeatureId: segment.featureId,
        sourceFeatureIndex: segment.featureIndex,
        sourceSegmentIndex: segment.segmentIndex,
        fractionStart: fractions[partIndex],
        fractionEnd: fractions[partIndex + 1]
      });
    }
  }

  const projectToSegment = (point, a, b) => {
    const refLat =
      Number(point.lat) * Math.PI / 180;
    const scaleX = 111320 * Math.cos(refLat);
    const scaleY = 111320;

    const px = Number(point.lng) * scaleX;
    const py = Number(point.lat) * scaleY;
    const ax = Number(a[0]) * scaleX;
    const ay = Number(a[1]) * scaleY;
    const bx = Number(b[0]) * scaleX;
    const by = Number(b[1]) * scaleY;

    const dx = bx - ax;
    const dy = by - ay;
    const lengthSquared = dx * dx + dy * dy;

    if (lengthSquared === 0) {
      return {
        coordinate: [Number(a[0]), Number(a[1])],
        fraction: 0,
        distance: Math.hypot(px - ax, py - ay)
      };
    }

    const fraction = Math.max(
      0,
      Math.min(
        1,
        ((px - ax) * dx + (py - ay) * dy) /
          lengthSquared
      )
    );

    const x = ax + fraction * dx;
    const y = ay + fraction * dy;

    return {
      coordinate: [
        x / scaleX,
        y / scaleY
      ],
      fraction,
      distance: Math.hypot(px - x, py - y)
    };
  };

  const preferredGateForPoint = (point, direction) => {
    const matches = (gates || [])
      .map((gate) => {
        const coordinate =
          gate?.properties?.access_point ||
          gate?.properties?.center;

        if (!Array.isArray(coordinate) || coordinate.length < 2) return null;

        const policies = gatePoliciesForRoute(
          gate,
          accessPolicy,
          userGroup,
          direction
        ).filter((policy) =>
          policy.mode === 'preferred' &&
          policyMatchesNow(policy, temporal)
        );

        if (!policies.length) return null;

        return {
          gate,
          distance: L.latLng(
            Number(coordinate[1]),
            Number(coordinate[0])
          ).distanceTo(point),
          priority: Math.max(
            ...policies.map((policy) => Number(policy.priority) || 0)
          )
        };
      })
      .filter(Boolean)
      .filter((entry) => entry.distance <= 80)
      .sort((a, b) =>
        b.priority - a.priority ||
        a.distance - b.distance
      );

    return matches[0] || null;
  };

  const gateAccessAllowed = (gate, direction) => {
    const policies = gatePoliciesForRoute(
      gate,
      accessPolicy,
      userGroup,
      direction
    );

    if (!policies.length) return true;

    const activePolicies = policies.filter((policy) =>
      policyMatchesNow(policy, temporal)
    );

    if (
      activePolicies.some(
        (policy) =>
          policy.mode === 'deny' ||
          policy.mode === 'deny_during'
      )
    ) {
      return false;
    }

    const allowOnly = policies.filter(
      (policy) => policy.mode === 'allow_only_during'
    );

    if (allowOnly.length) {
      return allowOnly.some((policy) =>
        activePolicies.includes(policy)
      );
    }

    const conditionalAllow = policies.filter(
      (policy) =>
        policy.mode === 'allow' &&
        policyHasCondition(policy)
    );

    if (conditionalAllow.length) {
      return conditionalAllow.some((policy) =>
        activePolicies.includes(policy)
      );
    }

    return true;
  };

  const endpointGateFor = (point) => {
    let best = null;

    for (const gate of gates || []) {
      const coordinate =
        gate?.properties?.access_point ||
        gate?.properties?.center;

      if (!Array.isArray(coordinate) || coordinate.length < 2) continue;

      const gatePoint = L.latLng(
        Number(coordinate[1]),
        Number(coordinate[0])
      );

      const distance = gatePoint.distanceTo(point);
      if (!best || distance < best.distance) {
        best = { gate, point: gatePoint, distance };
      }
    }

    return best && best.distance <= USER_GATE_MATCH_RADIUS_M
      ? best
      : null;
  };

  const candidateAnchors = (point, direction) => {
    const candidates = [];
    const preferredGate = preferredGateForPoint(point, direction);

    for (
      let index = 0;
      index < graphSegments.length;
      index += 1
    ) {
      const segment = graphSegments[index];
      const projection = projectToSegment(
        point,
        segment.a,
        segment.b
      );

      if (
        projection.distance <=
        USER_ROUTE_CONNECT_RADIUS_M
      ) {
        const preferredDistance = preferredGate
          ? L.latLng(
              Number(preferredGate.gate?.properties?.access_point?.[1] ??
                preferredGate.gate?.properties?.center?.[1]),
              Number(preferredGate.gate?.properties?.access_point?.[0] ??
                preferredGate.gate?.properties?.center?.[0])
            ).distanceTo(
              L.latLng(
                Number(projection.coordinate[1]),
                Number(projection.coordinate[0])
              )
            )
          : 0;

        const preferenceWeight = preferredGate
          ? 0.25 + (100 - Number(preferredGate.priority || 0)) / 200
          : 0;

        candidates.push({
          segment,
          coordinate: projection.coordinate,
          distance: projection.distance,
          fraction: projection.fraction,
          score: projection.distance + preferredDistance * preferenceWeight
        });
      }
    }

    candidates.sort((a, b) => a.score - b.score || a.distance - b.distance);

    /*
     * Keeping a handful of nearby candidates allows the router to choose
     * a slightly farther connection when it produces a much shorter total
     * journey.
     */
    return candidates.slice(0, 8);
  };

  const startGate = endpointGateFor(startPoint);
  const endGate = endpointGateFor(endPoint);

  if (
    startGate &&
    !gateAccessAllowed(startGate.gate, 'in')
  ) {
    return null;
  }

  if (
    endGate &&
    !gateAccessAllowed(endGate.gate, 'out')
  ) {
    return null;
  }

  const startCandidates = candidateAnchors(startPoint, 'in');
  const endCandidates = candidateAnchors(endPoint, 'out');

  if (!startCandidates.length || !endCandidates.length) {
    return null;
  }

  const addAnchor = (prefix, anchor, index) => {
    const anchorKey =
      '__user_anchor_' +
      prefix +
      '_' +
      String(index);

    addNode(anchorKey, anchor.coordinate);

    const fromA =
      anchor.segment.distance * anchor.fraction;
    const fromB =
      anchor.segment.distance *
      (1 - anchor.fraction);

    addEdge(
      anchorKey,
      anchor.segment.aKey,
      fromA
    );

    addEdge(
      anchorKey,
      anchor.segment.bKey,
      fromB
    );

    return anchorKey;
  };

  const startNodeKey = '__user_start';
  const endNodeKey = '__user_end';

  addNode(startNodeKey, [
    Number(startPoint.lng),
    Number(startPoint.lat)
  ]);

  addNode(endNodeKey, [
    Number(endPoint.lng),
    Number(endPoint.lat)
  ]);

  const startAnchorKeys = startCandidates.map(
    (candidate, index) => {
      const anchorKey = addAnchor(
        'start',
        candidate,
        index
      );

      addEdge(
        startNodeKey,
        anchorKey,
        candidate.distance
      );

      return {
        key: anchorKey,
        candidate
      };
    }
  );

  const endAnchorKeys = endCandidates.map(
    (candidate, index) => {
      const anchorKey = addAnchor(
        'end',
        candidate,
        index
      );

      addEdge(
        anchorKey,
        endNodeKey,
        candidate.distance
      );

      return {
        key: anchorKey,
        candidate
      };
    }
  );

  /*
   * If A and B connect to the same physical split segment, permit the
   * direct along-segment connection as well.
   */
  for (const startAnchor of startAnchorKeys) {
    for (const endAnchor of endAnchorKeys) {
      const first = startAnchor.candidate.segment;
      const second = endAnchor.candidate.segment;

      if (
        first.aKey === second.aKey &&
        first.bKey === second.bKey ||
        first.aKey === second.bKey &&
        first.bKey === second.aKey
      ) {
        const fractionDifference =
          Math.abs(
            startAnchor.candidate.fraction -
            endAnchor.candidate.fraction
          );

        const directDistance =
          fractionDifference * first.distance;

        addEdge(
          startAnchor.key,
          endAnchor.key,
          directDistance
        );
      }
    }
  }

  /*
   * Min-heap Dijkstra. The graph is now fully intersection-aware and
   * contains all reasonable nearby endpoint connections.
   */
  class MinHeap {
    constructor() {
      this.items = [];
    }

    get size() {
      return this.items.length;
    }

    push(item) {
      this.items.push(item);

      let index = this.items.length - 1;

      while (index > 0) {
        const parent = Math.floor((index - 1) / 2);

        if (
          this.items[parent].distance <=
          this.items[index].distance
        ) {
          break;
        }

        [
          this.items[parent],
          this.items[index]
        ] = [
          this.items[index],
          this.items[parent]
        ];

        index = parent;
      }
    }

    pop() {
      if (!this.items.length) return null;

      const first = this.items[0];
      const last = this.items.pop();

      if (this.items.length && last) {
        this.items[0] = last;

        let index = 0;

        while (true) {
          const left = index * 2 + 1;
          const right = left + 1;
          let smallest = index;

          if (
            left < this.items.length &&
            this.items[left].distance <
              this.items[smallest].distance
          ) {
            smallest = left;
          }

          if (
            right < this.items.length &&
            this.items[right].distance <
              this.items[smallest].distance
          ) {
            smallest = right;
          }

          if (smallest === index) break;

          [
            this.items[index],
            this.items[smallest]
          ] = [
            this.items[smallest],
            this.items[index]
          ];

          index = smallest;
        }
      }

      return first;
    }
  }

  const distances = new Map([
    [startNodeKey, 0]
  ]);
  const previous = new Map();
  const visited = new Set();
  const queue = new MinHeap();

  queue.push({
    node: startNodeKey,
    distance: 0
  });

  while (queue.size) {
    const current = queue.pop();

    if (!current || visited.has(current.node)) continue;

    visited.add(current.node);

    if (current.node === endNodeKey) break;

    for (const edge of graph.get(current.node) || []) {
      if (visited.has(edge.node)) continue;

      const nextDistance =
        current.distance + edge.distance;

      if (
        nextDistance <
        (distances.get(edge.node) ?? Infinity)
      ) {
        distances.set(edge.node, nextDistance);
        previous.set(edge.node, current.node);

        queue.push({
          node: edge.node,
          distance: nextDistance
        });
      }
    }
  }

  const totalDistance = distances.get(endNodeKey);

  if (!Number.isFinite(totalDistance)) return null;

  const nodeKeys = [];
  let current = endNodeKey;

  while (current) {
    nodeKeys.unshift(current);

    if (current === startNodeKey) break;

    current = previous.get(current);
  }

  if (nodeKeys[0] !== startNodeKey) return null;

  return {
    coordinates: nodeKeys.map((key) => coordinates.get(key)),
    distance: totalDistance,
    walkingSpeedMps: 1.4
  };
};

const buildingLabelSizing = (map, items) => {
  const clamp = (value) => Math.max(8, Math.min(16, value));

  const measureTextAtOnePx = (text) => {
    const canvas = document.createElement('canvas');
    const context = canvas.getContext('2d');

    if (!context) return Math.max(1, text.length * 0.55);

    context.font = "500 1px 'DM Sans', sans-serif";
    return Math.max(1, context.measureText(text).width);
  };

  const update = () => {
    const zoom = map.getZoom();

    for (const item of items) {
      const northWest = map.project(item.bounds.getNorthWest(), zoom);
      const southEast = map.project(item.bounds.getSouthEast(), zoom);

      const buildingWidth = Math.max(1, Math.abs(southEast.x - northWest.x));
      const buildingHeight = Math.max(1, Math.abs(southEast.y - northWest.y));

      const availableWidth = buildingWidth * 0.82;
      const availableHeight = buildingHeight * 0.48;
      const textWidthAtOnePx = measureTextAtOnePx(item.name);

      item.label.style.setProperty(
        '--building-label-size',
        clamp(Math.min(
          availableWidth / textWidthAtOnePx,
          availableHeight
        )) + 'px'
      );

      item.label.style.setProperty(
        '--building-label-width',
        availableWidth + 'px'
      );
    }
  };

  return update;
};

const start = async () => {
  const mapElement = document.getElementById('map');
  if (!mapElement) return;

  const [
    placesResponse,
    pathResponse,
    gatesResponse,
    perimeterResponse,
    accessRulesResponse
  ] = await Promise.all([
    fetch('/maps/export_places.geojson', { cache: 'no-store' }),
    fetch('/maps/pedestrian_paths_edits.geojson', { cache: 'no-store' }),
    fetch('/maps/gates.geojson', { cache: 'no-store' }),
    fetch('/maps/perimeter.geojson', { cache: 'no-store' }),
    fetch('/maps/campus_access_rules.json', { cache: 'no-store' })
  ]);

  if (
    !placesResponse.ok ||
    !pathResponse.ok ||
    !gatesResponse.ok ||
    !perimeterResponse.ok ||
    !accessRulesResponse.ok
  ) {
    throw new Error('CampusMaaS map or access-policy data could not be loaded.');
  }

  const [places, loadedPathData, loadedGates, perimeter, loadedAccessPolicy] = await Promise.all([
    placesResponse.json(),
    pathResponse.json(),
    gatesResponse.json(),
    perimeterResponse.json(),
    accessRulesResponse.json()
  ]);

  let pathData = loadedPathData;
  let gates = loadedGates;
  let accessPolicy = loadedAccessPolicy;

  const perimeterFeature = perimeter?.features?.[0];
  const perimeterCoordinates = perimeterFeature?.geometry?.coordinates?.[0];
  const centerCoordinates = perimeterFeature?.properties?.center;
  const radius = Number(perimeterFeature?.properties?.radius_m) || 1000;

  if (!Array.isArray(perimeterCoordinates) || !Array.isArray(centerCoordinates)) {
    throw new Error('CampusMaaS perimeter data is invalid.');
  }

  const center = L.latLng(
    Number(centerCoordinates[1]),
    Number(centerCoordinates[0])
  );

  const latRadius = radius / 111320;
  const lonRadius =
    radius / (111320 * Math.cos(center.lat * Math.PI / 180));

  const circleBounds = L.latLngBounds(
    [center.lat - latRadius, center.lng - lonRadius],
    [center.lat + latRadius, center.lng + lonRadius]
  );

  const map = L.map(mapElement, {
    zoomControl: false,
    attributionControl: false,
    minZoom: 18,
    maxZoom: 25,
    scrollWheelZoom: true,
    maxBounds: circleBounds,
    maxBoundsViscosity: 1
  }).setView(center, 18);

  mapElement.setAttribute('aria-label', 'CampusMaaS campus map');

  /*
   * Initial user trip: the logical campus entry point is Gate - 09,
   * presented to the user as KEC Main Gate. The destination is resolved
   * from the real place geometry in export_places.geojson.
   */
  const userTripFrom = document.getElementById('userTripFrom');
  const userTripTo = document.getElementById('userTripTo');
  const userTripTime = document.getElementById('userTripTime');
  const userTripDistance = document.getElementById('userTripDistance');

  const userGenderMale = document.getElementById('userGenderMale');
  const userGenderFemale = document.getElementById('userGenderFemale');
  let selectedUserGroup = 'boys';

  let pointA = null;
  let pointB = null;
  let pointAMarker = null;
  let pointBMarker = null;
  let routeCasing = null;
  let routeLine = null;

  const clearRouteRendering = () => {
    for (const layer of [
      pointAMarker,
      pointBMarker,
      routeCasing,
      routeLine
    ]) {
      if (layer) map.removeLayer(layer);
    }

    pointAMarker = null;
    pointBMarker = null;
    routeCasing = null;
    routeLine = null;
  };

  const formatDistance = (distance) =>
    distance < 1000
      ? Math.round(distance) + ' m'
      : (distance / 1000).toFixed(2) + ' km';

  const renderEndpointMarkers = () => {
    if (pointAMarker) map.removeLayer(pointAMarker);
    if (pointBMarker) map.removeLayer(pointBMarker);

    pointAMarker = null;
    pointBMarker = null;

    if (pointA) {
      pointAMarker = L.circleMarker(pointA, {
        radius: 8,
        color: '#ffffff',
        weight: 2,
        fillColor: '#16c784',
        fillOpacity: 1,
        bubblingMouseEvents: false,
        interactive: false
      }).addTo(map);
    }

    if (pointB) {
      pointBMarker = L.circleMarker(pointB, {
        radius: 8,
        color: '#ffffff',
        weight: 2,
        fillColor: '#ff5b63',
        fillOpacity: 1,
        bubblingMouseEvents: false,
        interactive: false
      }).addTo(map);
    }
  };

  const setUserGender = (group) => {
    const nextGroup =
      group === 'girls'
        ? 'girls'
        : 'boys';

    selectedUserGroup = nextGroup;

    const isMale = nextGroup === 'boys';

    userGenderMale?.classList.toggle('is-active', isMale);
    userGenderFemale?.classList.toggle('is-active', !isMale);

    userGenderMale?.setAttribute('aria-pressed', String(isMale));
    userGenderFemale?.setAttribute('aria-pressed', String(!isMale));

    /*
     * Keep A/B exactly where the user placed them, but recalculate the
     * available route immediately for the selected student group.
     */
    if (pointA && pointB) {
      clearRouteRendering();
      renderEndpointMarkers();
      renderUserRoute();
    }
  };

  userGenderMale?.addEventListener('click', () => {
    setUserGender('boys');
  });

  userGenderFemale?.addEventListener('click', () => {
    setUserGender('girls');
  });

  const loadVendorOrders = async () => {
