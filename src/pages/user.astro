---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import 'leaflet/dist/leaflet.css';
---

<MainLayout title="CampusMaaS">
  <main class="user-map-page">
    <div id="map" class="map map-local" aria-label="CampusMaaS campus map"></div>
    <script src="../scripts/campusmaas/user-map.js"></script>
  </main>
</MainLayout>

<style>
  .user-map-page {
    position: relative;
    width: 100%;
    height: 100dvh;
    min-height: 100vh;
    overflow: hidden;
    background: #edf0f2;
  }

  .user-map-page :global(#map) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
