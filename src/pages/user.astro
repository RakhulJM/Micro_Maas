---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="CampusMaaS · User">
  <main class="user-page">
    <section class="user-shell" aria-label="CampusMaaS user interface">
      <div class="user-intro">
        <span class="eyebrow">CAMPUSMAAS</span>
        <h1>Plan your campus trip.</h1>
        <p>One place to plan, travel, and keep track of your campus journey.</p>
      </div>

      <section class="planner-card" aria-label="Trip planner">
        <div class="field-grid">
          <div class="field">
            <span class="field-label">From</span>
            <div class="field-value">KEC Main Gate</div>
          </div>

          <div class="swap-mark" aria-hidden="true">⇄</div>

          <div class="field">
            <span class="field-label">To</span>
            <div class="field-value">Mechanical Block</div>
          </div>
        </div>

        <div class="time-field">
          <span class="field-label">Departure</span>
          <div class="field-value">Leave now</div>
        </div>

        <div class="summary-grid">
          <div>
            <span class="summary-label">Estimated journey</span>
            <strong>18 min</strong>
          </div>
          <div>
            <span class="summary-label">Distance</span>
            <strong>3.2 km</strong>
          </div>
          <div>
            <span class="summary-label">Status</span>
            <strong>Ready to plan</strong>
          </div>
        </div>

        <button type="button" class="plan-button">Plan trip</button>
      </section>

      <section class="accent-line" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </section>
    </section>
  </main>
</MainLayout>

<style is:global>
  :root {
    font-family: 'DM Sans', system-ui, sans-serif;
    color: #edf6ff;
    background: #06111f;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
    margin: 0;
  }

  body {
    min-height: 100dvh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 50% 0%, rgba(31, 135, 242, .13), transparent 34%),
      linear-gradient(180deg, #071423 0%, #06111f 100%);
  }

  * {
    box-sizing: border-box;
  }

  button,
  input {
    font: inherit;
  }

  .user-page {
    width: 100%;
    min-height: 100dvh;
    padding: clamp(24px, 5vw, 72px);
    display: grid;
    place-items: center;
  }

  .user-shell {
    width: min(920px, 100%);
    display: grid;
    gap: clamp(20px, 3vw, 30px);
  }

  .user-intro {
    max-width: 700px;
  }

  .eyebrow {
    display: inline-block;
    color: #2ec1ff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .18em;
  }

  .user-intro h1 {
    margin: 10px 0 8px;
    color: #f3f8ff;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(34px, 6vw, 64px);
    line-height: .98;
    letter-spacing: -.045em;
    font-weight: 700;
  }

  .user-intro p {
    max-width: 600px;
    margin: 0;
    color: #8ea5bd;
    font-size: clamp(13px, 2vw, 16px);
    line-height: 1.55;
  }

  .planner-card {
    padding: clamp(18px, 3vw, 30px);
    border: 1px solid rgba(83, 168, 255, .2);
    border-radius: 22px;
    background:
      linear-gradient(145deg, rgba(11, 31, 52, .96), rgba(7, 21, 36, .96));
    box-shadow:
      0 24px 80px rgba(0, 0, 0, .3),
      inset 0 1px 0 rgba(255, 255, 255, .03);
  }

  .field-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }

  .field,
  .time-field {
    min-width: 0;
    padding: 15px 16px;
    border: 1px solid rgba(99, 156, 208, .16);
    border-radius: 14px;
    background: rgba(255, 255, 255, .035);
  }

  .field-label,
  .summary-label {
    display: block;
    margin-bottom: 5px;
    color: #7189a2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .field-value {
    overflow: hidden;
    color: #edf6ff;
    font-size: clamp(13px, 2vw, 15px);
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .swap-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(83, 168, 255, .18);
    border-radius: 50%;
    background: rgba(16, 46, 75, .8);
    color: #56c7ff;
    font-size: 17px;
  }

  .time-field {
    margin-top: 12px;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 12px;
  }

  .summary-grid > div {
    padding: 14px 15px;
    border: 1px solid rgba(99, 156, 208, .1);
    border-radius: 13px;
    background: rgba(255, 255, 255, .025);
  }

  .summary-grid strong {
    display: block;
    color: #eaf5ff;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 600;
  }

  .plan-button {
    width: 100%;
    margin-top: 14px;
    min-height: 48px;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, #177cf2, #1fa9ff);
    color: #fff;
    font-size: 14px;
    font-weight: 750;
    box-shadow: 0 12px 28px rgba(23, 124, 242, .26);
  }

  .accent-line {
    display: grid;
    grid-template-columns: 1fr .55fr .28fr;
    gap: 7px;
    height: 4px;
  }

  .accent-line span {
    display: block;
    border-radius: 999px;
    background: #1688ff;
    opacity: .9;
  }

  .accent-line span:nth-child(2) {
    background: #24c7ff;
  }

  .accent-line span:nth-child(3) {
    background: #65e6a0;
  }

  @media (max-width: 700px) {
    .user-page {
      padding: 22px 14px;
    }

    .field-grid {
      grid-template-columns: 1fr;
    }

    .swap-mark {
      width: 34px;
      height: 34px;
      transform: rotate(90deg);
    }

    .summary-grid {
      grid-template-columns: 1fr;
    }

    .planner-card {
      border-radius: 18px;
    }
  }
</style>
