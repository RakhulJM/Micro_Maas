---
import MainLayout from '../../layouts/MainLayout.astro';
import '../../styles/global.css';
import 'leaflet/dist/leaflet.css';
import FoodOrderPopup from '../../components/campusmaas/FoodOrderPopup.astro';
import PrintOrderPopup from '../../components/campusmaas/PrintOrderPopup.astro';
import events from '../../data/events.json';

const campusEvents = [...events].sort((a, b) =>
  (a.startDate + a.startTime).localeCompare(b.startDate + b.startTime)
);
---

<MainLayout title="CampusMaaS">
  <main class="user-map-page">
    <div id="map" class="map map-local" aria-label="CampusMaaS campus map"></div>
    <div class="user-location-controls">
      <button type="button" id="userLocateButton" class="user-locate-button" aria-pressed="false" aria-describedby="userLocationStatus">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="7"></circle>
          <circle cx="12" cy="12" r="2"></circle>
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
        </svg>
        <span>My location</span>
      </button>
      <button type="button" id="userUseLocationAsStart" class="user-locate-button user-location-start-button" disabled>Use my location as start</button>
      <p id="userLocationStatus" class="user-location-status" role="status" aria-live="polite" hidden></p>
    </div>

    <section
      class="user-event-discovery"
      id="userEventDiscovery"
      data-events={JSON.stringify(campusEvents)}
      aria-label="Campus event discovery"
    >
      <div class="user-event-discovery-heading">
        <span class="user-services-kicker">EVENT DISCOVERY</span>
        <span class="user-event-discovery-count" id="userEventCounter">01 / 04</span>
      </div>
      <div class="user-event-discovery-body">
        <a class="user-event-poster-link" id="userEventPosterLink" href={"/events/" + campusEvents[0].slug} aria-label="Open event details">
          <img
            class="user-event-poster"
            id="userEventPoster"
            src={campusEvents[0].poster}
            alt={campusEvents[0].title + " poster"}
            width="120"
            height="160"
            loading="eager"
            decoding="async"
          />
          
        </a>
        <div class="user-event-discovery-copy" aria-live="polite">
          <span class="user-event-discovery-category" id="userEventCategory">{campusEvents[0].category}</span>
          <a class="user-event-discovery-title" id="userEventTitle" href={"/events/" + campusEvents[0].slug}>{campusEvents[0].title}</a>
          <span class="user-event-discovery-date" id="userEventDate">{new Date(campusEvents[0].startDate + "T12:00:00").toLocaleDateString("en-IN", { day: "numeric", month: "short" })} · {campusEvents[0].startTime}</span>
          <span class="user-event-discovery-venue" id="userEventVenue">{campusEvents[0].venue}</span>
          <div class="user-event-discovery-actions">
            <a class="user-event-discovery-cta" id="userEventOpen" href={"/events/" + campusEvents[0].slug}>View event <span aria-hidden="true">↗</span></a>
            <div class="user-event-discovery-controls" aria-label="Event carousel controls">
              <button type="button" id="userEventPrevious" aria-label="Previous event">‹</button>
              <button type="button" id="userEventNext" aria-label="Next event">›</button>
            </div>
          </div>
        </div>
      </div>
      <div class="user-event-discovery-progress" id="userEventProgress" aria-label="Choose event"></div>
    </section>

    <section class="user-trip-card" aria-label="Campus trip">
      <div class="user-trip-field">
        <span>From</span>
        <strong id="userTripFrom">Point A</strong>
      </div>

      <div class="user-trip-divider" aria-hidden="true"></div>

      <div class="user-trip-field">
        <span>To</span>
        <strong id="userTripTo">Point B</strong>
      </div>

      <div class="user-trip-summary">
        <div>
          <span>Journey time</span>
          <strong id="userTripTime">—</strong>
        </div>
        <div>
          <span>Distance</span>
          <strong id="userTripDistance">—</strong>
        </div>
      </div>

      <div class="user-trip-profile">
        <span>Passenger</span>
        <div class="user-gender-toggle" role="group" aria-label="User gender">
          <button type="button" class="user-gender-button is-active" id="userGenderMale" data-user-group="boys" aria-pressed="true" aria-label="Male">
            <span class="user-gender-icon" aria-hidden="true">♂</span>
            <span>Male</span>
          </button>
          <button type="button" class="user-gender-button" id="userGenderFemale" data-user-group="girls" aria-pressed="false" aria-label="Female">
            <span class="user-gender-icon" aria-hidden="true">♀</span>
            <span>Female</span>
          </button>
        </div>
      </div>
    </section>

    <aside class="user-services-stack" id="userServicesCard" aria-label="Campus services">
      <button type="button" class="user-services-label" id="userServicesToggle" aria-expanded="true" aria-controls="userServicesContent">
        <span class="user-services-label-copy">
          <span class="user-services-kicker">CAMPUS SERVICES</span>
          <strong>Place an order</strong>
        </span>
        <span class="user-services-toggle-icon" aria-hidden="true">⌄</span>
      </button>
      <div class="user-services-content" id="userServicesContent">
        <a class="user-events-link" href="/events">
          <span>
            <small>CAMPUS CALENDAR</small>
            <strong>Discover campus events</strong>
          </span>
          <span class="user-events-arrow" aria-hidden="true">→</span>
        </a>

        <div id="userVendorList" class="user-vendor-list">
          <div class="user-services-empty">Loading services…</div>
        </div>

        <div id="userOrderComposer" class="user-order-composer" hidden></div>

        <section class="user-orders-card" aria-label="Your orders">
          <div class="user-orders-head">
            <div>
              <span class="user-services-kicker">YOUR ORDERS</span>
              <strong>Order history</strong>
            </div>
            <span id="userOrderCount">0 orders</span>
          </div>
          <div id="userOrderList" class="user-order-list">
            <div class="user-services-empty">No orders yet.</div>
          </div>
        </section>
      </div>
    </aside>

    <FoodOrderPopup />
    <PrintOrderPopup />

    <script>
      import L from 'leaflet';

const setupUserEventDiscovery = () => {
  const root = document.getElementById('userEventDiscovery');
  if (!root) return;

  let events = [];
  try {
    const parsed = JSON.parse(root.dataset.events || '[]');
    events = Array.isArray(parsed) ? parsed.filter((event) =>
      event && event.title && event.slug && event.poster
    ) : [];
  } catch {
    events = [];
  }

  if (!events.length) {
    root.hidden = true;
    return;
  }

  const poster = document.getElementById('userEventPoster');
  const posterLink = document.getElementById('userEventPosterLink');
  const title = document.getElementById('userEventTitle');
  const category = document.getElementById('userEventCategory');
  const date = document.getElementById('userEventDate');
  const venue = document.getElementById('userEventVenue');
  const openLink = document.getElementById('userEventOpen');
  const counter = document.getElementById('userEventCounter');
  const progress = document.getElementById('userEventProgress');
  const previousButton = document.getElementById('userEventPrevious');
  const nextButton = document.getElementById('userEventNext');

  let activeIndex = 0;
  let timer = null;
  let paused = false;

  const formatEventDate = (event) => {
    const day = new Date(event.startDate + 'T12:00:00').toLocaleDateString('en-IN', {
      day: 'numeric',
      month: 'short'
    });
    const time = String(event.startTime || '').split(':');
    let timeLabel = '';
    if (time.length === 2) {
      const timeDate = new Date();
      timeDate.setHours(Number(time[0]), Number(time[1]), 0, 0);
      timeLabel = timeDate.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });
    }
    return day + (timeLabel ? ' · ' + timeLabel : '');
  };

  const getPrimaryUrl = (event) =>
    event.registrationUrl || event.sourceUrl || ('/events/' + encodeURIComponent(event.slug));

  const setLinkDestination = (link, event, preferredUrl = '') => {
    if (!link) return;
    const destination = preferredUrl || getPrimaryUrl(event);
    link.href = destination;
    if (/^https?:\/\//i.test(destination)) {
      link.target = '_blank';
      link.rel = 'noreferrer noopener';
    } else {
      link.removeAttribute('target');
      link.removeAttribute('rel');
    }
  };

  const renderProgress = () => {
    if (!progress) return;
    progress.replaceChildren();
    events.forEach((event, index) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'user-event-progress-dot' + (index === activeIndex ? ' is-active' : '');
      dot.setAttribute('aria-label', 'Show event ' + (index + 1) + ': ' + event.title);
      dot.setAttribute('aria-pressed', String(index === activeIndex));
      dot.addEventListener('click', () => showEvent(index, true));
      progress.append(dot);
    });
  };

  const showEvent = (nextIndex, restart = false) => {
    if (!events.length) return;
    activeIndex = (nextIndex + events.length) % events.length;
    const event = events[activeIndex];
    const detailsUrl = '/events/' + encodeURIComponent(event.slug);
    const primaryUrl = getPrimaryUrl(event);

    if (poster) {
      poster.src = event.poster;
      poster.alt = event.title + ' poster';
    }
    setLinkDestination(posterLink, event);
    if (posterLink) posterLink.setAttribute('aria-label', 'Open ' + event.title);
    if (category) category.textContent = event.category || 'Campus event';
    if (title) title.textContent = event.title;
    setLinkDestination(title, event, detailsUrl);
    if (date) date.textContent = formatEventDate(event);
    if (venue) venue.textContent = event.venue || 'Campus venue';
    setLinkDestination(openLink, event);
    if (openLink) {
      openLink.innerHTML = '';
      openLink.append(document.createTextNode(event.registrationUrl ? 'Register' : event.sourceUrl ? 'Event website' : 'View event'));
      const arrow = document.createElement('span');
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '↗';
      openLink.append(arrow);
    }
    if (counter) counter.textContent = String(activeIndex + 1).padStart(2, '0') + ' / ' + String(events.length).padStart(2, '0');
    renderProgress();
    if (restart) restartTimer();
  };

  const stopTimer = () => {
    if (timer) window.clearInterval(timer);
    timer = null;
  };
  const startTimer = () => {
    stopTimer();
    if (
      paused ||
      events.length < 2 ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) return;
    timer = window.setInterval(() => showEvent(activeIndex + 1), 7000);
  };
  const restartTimer = () => {
    stopTimer();
    startTimer();
  };

  previousButton?.addEventListener('click', () => showEvent(activeIndex - 1, true));
  nextButton?.addEventListener('click', () => showEvent(activeIndex + 1, true));
  root.addEventListener('mouseenter', () => {
    paused = true;
    stopTimer();
  });
  root.addEventListener('mouseleave', () => {
    paused = false;
    startTimer();
  });
  root.addEventListener('focusin', () => {
    paused = true;
    stopTimer();
  });
  root.addEventListener('focusout', (event) => {
    if (!root.contains(event.relatedTarget)) {
      paused = false;
      startTimer();
    }
  });
  window.addEventListener('pagehide', stopTimer, { once: true });

  showEvent(0);
  startTimer();
};

setupUserEventDiscovery();

// Responsive campus-services drawer. Keep it open on desktop and collapsed by default on phones.
const setupUserServicesDrawer = () => {
  const panel = document.getElementById('userServicesCard');
  const toggle = document.getElementById('userServicesToggle');
  if (!panel || !toggle) return;
  const mobile = window.matchMedia('(max-width: 760px)');
  const setExpanded = (expanded) => {
    panel.classList.toggle('is-collapsed', !expanded);
    toggle.setAttribute('aria-expanded', String(expanded));
  };
  const syncViewport = () => setExpanded(!mobile.matches);
  toggle.addEventListener('click', () => {
    setExpanded(panel.classList.contains('is-collapsed'));
  });
  mobile.addEventListener?.('change', syncViewport);
  syncViewport();
};

setupUserServicesDrawer();

const PATH_COLORS = Object.freeze({
  'Main Road': '#e85d04',
  'Road': '#f2b134',
  'Ground': '#4f9d69',
  'Pedestrian Path': '#2563eb'
});

const PATH_WIDTHS = Object.freeze({
  'Main Road': 5.2,
  'Road': 4.3,
  'Ground': 4.4,
  'Pedestrian Path': 3.8
});

const normalizeCategory = (feature) => {
  const value = String(feature?.properties?.category || '').trim();

  if (PATH_COLORS[value]) return value;

  const highway = String(feature?.properties?.highway || '').toLowerCase();

  if (['motorway', 'trunk', 'primary', 'secondary', 'tertiary'].includes(highway)) {
    return 'Main Road';
  }

  if (['residential', 'unclassified', 'service', 'living_street', 'road', 'track'].includes(highway)) {
    return 'Road';
  }

  if (['path', 'footway', 'pedestrian', 'steps', 'custom'].includes(highway)) {
    return 'Pedestrian Path';
  }

  return 'Pedestrian Path';
};

const escapeHtml = (value) =>
  String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

const normalizeVendorStatus = (service) => {
  const status = String(service?.status || 'online').toLowerCase();
  return status === 'offline' || status === 'busy' ? status : 'online';
};

const vendorStatusLabel = (service) => {
  const status = normalizeVendorStatus(service);
  return status === 'offline' ? 'Offline' : status === 'busy' ? 'Busy' : 'Online';
};

const vendorStatusMessage = (service) => {
  const status = normalizeVendorStatus(service);
  return service?.status_message ||
    (status === 'offline'
      ? 'Currently unavailable'
      : status === 'busy'
        ? 'Currently serving customers'
        : 'Accepting new orders');
};

const vendorStatusMarkup = (service) => {
  const status = normalizeVendorStatus(service);
  return '<span class="user-vendor-status user-vendor-status-' + status + '">' +
    '<i aria-hidden="true"></i><span>' + vendorStatusLabel(service) + '</span></span>';
};

const distanceMeters = (a, b) =>
  L.latLng(Number(a[1]), Number(a[0]))
    .distanceTo(L.latLng(Number(b[1]), Number(b[0])));

const getRoadKind = (feature) =>
  String(feature?.properties?.highway || '').toLowerCase();

const isRoad = (feature) =>
  Boolean(feature?.properties?.highway || feature?.properties?.route);

const roadWidth = {
  motorway: 7,
  trunk: 6.5,
  primary: 6,
  secondary: 5.5,
  tertiary: 5,
  residential: 4.4,
  unclassified: 4,
  service: 3.4,
  footway: 2.7,
  path: 2.4
};

const roadStyle = (feature, casing = false) => {
  const kind = getRoadKind(feature);
  const width = roadWidth[kind] || 3.5;
  const major = ['motorway', 'trunk', 'primary', 'secondary', 'tertiary'].includes(kind);
  const mainExternalRoad =
    feature?.id === 'way/129894647' ||
    feature?.properties?.ref === 'MDR1137';

  return {
    color: casing
      ? '#c7c5c0'
      : (mainExternalRoad ? '#111827' : (major ? '#e9c67b' : '#ffffff')),
    weight: casing ? width + 2.2 : width,
    opacity: 0.96,
    lineCap: 'round',
    lineJoin: 'round'
  };
};

const findBuildingCenter = (places, nameFragment) => {
  const feature = (places?.features || []).find((item) =>
    String(item?.properties?.name || '')
      .toLowerCase()
      .includes(nameFragment.toLowerCase())
  );

  if (!feature?.geometry) return null;

  const layer = L.geoJSON(feature);
  const bounds = layer.getBounds();

  return bounds.isValid() ? bounds.getCenter() : null;
};

const USER_ROUTE_CONNECT_RADIUS_M = 40;
const USER_GATE_MATCH_RADIUS_M = 25;
const ALL_POLICY_DAYS = Object.freeze([
  'mon',
  'tue',
  'wed',
  'thu',
  'fri',
  'sat',
  'sun'
]);

const policyTemporalState = (timezone = 'Asia/Kolkata', date = new Date()) => {
  const parts = new Intl.DateTimeFormat('en-IN', {
    timeZone: timezone,
    weekday: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
  }).formatToParts(date);

  const read = (type) =>
    parts.find((part) => part.type === type)?.value || '';

  return {
    day: read('weekday').slice(0, 3).toLowerCase(),
    time: read('hour') + ':' + read('minute')
  };
};

const policyMatchesNow = (policy, temporal) => {
  if (policy?.enabled === false) return false;

  const days = Array.isArray(policy?.days) && policy.days.length
    ? policy.days
    : ALL_POLICY_DAYS;

  if (!days.includes(temporal.day)) return false;

  const windows =
    Array.isArray(policy?.windows)
      ? policy.windows
      : Array.isArray(policy?.condition?.time_windows)
        ? policy.condition.time_windows
        : [];

  if (!windows.length) return true;

  const current = minutesFromClockValue(temporal.time);

  return windows.some((window) => {
    const start = minutesFromClockValue(window?.start);
    const end = minutesFromClockValue(window?.end);
    return current >= start && current <= end;
  });
};

const minutesFromClockValue = (value) => {
  const [hours, minutes] = String(value || '00:00').split(':').map(Number);
  return hours * 60 + minutes;
};

const policyAppliesToGroup = (policy, group) => {
  const policyGroup = String(policy?.group || 'all');
  const userGroup = String(group || 'students');

  if (policyGroup === 'all' || policyGroup === userGroup) {
    return true;
  }

  /*
   * Boys/girls/hostellers/day scholars are student sub-groups.
   * A generic "students" policy therefore applies to all of them.
   */
  if (
    policyGroup === 'students' &&
    ['boys', 'girls', 'hostellers', 'day_scholars'].includes(userGroup)
  ) {
    return true;
  }

  return false;
};

const policyDirectionAllows = (policy, direction = '') => {
  const policyDirection = String(policy?.direction || 'in_out');

  return policyDirection === 'in_out' ||
    !direction ||
    policyDirection === direction;
};

const gatePoliciesForRoute = (gate, accessPolicy, group = 'students', direction = '') =>
  (accessPolicy?.policies || []).filter(
    (policy) =>
      policy?.target?.type === 'gate' &&
      String(policy?.target?.id) === String(gate?.id) &&
      policyAppliesToGroup(policy, group) &&
      policyDirectionAllows(policy, direction) &&
      policy?.enabled !== false
  );

const policyHasCondition = (policy) => {
  const windows =
    Array.isArray(policy?.windows)
      ? policy.windows
      : Array.isArray(policy?.condition?.time_windows)
        ? policy.condition.time_windows
        : [];

  const days = Array.isArray(policy?.days) ? policy.days : ALL_POLICY_DAYS;

  return windows.length > 0 ||
    days.length !== ALL_POLICY_DAYS.length ||
    days.some((day, index) => day !== ALL_POLICY_DAYS[index]);
};

const pathFeatureAllowed = (feature, accessPolicy, group = 'students') => {
  const temporal = policyTemporalState(accessPolicy?.timezone || 'Asia/Kolkata');
  const policies = (accessPolicy?.policies || []).filter(
    (policy) =>
      policy?.target?.type === 'path' &&
      String(policy?.target?.id) === String(feature?.id) &&
      policyAppliesToGroup(policy, group) &&
      policy?.enabled !== false
  );

  if (!policies.length) return true;

  const activePolicies = policies.filter((policy) =>
    policyMatchesNow(policy, temporal)
  );

  if (
    activePolicies.some(
      (policy) =>
        policy.mode === 'deny' ||
        policy.mode === 'deny_during'
    )
  ) {
    return false;
  }

  const allowOnlyPolicies = policies.filter(
    (policy) => policy.mode === 'allow_only_during'
  );

  if (allowOnlyPolicies.length) {
    return allowOnlyPolicies.some((policy) =>
      activePolicies.includes(policy)
    );
  }

  const conditionalAllowPolicies = policies.filter(
    (policy) =>
      policy.mode === 'allow' &&
      policyHasCondition(policy)
  );

  if (conditionalAllowPolicies.length) {
    return conditionalAllowPolicies.some((policy) =>
      activePolicies.includes(policy)
    );
  }

  return true;
};

const projectPointToPath = (pathData, latlng) => {
  let best = null;

  const referenceLat = latlng.lat * Math.PI / 180;
  const metersPerLat = 111320;
  const metersPerLng = 111320 * Math.cos(referenceLat);

  const project = (coordinate) => ({
    x: (Number(coordinate[0]) - latlng.lng) * metersPerLng,
    y: (Number(coordinate[1]) - latlng.lat) * metersPerLat
  });

  const unproject = (point) =>
    L.latLng(
      latlng.lat + point.y / metersPerLat,
      latlng.lng + point.x / metersPerLng
    );

  for (
    let featureIndex = 0;
    featureIndex < (pathData?.features || []).length;
    featureIndex += 1
  ) {
    const feature = pathData.features[featureIndex];

    if (feature?.geometry?.type !== 'LineString') continue;

    const coordinates = feature.geometry.coordinates;

    for (
      let segmentIndex = 0;
      segmentIndex < coordinates.length - 1;
      segmentIndex += 1
    ) {
      const a = coordinates[segmentIndex];
      const b = coordinates[segmentIndex + 1];
      const pa = project(a);
      const pb = project(b);
      const dx = pb.x - pa.x;
      const dy = pb.y - pa.y;
      const lengthSquared = dx * dx + dy * dy;

      const t = lengthSquared > 0
        ? Math.max(
            0,
            Math.min(
              1,
              -(pa.x * dx + pa.y * dy) / lengthSquared
            )
          )
        : 0;

      const projected = {
        x: pa.x + dx * t,
        y: pa.y + dy * t
      };

      const distance = Math.hypot(projected.x, projected.y);

      if (!best || distance < best.distance) {
        best = {
          point: unproject(projected),
          distance,
          featureIndex,
          segmentIndex,
          a,
          b
        };
      }
    }
  }

  return best;
};

/*
 * Exact user clicks are preserved as route endpoints.
 * The nearest path location is only a temporary internal routing anchor.
 */
/*
 * Build an intersection-aware user routing graph.
 *
 * The stored GeoJSON often contains lines that cross without sharing an
 * explicit coordinate. Those crossings must become graph nodes, otherwise
 * the router can miss the physically short route and take a large detour.
 *
 * User clicks remain exact endpoints. Multiple nearby path candidates are
 * connected to each endpoint; Dijkstra then chooses the best complete route.
 */
const routeSummary = (
  pathData,
  startPoint,
  endPoint,
  accessPolicy,
  userGroup = 'boys',
  gates = [],
  destinationConnectRadius = USER_ROUTE_CONNECT_RADIUS_M
) => {
  const temporal = policyTemporalState(
    accessPolicy?.timezone || 'Asia/Kolkata'
  );

  const gateFeatureIsBlocked = (gate) => {
    const policies = gatePoliciesForRoute(gate, accessPolicy, userGroup, '');
    const universalPolicies = policies.filter(
      (policy) => String(policy?.direction || 'in_out') === 'in_out'
    );

    if (!universalPolicies.length) return false;

    if (
      universalPolicies.some(
        (policy) =>
          (policy.mode === 'deny' || policy.mode === 'deny_during') &&
          policyMatchesNow(policy, temporal)
      )
    ) {
      return true;
    }

    const allowOnly = universalPolicies.filter(
      (policy) => policy.mode === 'allow_only_during'
    );

    return allowOnly.length > 0 &&
      !allowOnly.some((policy) => policyMatchesNow(policy, temporal));
  };

  const blockedGates = (gates || []).filter(gateFeatureIsBlocked);

  const pointToFeatureDistance = (point, feature) => {
    const lines =
      feature?.geometry?.type === 'LineString'
        ? [feature.geometry.coordinates]
        : feature?.geometry?.type === 'MultiLineString'
          ? feature.geometry.coordinates
          : [];

    let best = Infinity;

    for (const line of lines) {
      if (!Array.isArray(line) || line.length < 2) continue;

      for (let index = 0; index < line.length - 1; index += 1) {
        const a = line[index];
        const b = line[index + 1];
        const projected = projectPointToPath(
          {
            features: [{
              geometry: {
                type: 'LineString',
                coordinates: [a, b]
              }
            }]
          },
          point
        );

        if (projected) best = Math.min(best, projected.distance);
      }
    }

    return best;
  };

  const pathPassesBlockedGate = (feature) =>
    blockedGates.some((gate) => {
      const coordinate =
        gate?.properties?.access_point ||
        gate?.properties?.center;

      if (!Array.isArray(coordinate) || coordinate.length < 2) return false;

      const gatePoint = L.latLng(
        Number(coordinate[1]),
        Number(coordinate[0])
      );

      const radius =
        Math.max(
          8,
          (Number(gate?.properties?.width_m) || 2) * 0.5 + 4
        );

      return pointToFeatureDistance(gatePoint, feature) <= radius;
    });

  const routablePathData = {
    ...pathData,
    features: (pathData?.features || [])
      .map((feature, index) => ({
        ...feature,
        id: String(
          feature?.id ||
          feature?.properties?.['@id'] ||
          feature?.properties?.id ||
          'path-' + (index + 1)
        )
      }))
      .filter((feature) =>
        pathFeatureAllowed(feature, accessPolicy, userGroup) &&
        !pathPassesBlockedGate(feature)
      )
  };

  const toRoutingXY = (coordinate) => {
    const scaleX =
      111320 *
      Math.cos(Number(centerForRoutingLat) * Math.PI / 180);
    const scaleY = 111320;

    return {
      x: Number(coordinate[0]) * scaleX,
      y: Number(coordinate[1]) * scaleY
    };
  };

  const centerForRoutingLat = Number(
    (
      (Number(startPoint.lat) + Number(endPoint.lat)) / 2
    )
  );

  const interpolateCoordinate = (a, b, fraction) => [
    Number(a[0]) + (Number(b[0]) - Number(a[0])) * fraction,
    Number(a[1]) + (Number(b[1]) - Number(a[1])) * fraction
  ];

  const distanceBetweenCoordinates = (a, b) =>
    L.latLng(Number(a[1]), Number(a[0]))
      .distanceTo(L.latLng(Number(b[1]), Number(b[0])));

  const cross2D = (a, b) =>
    a.x * b.y - a.y * b.x;

  const pointOnSegmentFraction = (point, a, b, toleranceMeters = 0.05) => {
    const p = toRoutingXY(point);
    const ax = toRoutingXY(a);
    const bx = toRoutingXY(b);

    const dx = bx.x - ax.x;
    const dy = bx.y - ax.y;
    const lengthSquared = dx * dx + dy * dy;

    if (lengthSquared === 0) return null;

    const fraction = Math.max(
      0,
      Math.min(
        1,
        ((p.x - ax.x) * dx + (p.y - ax.y) * dy) / lengthSquared
      )
    );

    const nearest = {
      x: ax.x + dx * fraction,
      y: ax.y + dy * fraction
    };

    if (
      Math.hypot(p.x - nearest.x, p.y - nearest.y) >
      toleranceMeters
    ) {
      return null;
    }

    return fraction;
  };

  const segmentIntersectionFractions = (first, second) => {
    const p = toRoutingXY(first.a);
    const p2 = toRoutingXY(first.b);
    const q = toRoutingXY(second.a);
    const q2 = toRoutingXY(second.b);

    const r = {
      x: p2.x - p.x,
      y: p2.y - p.y
    };

    const qMinusP = {
      x: q.x - p.x,
      y: q.y - p.y
    };

    const s = {
      x: q2.x - q.x,
      y: q2.y - q.y
    };

    const denominator = cross2D(r, s);
    const fractions = [];

    if (Math.abs(denominator) > 1e-9) {
      const t = cross2D(qMinusP, s) / denominator;
      const u = cross2D(qMinusP, r) / denominator;

      if (
        t >= -1e-9 &&
        t <= 1 + 1e-9 &&
        u >= -1e-9 &&
        u <= 1 + 1e-9
      ) {
        fractions.push({
          first: Math.max(0, Math.min(1, t)),
          second: Math.max(0, Math.min(1, u))
        });
      }

      return fractions;
    }

    /*
     * Parallel/collinear segments only connect when one segment endpoint
     * actually lies on the other segment. Merely nearby parallel paths
     * remain separate.
     */
    const firstStartOnSecond = pointOnSegmentFraction(
      first.a,
      second.a,
      second.b
    );

    if (firstStartOnSecond !== null) {
      fractions.push({
        first: 0,
        second: firstStartOnSecond
      });
    }

    const firstEndOnSecond = pointOnSegmentFraction(
      first.b,
      second.a,
      second.b
    );

    if (firstEndOnSecond !== null) {
      fractions.push({
        first: 1,
        second: firstEndOnSecond
      });
    }

    const secondStartOnFirst = pointOnSegmentFraction(
      second.a,
      first.a,
      first.b
    );

    if (secondStartOnFirst !== null) {
      fractions.push({
        first: secondStartOnFirst,
        second: 0
      });
    }

    const secondEndOnFirst = pointOnSegmentFraction(
      second.b,
      first.a,
      first.b
    );

    if (secondEndOnFirst !== null) {
      fractions.push({
        first: secondEndOnFirst,
        second: 1
      });
    }

    return fractions;
  };

  const rawSegments = [];

  for (
    let featureIndex = 0;
    featureIndex < (routablePathData.features || []).length;
    featureIndex += 1
  ) {
    const feature = routablePathData.features[featureIndex];
    const geometry = feature?.geometry;

    if (!geometry) continue;

    const lines =
      geometry.type === 'LineString'
        ? [geometry.coordinates]
        : geometry.type === 'MultiLineString'
          ? geometry.coordinates
          : [];

    for (
      let lineIndex = 0;
      lineIndex < lines.length;
      lineIndex += 1
    ) {
      const line = lines[lineIndex];

      if (!Array.isArray(line) || line.length < 2) continue;

      for (
        let segmentIndex = 0;
        segmentIndex < line.length - 1;
        segmentIndex += 1
      ) {
        const a = line[segmentIndex];
        const b = line[segmentIndex + 1];
        const distance = distanceBetweenCoordinates(a, b);

        if (distance <= 0) continue;

        rawSegments.push({
          featureId: String(feature.id),
          featureIndex,
          lineIndex,
          segmentIndex,
          a,
          b,
          distance
        });
      }
    }
  }

  if (!rawSegments.length) return null;

  const splitFractions = rawSegments.map(() => [0, 1]);

  for (
    let firstIndex = 0;
    firstIndex < rawSegments.length;
    firstIndex += 1
  ) {
    for (
      let secondIndex = firstIndex + 1;
      secondIndex < rawSegments.length;
      secondIndex += 1
    ) {
      const first = rawSegments[firstIndex];
      const second = rawSegments[secondIndex];

      if (
        first.featureId === second.featureId &&
        first.lineIndex === second.lineIndex &&
        Math.abs(first.segmentIndex - second.segmentIndex) <= 1
      ) {
        continue;
      }

      const intersections =
        segmentIntersectionFractions(first, second);

      for (const intersection of intersections) {
        splitFractions[firstIndex].push(intersection.first);
        splitFractions[secondIndex].push(intersection.second);
      }
    }
  }

  const graph = new Map();
  const coordinates = new Map();
  const graphSegments = [];

  const graphKey = (coordinate) =>
    Number(coordinate[0]).toFixed(7) + ',' +
    Number(coordinate[1]).toFixed(7);

  const addNode = (key, coordinate) => {
    if (!graph.has(key)) graph.set(key, []);
    coordinates.set(key, coordinate);
  };

  const addEdge = (fromKey, toKey, distance) => {
    if (fromKey === toKey || distance <= 0) return;

    if (!graph.has(fromKey)) graph.set(fromKey, []);
    if (!graph.has(toKey)) graph.set(toKey, []);

    graph.get(fromKey).push({
      node: toKey,
      distance
    });

    graph.get(toKey).push({
      node: fromKey,
      distance
    });
  };

  for (
    let segmentIndex = 0;
    segmentIndex < rawSegments.length;
    segmentIndex += 1
  ) {
    const segment = rawSegments[segmentIndex];

    const fractions = Array.from(
      new Set(
        splitFractions[segmentIndex]
          .map((value) =>
            Number(
              Math.max(0, Math.min(1, value)).toFixed(10)
            )
          )
      )
    ).sort((a, b) => a - b);

    const splitCoordinates = fractions.map((fraction) =>
      interpolateCoordinate(segment.a, segment.b, fraction)
    );

    for (
      let partIndex = 0;
      partIndex < splitCoordinates.length - 1;
      partIndex += 1
    ) {
      const a = splitCoordinates[partIndex];
      const b = splitCoordinates[partIndex + 1];
      const distance = distanceBetweenCoordinates(a, b);

      if (distance <= 0) continue;

      const aKey = graphKey(a);      const bKey = graphKey(b);

      addNode(aKey, a);
      addNode(bKey, b);
      addEdge(aKey, bKey, distance);

      graphSegments.push({
        a,
        b,
        aKey,
        bKey,
        distance,
        sourceFeatureId: segment.featureId,
        sourceFeatureIndex: segment.featureIndex,
        sourceSegmentIndex: segment.segmentIndex,
        fractionStart: fractions[partIndex],
        fractionEnd: fractions[partIndex + 1]
      });
    }
  }

  const projectToSegment = (point, a, b) => {
    const refLat =
      Number(point.lat) * Math.PI / 180;
    const scaleX = 111320 * Math.cos(refLat);
    const scaleY = 111320;

    const px = Number(point.lng) * scaleX;
    const py = Number(point.lat) * scaleY;
    const ax = Number(a[0]) * scaleX;
    const ay = Number(a[1]) * scaleY;
    const bx = Number(b[0]) * scaleX;
    const by = Number(b[1]) * scaleY;

    const dx = bx - ax;
    const dy = by - ay;
    const lengthSquared = dx * dx + dy * dy;

    if (lengthSquared === 0) {
      return {
        coordinate: [Number(a[0]), Number(a[1])],
        fraction: 0,
        distance: Math.hypot(px - ax, py - ay)
      };
    }

    const fraction = Math.max(
      0,
      Math.min(
        1,
        ((px - ax) * dx + (py - ay) * dy) /
          lengthSquared
      )
    );

    const x = ax + fraction * dx;
    const y = ay + fraction * dy;

    return {
      coordinate: [
        x / scaleX,
        y / scaleY
      ],
      fraction,
      distance: Math.hypot(px - x, py - y)
    };
  };

  const preferredGateForPoint = (point, direction) => {
    const matches = (gates || [])
      .map((gate) => {
        const coordinate =
          gate?.properties?.access_point ||
          gate?.properties?.center;

        if (!Array.isArray(coordinate) || coordinate.length < 2) return null;

        const policies = gatePoliciesForRoute(
          gate,
          accessPolicy,
          userGroup,
          direction
        ).filter((policy) =>
          policy.mode === 'preferred' &&
          policyMatchesNow(policy, temporal)
        );

        if (!policies.length) return null;

        return {
          gate,
          distance: L.latLng(
            Number(coordinate[1]),
            Number(coordinate[0])
          ).distanceTo(point),
          priority: Math.max(
            ...policies.map((policy) => Number(policy.priority) || 0)
          )
        };
      })
      .filter(Boolean)
      .filter((entry) => entry.distance <= 80)
      .sort((a, b) =>
        b.priority - a.priority ||
        a.distance - b.distance
      );

    return matches[0] || null;
  };

  const gateAccessAllowed = (gate, direction) => {
    const policies = gatePoliciesForRoute(
      gate,
      accessPolicy,
      userGroup,
      direction
    );

    if (!policies.length) return true;

    const activePolicies = policies.filter((policy) =>
      policyMatchesNow(policy, temporal)
    );

    if (
      activePolicies.some(
        (policy) =>
          policy.mode === 'deny' ||
          policy.mode === 'deny_during'
      )
    ) {
      return false;
    }

    const allowOnly = policies.filter(
      (policy) => policy.mode === 'allow_only_during'
    );

    if (allowOnly.length) {
      return allowOnly.some((policy) =>
        activePolicies.includes(policy)
      );
    }

    const conditionalAllow = policies.filter(
      (policy) =>
        policy.mode === 'allow' &&
        policyHasCondition(policy)
    );

    if (conditionalAllow.length) {
      return conditionalAllow.some((policy) =>
        activePolicies.includes(policy)
      );
    }

    return true;
  };

  const endpointGateFor = (point) => {
    let best = null;

    for (const gate of gates || []) {
      const coordinate =
        gate?.properties?.access_point ||
        gate?.properties?.center;

      if (!Array.isArray(coordinate) || coordinate.length < 2) continue;

      const gatePoint = L.latLng(
        Number(coordinate[1]),
        Number(coordinate[0])
      );

      const distance = gatePoint.distanceTo(point);
      if (!best || distance < best.distance) {
        best = { gate, point: gatePoint, distance };
      }
    }

    return best && best.distance <= USER_GATE_MATCH_RADIUS_M
      ? best
      : null;
  };

  const candidateAnchors = (point, direction, maxDistance = USER_ROUTE_CONNECT_RADIUS_M) => {
    const candidates = [];
    const preferredGate = preferredGateForPoint(point, direction);

    for (
      let index = 0;
      index < graphSegments.length;
      index += 1
    ) {
      const segment = graphSegments[index];
      const projection = projectToSegment(
        point,
        segment.a,
        segment.b
      );

      if (
        projection.distance <=
        maxDistance
      ) {
        const preferredDistance = preferredGate
          ? L.latLng(
              Number(preferredGate.gate?.properties?.access_point?.[1] ??
                preferredGate.gate?.properties?.center?.[1]),
              Number(preferredGate.gate?.properties?.access_point?.[0] ??
                preferredGate.gate?.properties?.center?.[0])
            ).distanceTo(
              L.latLng(
                Number(projection.coordinate[1]),
                Number(projection.coordinate[0])
              )
            )
          : 0;

        const preferenceWeight = preferredGate
          ? 0.25 + (100 - Number(preferredGate.priority || 0)) / 200
          : 0;

        candidates.push({
          segment,
          coordinate: projection.coordinate,
          distance: projection.distance,
          fraction: projection.fraction,
          score: projection.distance + preferredDistance * preferenceWeight
        });
      }
    }

    candidates.sort((a, b) => a.score - b.score || a.distance - b.distance);

    /*
     * Keeping a handful of nearby candidates allows the router to choose
     * a slightly farther connection when it produces a much shorter total
     * journey.
     */
    return candidates.slice(0, 8);
  };

  const startGate = endpointGateFor(startPoint);
  const endGate = endpointGateFor(endPoint);

  if (
    startGate &&
    !gateAccessAllowed(startGate.gate, 'in')
  ) {
    return null;
  }

  if (
    endGate &&
    !gateAccessAllowed(endGate.gate, 'out')
  ) {
    return null;
  }

  const startCandidates = candidateAnchors(startPoint, 'in', destinationConnectRadius);
  const endCandidates = candidateAnchors(endPoint, 'out', destinationConnectRadius);

  if (!startCandidates.length || !endCandidates.length) {
    return null;
  }

  const addAnchor = (prefix, anchor, index) => {
    const anchorKey =
      '__user_anchor_' +
      prefix +
      '_' +
      String(index);

    addNode(anchorKey, anchor.coordinate);

    const fromA =
      anchor.segment.distance * anchor.fraction;
    const fromB =
      anchor.segment.distance *
      (1 - anchor.fraction);

    addEdge(
      anchorKey,
      anchor.segment.aKey,
      fromA
    );

    addEdge(
      anchorKey,
      anchor.segment.bKey,
      fromB
    );

    return anchorKey;
  };

  const startNodeKey = '__user_start';
  const endNodeKey = '__user_end';

  addNode(startNodeKey, [
    Number(startPoint.lng),
    Number(startPoint.lat)
  ]);

  addNode(endNodeKey, [
    Number(endPoint.lng),
    Number(endPoint.lat)
  ]);

  const startAnchorKeys = startCandidates.map(
    (candidate, index) => {
      const anchorKey = addAnchor(
        'start',
        candidate,
        index
      );

      addEdge(
        startNodeKey,
        anchorKey,
        candidate.distance
      );

      return {
        key: anchorKey,
        candidate
      };
    }
  );

  const endAnchorKeys = endCandidates.map(
    (candidate, index) => {
      const anchorKey = addAnchor(
        'end',
        candidate,
        index
      );

      addEdge(
        anchorKey,
        endNodeKey,
        candidate.distance
      );

      return {
        key: anchorKey,
        candidate
      };
    }
  );

  /*
   * If A and B connect to the same physical split segment, permit the
   * direct along-segment connection as well.
   */
  for (const startAnchor of startAnchorKeys) {
    for (const endAnchor of endAnchorKeys) {
      const first = startAnchor.candidate.segment;
      const second = endAnchor.candidate.segment;

      if (
        first.aKey === second.aKey &&
        first.bKey === second.bKey ||
        first.aKey === second.bKey &&
        first.bKey === second.aKey
      ) {
        const fractionDifference =
          Math.abs(
            startAnchor.candidate.fraction -
            endAnchor.candidate.fraction
          );

        const directDistance =
          fractionDifference * first.distance;

        addEdge(
          startAnchor.key,
          endAnchor.key,
          directDistance
        );
      }
    }
  }

  /*
   * Min-heap Dijkstra. The graph is now fully intersection-aware and
   * contains all reasonable nearby endpoint connections.
   */
  class MinHeap {
    constructor() {
      this.items = [];
    }

    get size() {
      return this.items.length;
    }

    push(item) {
      this.items.push(item);

      let index = this.items.length - 1;

      while (index > 0) {
        const parent = Math.floor((index - 1) / 2);

        if (
          this.items[parent].distance <=
          this.items[index].distance
        ) {
          break;
        }

        [
          this.items[parent],
          this.items[index]
        ] = [
          this.items[index],
          this.items[parent]
        ];

        index = parent;
      }
    }

    pop() {
      if (!this.items.length) return null;

      const first = this.items[0];
      const last = this.items.pop();

      if (this.items.length && last) {
        this.items[0] = last;

        let index = 0;

        while (true) {
          const left = index * 2 + 1;
          const right = left + 1;
          let smallest = index;

          if (
            left < this.items.length &&
            this.items[left].distance <
              this.items[smallest].distance
          ) {
            smallest = left;
          }

          if (
            right < this.items.length &&
            this.items[right].distance <
              this.items[smallest].distance
          ) {
            smallest = right;
          }

          if (smallest === index) break;

          [
            this.items[index],
            this.items[smallest]
          ] = [
            this.items[smallest],
            this.items[index]
          ];

          index = smallest;
        }
      }

      return first;
    }
  }

  const distances = new Map([
    [startNodeKey, 0]
  ]);
  const previous = new Map();
  const visited = new Set();
  const queue = new MinHeap();

  queue.push({
    node: startNodeKey,
    distance: 0
  });

  while (queue.size) {
    const current = queue.pop();

    if (!current || visited.has(current.node)) continue;

    visited.add(current.node);

    if (current.node === endNodeKey) break;

    for (const edge of graph.get(current.node) || []) {
      if (visited.has(edge.node)) continue;

      const nextDistance =
        current.distance + edge.distance;

      if (
        nextDistance <
        (distances.get(edge.node) ?? Infinity)
      ) {
        distances.set(edge.node, nextDistance);
        previous.set(edge.node, current.node);

        queue.push({
          node: edge.node,
          distance: nextDistance
        });
      }
    }
  }

  const totalDistance = distances.get(endNodeKey);

  if (!Number.isFinite(totalDistance)) return null;

  const nodeKeys = [];
  let current = endNodeKey;

  while (current) {
    nodeKeys.unshift(current);

    if (current === startNodeKey) break;

    current = previous.get(current);
  }

  if (nodeKeys[0] !== startNodeKey) return null;

  return {
    coordinates: nodeKeys.map((key) => coordinates.get(key)),
    distance: totalDistance,
    walkingSpeedMps: 1.4
  };
};

const buildingLabelSizing = (map, items) => {
  const clamp = (value) => Math.max(8, Math.min(16, value));

  const measureTextAtOnePx = (text) => {
    const canvas = document.createElement('canvas');
    const context = canvas.getContext('2d');

    if (!context) return Math.max(1, text.length * 0.55);

    context.font = "500 1px 'DM Sans', sans-serif";
    return Math.max(1, context.measureText(text).width);
  };

  const update = () => {
    const zoom = map.getZoom();

    for (const item of items) {
      const northWest = map.project(item.bounds.getNorthWest(), zoom);
      const southEast = map.project(item.bounds.getSouthEast(), zoom);

      const buildingWidth = Math.max(1, Math.abs(southEast.x - northWest.x));
      const buildingHeight = Math.max(1, Math.abs(southEast.y - northWest.y));

      const availableWidth = buildingWidth * 0.82;
      const availableHeight = buildingHeight * 0.48;
      const textWidthAtOnePx = measureTextAtOnePx(item.name);

      item.label.style.setProperty(
        '--building-label-size',
        clamp(Math.min(
          availableWidth / textWidthAtOnePx,
          availableHeight
        )) + 'px'
      );

      item.label.style.setProperty(
        '--building-label-width',
        availableWidth + 'px'
      );
    }
  };

  return update;
};

const start = async () => {
  const mapElement = document.getElementById('map');
  if (!mapElement) return;

  const [
    placesResponse,
    pathResponse,
    gatesResponse,
    perimeterResponse,
    accessRulesResponse
  ] = await Promise.all([
    fetch('/maps/export_places.geojson', { cache: 'no-store' }),
    fetch('/maps/pedestrian_paths_edits.geojson', { cache: 'no-store' }),
    fetch('/maps/gates.geojson', { cache: 'no-store' }),
    fetch('/maps/perimeter.geojson', { cache: 'no-store' }),
    fetch('/maps/campus_access_rules.json', { cache: 'no-store' })
  ]);

  if (
    !placesResponse.ok ||
    !pathResponse.ok ||
    !gatesResponse.ok ||
    !perimeterResponse.ok ||
    !accessRulesResponse.ok
  ) {
    throw new Error('CampusMaaS map or access-policy data could not be loaded.');
  }

  const [places, loadedPathData, loadedGates, perimeter, loadedAccessPolicy] = await Promise.all([
    placesResponse.json(),
    pathResponse.json(),
    gatesResponse.json(),
    perimeterResponse.json(),
    accessRulesResponse.json()
  ]);

  let pathData = loadedPathData;
  let gates = loadedGates;
  let accessPolicy = loadedAccessPolicy;

  const perimeterFeature = perimeter?.features?.[0];
  const perimeterCoordinates = perimeterFeature?.geometry?.coordinates?.[0];
  const centerCoordinates = perimeterFeature?.properties?.center;
  const radius = Number(perimeterFeature?.properties?.radius_m) || 1000;

  if (!Array.isArray(perimeterCoordinates) || !Array.isArray(centerCoordinates)) {
    throw new Error('CampusMaaS perimeter data is invalid.');
  }

  const center = L.latLng(
    Number(centerCoordinates[1]),
    Number(centerCoordinates[0])
  );

  const latRadius = radius / 111320;
  const lonRadius =
    radius / (111320 * Math.cos(center.lat * Math.PI / 180));

  const circleBounds = L.latLngBounds(
    [center.lat - latRadius, center.lng - lonRadius],
    [center.lat + latRadius, center.lng + lonRadius]
  );

  const map = L.map(mapElement, {
    zoomControl: false,
    attributionControl: false,
    minZoom: 18,
    maxZoom: 25,
    scrollWheelZoom: true,
    maxBounds: circleBounds,
    maxBoundsViscosity: 1
  }).setView(center, 18);

  mapElement.setAttribute('aria-label', 'CampusMaaS campus map');

  /*
   * Initial user trip: the logical campus entry point is Gate - 09,
   * presented to the user as KEC Main Gate. The destination is resolved
   * from the real place geometry in export_places.geojson.
   */
  const userTripFrom = document.getElementById('userTripFrom');
  const userTripTo = document.getElementById('userTripTo');
  const userTripTime = document.getElementById('userTripTime');
  const userTripDistance = document.getElementById('userTripDistance');

  const userGenderMale = document.getElementById('userGenderMale');
  const userGenderFemale = document.getElementById('userGenderFemale');
  let selectedUserGroup = 'boys';

  const eventRouteParams = new URLSearchParams(window.location.search);
  const requestedEventVenue = eventRouteParams.get('eventVenue') || '';
  const requestedEventVenueName = eventRouteParams.get('venueName') || 'Event venue';
  const requestedEventLat = Number(eventRouteParams.get('lat'));
  const requestedEventLng = Number(eventRouteParams.get('lng'));
  const requestedEventPoint =
    requestedEventVenue &&
    Number.isFinite(requestedEventLat) &&
    Number.isFinite(requestedEventLng)
      ? L.latLng(requestedEventLat, requestedEventLng)
      : null;
  const hasRequestedEventDestination = Boolean(
    requestedEventPoint && circleBounds.contains(requestedEventPoint)
  );

  let eventDestinationPreset = hasRequestedEventDestination;
  let eventDestinationName = hasRequestedEventDestination ? requestedEventVenueName : '';
  let pointA = null;
  let pointB = hasRequestedEventDestination ? requestedEventPoint : null;
  let pointAMarker = null;
  let pointBMarker = null;
  let routeCasing = null;
  let routeLine = null;

  const clearRouteRendering = () => {
    for (const layer of [
      pointAMarker,
      pointBMarker,
      routeCasing,
      routeLine
    ]) {
      if (layer) map.removeLayer(layer);
    }

    pointAMarker = null;
    pointBMarker = null;
    routeCasing = null;
    routeLine = null;
  };

  const formatDistance = (distance) =>
    distance < 1000
      ? Math.round(distance) + ' m'
      : (distance / 1000).toFixed(2) + ' km';

  const renderEndpointMarkers = () => {
    if (pointAMarker) map.removeLayer(pointAMarker);
    if (pointBMarker) map.removeLayer(pointBMarker);

    pointAMarker = null;
    pointBMarker = null;

    if (pointA) {
      pointAMarker = L.circleMarker(pointA, {
        radius: 8,
        color: '#ffffff',
        weight: 2,
        fillColor: '#16c784',
        fillOpacity: 1,
        bubblingMouseEvents: false,
        interactive: false
      }).addTo(map);
    }

    if (pointB) {
      pointBMarker = L.circleMarker(pointB, {
        radius: 8,
        color: '#ffffff',
        weight: 2,
        fillColor: '#ff5b63',
        fillOpacity: 1,
        bubblingMouseEvents: false,
        interactive: false
      }).addTo(map);
    }
  };

  const setUserGender = (group) => {
    const nextGroup =
      group === 'girls'
        ? 'girls'
        : 'boys';

    selectedUserGroup = nextGroup;

    const isMale = nextGroup === 'boys';

    userGenderMale?.classList.toggle('is-active', isMale);
    userGenderFemale?.classList.toggle('is-active', !isMale);

    userGenderMale?.setAttribute('aria-pressed', String(isMale));
    userGenderFemale?.setAttribute('aria-pressed', String(!isMale));

    /*
     * Keep A/B exactly where the user placed them, but recalculate the
     * available route immediately for the selected student group.
     */
    if (pointA && pointB) {
      clearRouteRendering();
      renderEndpointMarkers();
      renderUserRoute();
    }
  };

  userGenderMale?.addEventListener('click', () => {
    setUserGender('boys');
  });

  userGenderFemale?.addEventListener('click', () => {
    setUserGender('girls');
  });

  const loadVendorOrders = async () => {
    const vendorList = document.getElementById('userVendorList');
    const orderList = document.getElementById('userOrderList');
    const orderCount = document.getElementById('userOrderCount');
    const composer = document.getElementById('userOrderComposer');
    const foodPopup = document.getElementById('foodOrderPopup');
    const foodPopupBackdrop = document.getElementById('foodOrderPopupBackdrop');
    const foodPopupClose = document.getElementById('foodOrderPopupClose');
    const foodPopupVendor = document.getElementById('foodPopupVendor');
    const foodPopupService = document.getElementById('foodPopupService');
    const foodPopupItemSummary = document.getElementById('foodPopupItemSummary');
    const foodPopupPrepSummary = document.getElementById('foodPopupPrepSummary');
    const foodMenuList = document.getElementById('foodMenuList');
    const foodPopupTotal = document.getElementById('foodPopupTotal');
    const foodPopupPlaceOrder = document.getElementById('foodPopupPlaceOrder');
    const foodPopupError = document.getElementById('foodPopupError');

    const printPopup = document.getElementById('printOrderPopup');
    const printPopupBackdrop = document.getElementById('printOrderPopupBackdrop');
    const printPopupClose = document.getElementById('printOrderPopupClose');
    const printPopupVendor = document.getElementById('printPopupVendor');
    const printPopupService = document.getElementById('printPopupService');
    const printPopupStatus = document.getElementById('printPopupStatus');
    const printPopupPrepSummary = document.getElementById('printPopupPrepSummary');
    const printDropZone = document.getElementById('printDropZone');
    const printSelectFiles = document.getElementById('printSelectFiles');
    const printFileInput = document.getElementById('printFileInput');
    const printFileSummary = document.getElementById('printFileSummary');
    const printFileList = document.getElementById('printFileList');
    const printClearFiles = document.getElementById('printClearFiles');
    const printSelectAll = document.getElementById('printSelectAll');
    const printPopupPlaceOrder = document.getElementById('printPopupPlaceOrder');
    const printPopupError = document.getElementById('printPopupError');
    const printPreviewModal = document.getElementById('printPreviewModal');
    const printPreviewBackdrop = document.getElementById('printPreviewBackdrop');
    const printPreviewClose = document.getElementById('printPreviewClose');
    const printPreviewFrame = document.getElementById('printPreviewFrame');
    const printPreviewTitle = document.getElementById('printPreviewTitle');
    let printPreviewUrl = '';

    let catalogue = { vendors: [] };
    let orders = { orders: [] };
    let foodMenu = { menu: [] };
    let foodVendor = null;
    let foodService = null;
    let foodCart = new Map();
    let foodPopupBusy = false;
    let printVendor = null;
    let printService = null;
    let printFiles = [];
    let printPopupBusy = false;

    const key = 'campusmaas-user-id';
    let userId = localStorage.getItem(key);
    if (!userId) {
      userId = 'user-' + Math.random().toString(36).slice(2, 10);
      localStorage.setItem(key, userId);
    }

    const esc = (value) =>
      String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    const money = (value) => '₹' + (Number(value) || 0).toFixed(2);

    const renderOrders = () => {
      const mine = orders.orders
        .filter((order) => order.user_id === userId)
        .sort((a, b) => String(b.created_at).localeCompare(String(a.created_at)));

      orderCount.textContent = mine.length + (mine.length === 1 ? ' order' : ' orders');
      orderList.innerHTML = mine.length
        ? ''
        : '<div class="user-services-empty">No orders yet.</div>';

      mine.forEach((order) => {
        const el = document.createElement('article');
        el.className = 'user-order-item';

        const details = document.createElement('div');
        const quantityText = Array.isArray(order.files)
          ? ('Files ' + order.files.length + ' · Copies ' + (Number(order.quantity) || 0))
          : ('Qty ' + (Number(order.quantity) || 1));

        details.innerHTML =
          '<strong>#' + esc(order.id) +
          '</strong><span>' + esc(order.vendor_name) + ' · ' + esc(order.option_name) +
          '</span><small>' + quantityText + ' · ' + esc(order.status) + '</small>';

        const side = document.createElement('div');
        side.className = 'user-order-side';
        side.innerHTML = '<b>' + money(order.total_price) + '</b>';

        if (String(order.status || '').toLowerCase() === 'ready') {
          const confirm = document.createElement('button');
          confirm.type = 'button';
          confirm.className = 'user-order-confirm';
          confirm.textContent = 'CONFIRM COLLECTED';
          confirm.addEventListener('click', async () => {
            confirm.disabled = true;
            confirm.textContent = 'CONFIRMING…';

            try {
              const response = await fetch('/__campusmaas/update-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  id: order.id,
                  status: 'completed',
                  actor: 'user',
                  user_id: userId
                })
              });

              if (!response.ok) {
                const data = await response.json().catch(() => null);
                throw new Error(data?.error || 'Order could not be updated.');
              }

              orders = await (
                await fetch('/__campusmaas/user-orders?user_id=' + encodeURIComponent(userId), { cache: 'no-store' })
              ).json();

              renderOrders();
            } catch {
              confirm.disabled = false;
              confirm.textContent = 'CONFIRM COLLECTED';
            }
          });
          el.appendChild(confirm);
        }

        el.append(details, side);        orderList.appendChild(el);
      });
    };

    const closeFoodPopup = () => {
      if (!foodPopup) return;
      foodPopup.hidden = true;
      foodPopup.setAttribute('aria-hidden', 'true');
      foodPopupBusy = false;
    };

    const updateFoodTotals = () => {
      const entries = Array.from(foodCart.entries())
        .filter(([, quantity]) => quantity > 0);

      const itemCount = entries.reduce((sum, [, quantity]) => sum + quantity, 0);
      const total = entries.reduce((sum, [itemId, quantity]) => {
        const item = foodMenu.menu.find((menuItem) => menuItem.id === itemId);
        return sum + (Number(item?.price) || 0) * quantity;
      }, 0);

      foodPopupItemSummary.textContent =
        itemCount + (itemCount === 1 ? ' item' : ' items');

      foodPopupTotal.textContent = money(total);
      foodPopupPlaceOrder.disabled = itemCount === 0 || foodPopupBusy;
      foodPopupPrepSummary.textContent =
        foodService
          ? ((Number(foodService.service_minutes) || 0) + ' min service')
          : 'Select items to continue';
    };

    const renderFoodMenu = () => {
      foodMenuList.innerHTML = '';

      const items = Array.isArray(foodMenu.menu) ? foodMenu.menu : [];

      if (!items.length) {
        foodMenuList.appendChild(
          Object.assign(document.createElement('div'), {
            className: 'food-menu-empty',
            textContent: 'No menu items are configured for this service.'
          })
        );
        updateFoodTotals();
        return;
      }

      items.forEach((item) => {
        const available = item.available !== false;
        const row = document.createElement('article');
        row.className = 'food-menu-item' + (available ? '' : ' is-unavailable');

        const main = document.createElement('div');
        main.className = 'food-menu-item-main';

        const name = document.createElement('div');
        name.className = 'food-menu-item-name';
        name.textContent = item.name;

        const description = document.createElement('div');
        description.className = 'food-menu-item-description';
        description.textContent = item.description || '';

        const price = document.createElement('div');
        price.className = 'food-menu-item-price';
        price.textContent = money(item.price);

        main.append(name, description, price);

        const actions = document.createElement('div');
        actions.className = 'food-menu-item-actions';

        if (available) {
          const minus = document.createElement('button');
          minus.type = 'button';
          minus.className = 'food-menu-qty-button';
          minus.textContent = '−';
          minus.setAttribute('aria-label', 'Remove one ' + item.name);

          const quantity = document.createElement('span');
          quantity.className = 'food-menu-qty';
          quantity.id = 'food-menu-qty-' + item.id;
          quantity.textContent = '0';

          const plus = document.createElement('button');
          plus.type = 'button';
          plus.className = 'food-menu-qty-button';
          plus.textContent = '+';
          plus.setAttribute('aria-label', 'Add one ' + item.name);

          minus.addEventListener('click', () => {
            const next = Math.max(0, (foodCart.get(item.id) || 0) - 1);
            if (next) foodCart.set(item.id, next);
            else foodCart.delete(item.id);
            quantity.textContent = String(next);
            updateFoodTotals();
          });

          plus.addEventListener('click', () => {
            const next = Math.min(99, (foodCart.get(item.id) || 0) + 1);
            foodCart.set(item.id, next);
            quantity.textContent = String(next);
            updateFoodTotals();
          });

          actions.append(minus, quantity, plus);
        } else {
          const unavailable = document.createElement('span');
          unavailable.className = 'food-menu-unavailable';
          unavailable.textContent = 'Unavailable';
          actions.appendChild(unavailable);
        }

        row.append(main, actions);
        foodMenuList.appendChild(row);
      });

      updateFoodTotals();
    };

    const openFoodPopup = async (vendor, service) => {
      foodVendor = vendor;
      foodService = service;
      foodCart = new Map();

      foodPopupVendor.textContent = vendor.name;
      foodPopupService.textContent = service.name;
      const popupStatus = document.getElementById('foodPopupStatus');
      if (popupStatus) {
        popupStatus.className = 'food-popup-status food-popup-status-' + normalizeVendorStatus(service);
        popupStatus.innerHTML = '<i aria-hidden="true"></i><span>' + vendorStatusLabel(service) + '</span><small>' + esc(vendorStatusMessage(service)) + '</small>';
      }
      foodMenuList.innerHTML = '<div class="food-menu-empty">Loading menu…</div>';
      foodPopupError.hidden = true;
      foodPopup.hidden = false;
      foodPopup.setAttribute('aria-hidden', 'false');
      updateFoodTotals();

      try {
        const response = await fetch(
          '/maps/food_menus/' + encodeURIComponent(service.id) + '.json',
          { cache: 'no-store' }
        );

        if (!response.ok) throw new Error('Menu could not be loaded.');

        foodMenu = await response.json();

        if (
          foodMenu.vendor_id !== vendor.id ||
          foodMenu.service_id !== service.id ||
          !Array.isArray(foodMenu.menu)
        ) {
          throw new Error('Invalid menu configuration.');
        }

        renderFoodMenu();
      } catch (error) {
        foodMenu = { menu: [] };
        foodMenuList.innerHTML = '';
        foodMenuList.appendChild(
          Object.assign(document.createElement('div'), {
            className: 'food-menu-empty',
            textContent: 'Menu is unavailable for this service.'
          })
        );
        foodPopupError.textContent = error.message || 'Menu could not be loaded.';
        foodPopupError.hidden = false;
        updateFoodTotals();
      }
    };

    const placeFoodOrder = async () => {
      if (foodPopupBusy || !foodVendor || !foodService) return;

      const items = Array.from(foodCart.entries())
        .filter(([, quantity]) => quantity > 0)
        .map(([menuItemId, quantity]) => ({
          menu_item_id: menuItemId,
          quantity
        }));

      if (!items.length) return;

      foodPopupBusy = true;
      foodPopupError.hidden = true;
      foodPopupPlaceOrder.disabled = true;
      foodPopupPlaceOrder.textContent = 'PLACING…';

      try {
        const response = await fetch('/__campusmaas/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_id: userId,
            vendor_id: foodVendor.id,
            vendor_name: foodVendor.name,
            option_id: foodService.id,
            option_name: foodService.name,
            items
          })
        });

        if (!response.ok) throw new Error('Food order could not be placed.');

        orders = await (
          await fetch('/__campusmaas/user-orders?user_id=' + encodeURIComponent(userId), { cache: 'no-store' })
        ).json();

        closeFoodPopup();
        renderOrders();
      } catch (error) {
        foodPopupBusy = false;
        foodPopupError.textContent = error.message || 'Food order could not be placed.';
        foodPopupError.hidden = false;
        foodPopupPlaceOrder.disabled = false;
        foodPopupPlaceOrder.textContent = 'PLACE ORDER';
      }
    };

    const closePrintPopup = () => {
      if (!printPopup) return;
      closePrintPreview();
      printPopup.hidden = true;
      printPopup.setAttribute('aria-hidden', 'true');
      printPopupBusy = false;
      printFiles = [];
      if (printSelectAll) {
        printSelectAll.checked = false;
        printSelectAll.indeterminate = false;
      }
    };

    const formatFileSize = (bytes) => {
      const size = Number(bytes) || 0;
      if (size < 1024) return size + ' B';
      if (size < 1024 * 1024) return (size / 1024).toFixed(1) + ' KB';
      if (size < 1024 * 1024 * 1024) return (size / (1024 * 1024)).toFixed(1) + ' MB';
      return (size / (1024 * 1024 * 1024)).toFixed(1) + ' GB';
    };

    const printSummary = () => {
      const selectedFiles = printFiles.filter((entry) => entry.selected);
      const copies = selectedFiles.reduce((sum, entry) => sum + entry.copies, 0);
      printFileSummary.textContent =
        selectedFiles.length + (selectedFiles.length === 1 ? ' file · ' : ' files · ') +
        copies + (copies === 1 ? ' copy' : ' copies');

      printClearFiles.hidden = printFiles.length === 0;

      if (printSelectAll) {
        printSelectAll.checked =
          printFiles.length > 0 && selectedFiles.length === printFiles.length;
        printSelectAll.indeterminate =
          selectedFiles.length > 0 && selectedFiles.length < printFiles.length;
      }

      const offline = normalizeVendorStatus(printService) === 'offline';
      const allSelectedReady =
        selectedFiles.length > 0 &&
        selectedFiles.every((entry) => entry.conversionStatus === 'ready');

      printPopupPlaceOrder.disabled =
        offline || !allSelectedReady || printPopupBusy;
    };

    const renderPrintFiles = () => {
      printFileList.innerHTML = '';

      if (!printFiles.length) {
        printFileList.appendChild(
          Object.assign(document.createElement('div'), {
            className: 'print-files-empty',
            textContent: 'Select or drop files to add them to your order.'
          })
        );
        printSummary();
        return;
      }

      printFiles.forEach((entry, index) => {
        const row = document.createElement('article');
        row.className = 'print-file-row' + (entry.selected ? '' : ' is-unselected');

        const main = document.createElement('div');
        main.className = 'print-file-main';

        const nameLine = document.createElement('div');
        nameLine.className = 'print-file-name-wrap';

        const selectLabel = document.createElement('label');
        selectLabel.className = 'print-file-select';

        const select = document.createElement('input');
        select.type = 'checkbox';
        select.checked = entry.selected;
        select.setAttribute('aria-label', 'Select ' + entry.file.name);
        select.addEventListener('change', () => {
          entry.selected = select.checked;
          renderPrintFiles();
        });

        selectLabel.appendChild(select);

        const name = document.createElement('div');
        name.className = 'print-file-name';
        name.textContent = entry.file.name;
        nameLine.append(selectLabel, name);

        const meta = document.createElement('div');
        meta.className = 'print-file-meta';
        meta.textContent =
          (entry.file.type || 'Unknown file type') + ' · ' +
          formatFileSize(entry.file.size);

        const conversion = document.createElement('div');
        conversion.className = 'print-file-conversion print-file-conversion-' + (entry.conversionStatus || 'converting');

        if (entry.conversionStatus === 'ready') {
          conversion.innerHTML = '<span class="print-conversion-dot"></span><span>PDF READY</span>';
        } else if (entry.conversionStatus === 'error') {
          conversion.innerHTML = '<span class="print-conversion-dot"></span><span>CONVERSION FAILED</span>';
          conversion.title = entry.conversionError || 'PDF conversion failed.';
        } else {
          conversion.innerHTML = '<span class="print-conversion-spinner"></span><span>CONVERTING TO PDF…</span>';
        }

        main.append(nameLine, meta, conversion);

        const settings = document.createElement('div');
        settings.className = 'print-file-settings';

        const sidesGroup = document.createElement('div');
        sidesGroup.className = 'print-file-option-group';

        const sidesLabel = document.createElement('span');
        sidesLabel.className = 'print-file-option-label';
        sidesLabel.textContent = 'Sides';

        const sideSingle = document.createElement('label');
        sideSingle.className = 'print-file-option';
        const sideSingleInput = document.createElement('input');
        sideSingleInput.type = 'radio';
        sideSingleInput.name = 'print-sides-' + index;
        sideSingleInput.value = 'single';
        sideSingleInput.checked = entry.sides === 'single';
        sideSingleInput.disabled = !entry.selected;
        sideSingleInput.addEventListener('change', () => {
          if (sideSingleInput.checked) entry.sides = 'single';
        });
        sideSingle.append(sideSingleInput, document.createTextNode('One side'));

        const sideDouble = document.createElement('label');
        sideDouble.className = 'print-file-option';
        const sideDoubleInput = document.createElement('input');
        sideDoubleInput.type = 'radio';
        sideDoubleInput.name = 'print-sides-' + index;
        sideDoubleInput.value = 'double';
        sideDoubleInput.checked = entry.sides === 'double';
        sideDoubleInput.disabled = !entry.selected;
        sideDoubleInput.addEventListener('change', () => {
          if (sideDoubleInput.checked) entry.sides = 'double';
        });
        sideDouble.append(sideDoubleInput, document.createTextNode('Both sides'));

        sidesGroup.append(sidesLabel, sideSingle, sideDouble);

        const colorGroup = document.createElement('div');
        colorGroup.className = 'print-file-option-group';

        const colorLabel = document.createElement('span');
        colorLabel.className = 'print-file-option-label';
        colorLabel.textContent = 'Colour';

        const bw = document.createElement('label');
        bw.className = 'print-file-option';
        const bwInput = document.createElement('input');
        bwInput.type = 'radio';
        bwInput.name = 'print-colour-' + index;
        bwInput.value = 'bw';
        bwInput.checked = entry.color === 'bw';
        bwInput.disabled = !entry.selected;
        bwInput.addEventListener('change', () => {
          if (bwInput.checked) entry.color = 'bw';
        });
        bw.append(bwInput, document.createTextNode('Black & White'));

        const color = document.createElement('label');
        color.className = 'print-file-option';
        const colorInput = document.createElement('input');
        colorInput.type = 'radio';
        colorInput.name = 'print-colour-' + index;
        colorInput.value = 'color';
        colorInput.checked = entry.color === 'color';
        colorInput.disabled = !entry.selected;
        colorInput.addEventListener('change', () => {
          if (colorInput.checked) entry.color = 'color';
        });
        color.append(colorInput, document.createTextNode('Colour'));

        colorGroup.append(colorLabel, bw, color);
        settings.append(sidesGroup, colorGroup);

        const controls = document.createElement('div');
        controls.className = 'print-copy-controls';

        const minus = document.createElement('button');
        minus.type = 'button';
        minus.className = 'print-copy-button';
        minus.textContent = '−';
        minus.disabled = !entry.selected;
        minus.setAttribute('aria-label', 'Decrease copies for ' + entry.file.name);

        const count = document.createElement('span');
        count.className = 'print-copy-count';
        count.textContent = String(entry.copies);

        const plus = document.createElement('button');
        plus.type = 'button';
        plus.className = 'print-copy-button';
        plus.textContent = '+';
        plus.disabled = !entry.selected;
        plus.setAttribute('aria-label', 'Increase copies for ' + entry.file.name);

        minus.addEventListener('click', () => {
          entry.copies = Math.max(1, entry.copies - 1);
          renderPrintFiles();
        });

        plus.addEventListener('click', () => {
          entry.copies = Math.min(99, entry.copies + 1);
          renderPrintFiles();
        });

        const preview = document.createElement('button');
        preview.type = 'button';
        preview.className = 'print-preview-button';
        preview.textContent = entry.conversionStatus === 'converting'
          ? 'PROCESSING…'
          : entry.conversionStatus === 'error'
            ? 'FAILED'
            : 'Preview';
        preview.setAttribute(
          'aria-label',
          entry.conversionStatus === 'converting'
            ? 'Processing PDF for ' + entry.file.name
            : entry.conversionStatus === 'error'
              ? 'PDF conversion failed for ' + entry.file.name
              : 'Preview ' + entry.file.name
        );
        preview.title = entry.conversionStatus === 'converting'
          ? 'PDF conversion in progress'
          : entry.conversionStatus === 'error'
            ? (entry.conversionError || 'PDF conversion failed')
            : 'Preview';
        preview.disabled = !entry.selected ||
          entry.conversionStatus !== 'ready';
        preview.classList.toggle(
          'is-processing',
          entry.conversionStatus === 'converting'
        );
        preview.classList.toggle(
          'is-error',
          entry.conversionStatus === 'error'
        );
        preview.addEventListener('click', async () => {
          if (!entry.selected || entry.conversionStatus !== 'ready') return;

          preview.disabled = true;
          preview.classList.add('is-processing');
          preview.textContent = 'PROCESSING…';
          preview.title = 'Loading print-ready PDF…';

          try {
            await openPrintPreview(entry);
          } finally {
            preview.classList.remove('is-processing');
            preview.disabled = !entry.selected ||
              entry.conversionStatus !== 'ready';
            preview.textContent = entry.conversionStatus === 'ready'
              ? 'Preview'
              : entry.conversionStatus === 'error'
                ? 'FAILED'
                : 'PROCESSING…';
            preview.title = entry.conversionStatus === 'error'
              ? (entry.conversionError || 'PDF conversion failed')
              : 'Preview';
          }
        });

        controls.append(minus, count, plus, preview);

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'print-remove-file';
        remove.textContent = '×';
        remove.setAttribute('aria-label', 'Remove ' + entry.file.name);
        remove.addEventListener('click', () => {
          printFiles.splice(index, 1);
          renderPrintFiles();
        });

        row.append(main, settings, controls, remove);
        printFileList.appendChild(row);
      });

      printSummary();
    };

    const addPrintFiles = (fileList) => {
      if (normalizeVendorStatus(printService) === 'offline') return;

      const selected = Array.from(fileList || []);
      if (!selected.length) return;

      selected.forEach((file) => {
        const entry = {
          file,
          copies: 1,
          selected: true,
          sides: 'single',
          color: 'bw',
          conversionStatus: 'converting',
          conversionError: ''
        };
        printFiles.push(entry);
        void convertPrintFile(entry)
          .then(() => {
            entry.conversionStatus = 'ready';
            entry.conversionError = '';
            renderPrintFiles();
          })
          .catch((error) => {
            entry.conversionStatus = 'error';
            entry.conversionError = error?.message || 'PDF conversion failed.';
            renderPrintFiles();
          });
      });

      printPopupError.hidden = true;
      renderPrintFiles();
    };

    const readFileAsBase64 = (file) =>
      new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const result = String(reader.result || '');
          resolve(result.includes(',') ? result.slice(result.indexOf(',') + 1) : result);
        };
        reader.onerror = () => reject(new Error('Could not read ' + file.name + '.'));
        reader.readAsDataURL(file);
      });

    const convertPrintFile = async (entry) => {
      if (entry.printPdfBase64) {
        entry.conversionStatus = 'ready';
        return entry.printPdfBase64;
      }
      if (entry.conversionPromise) return entry.conversionPromise;

      entry.conversionStatus = 'converting';
      entry.conversionError = '';

      entry.conversionPromise = (async () => {
        const dataBase64 = await readFileAsBase64(entry.file);
      const response = await fetch('/__campusmaas/convert-print-file', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: entry.file.name,
          type: entry.file.type || 'application/octet-stream',
          size: Number(entry.file.size) || 0,
          data_base64: dataBase64
        })
      });

      if (!response.ok) {
        const data = await response.json().catch(() => null);
        throw new Error(data?.error || 'File could not be converted to PDF.');
      }

      const payload = await response.json();
      if (!payload?.pdf_base64) throw new Error('PDF conversion returned no file.');

        entry.printPdfBase64 = String(payload.pdf_base64);
        entry.printPdfSize = Number(payload.size) || 0;
        entry.conversionStatus = 'ready';
        return entry.printPdfBase64;
      })();

      try {
        return await entry.conversionPromise;
      } catch (error) {
        entry.conversionStatus = 'error';
        entry.conversionError = error?.message || 'PDF conversion failed.';
        throw error;
      } finally {
        entry.conversionPromise = null;
      }
    };

    const closePrintPreview = () => {
      if (!printPreviewModal) return;
      printPreviewModal.hidden = true;
      printPreviewModal.setAttribute('aria-hidden', 'true');
      if (printPreviewFrame) printPreviewFrame.removeAttribute('src');
      if (printPreviewUrl) {
        URL.revokeObjectURL(printPreviewUrl);
        printPreviewUrl = '';
      }
    };

    const openPrintPreview = async (entry) => {
      if (!printPreviewModal || !printPreviewFrame || !entry?.selected) return;

      printPopupError.hidden = true;
      printPreviewTitle.textContent = entry.file.name;
      printPreviewModal.hidden = false;
      printPreviewModal.setAttribute('aria-hidden', 'false');
      printPreviewFrame.removeAttribute('src');

      try {
        const pdfBase64 = await convertPrintFile(entry);
        const binary = atob(pdfBase64);
        const bytes = new Uint8Array(binary.length);
        for (let index = 0; index < binary.length; index += 1) bytes[index] = binary.charCodeAt(index);
        const blob = new Blob([bytes], { type: 'application/pdf' });

        if (printPreviewUrl) URL.revokeObjectURL(printPreviewUrl);
        printPreviewUrl = URL.createObjectURL(blob);
        printPreviewFrame.src = printPreviewUrl;
      } catch (error) {
        closePrintPreview();
        printPopupError.textContent = error.message || 'Preview could not be generated.';
        printPopupError.hidden = false;
      }
    };

    printPreviewClose?.addEventListener('click', closePrintPreview);
    printPreviewBackdrop?.addEventListener('click', closePrintPreview);

    const openPrintPopup = (vendor, option) => {
      printVendor = vendor;
      printService = option;
      printFiles = [];

      printPopupVendor.textContent = vendor.name;
      printPopupService.textContent = option.name;
      printPopupPrepSummary.textContent =
        (Number(option.service_minutes) || 0) + ' min service';

      const status = normalizeVendorStatus(option);
      printPopupStatus.className = 'print-popup-status print-popup-status-' + status;
      printPopupStatus.innerHTML =
        '<i aria-hidden="true"></i><span>' + vendorStatusLabel(option) +
        '</span><small>' + esc(vendorStatusMessage(option)) + '</small>';

      const offline = status === 'offline';
      printSelectFiles.disabled = offline;
      printDropZone.classList.toggle('is-disabled', offline);
      printPopupError.hidden = true;
      printPopup.hidden = false;
      printPopup.setAttribute('aria-hidden', 'false');

      if (printFileInput) printFileInput.value = '';
      renderPrintFiles();
    };

    const placePrintOrder = async () => {
      if (
        printPopupBusy ||
        !printVendor ||
        !printService ||
        !printFiles.some((entry) => entry.selected) ||
        printFiles.some((entry) => entry.selected && entry.conversionStatus !== 'ready') ||
        normalizeVendorStatus(printService) === 'offline'
      ) {
        return;
      }

      printPopupBusy = true;
      printPopupError.hidden = true;
      printPopupPlaceOrder.disabled = true;
      printPopupPlaceOrder.textContent = 'ORDERING…';

      try {
        const files = [];
        for (const entry of printFiles.filter((item) => item.selected)) {
          if (entry.conversionStatus !== 'ready' || !entry.printPdfBase64) {
            throw new Error('Please wait for all files to finish PDF conversion.');
          }
          const pdfBase64 = entry.printPdfBase64;
          files.push({
            name: entry.file.name,
            type: 'application/pdf',
            original_type: entry.file.type || 'application/octet-stream',
            original_size: Number(entry.file.size) || 0,
            size: Number(entry.printPdfSize) || 0,
            copies: entry.copies,
            sides: entry.sides,
            color: entry.color,
            data_base64: pdfBase64
          });
        }

        const totalCopies = files.reduce((sum, file) => sum + file.copies, 0);

        const response = await fetch('/__campusmaas/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            user_id: userId,
            vendor_id: printVendor.id,
            vendor_name: printVendor.name,
            option_id: printService.id,
            option_name: printService.name,
            quantity: totalCopies,
            unit_price: Number(printService.price) || 0,
            total_price: (Number(printService.price) || 0) * totalCopies,
            service_minutes: Number(printService.service_minutes) || 0,
            files
          })
        });

        if (!response.ok) {
          const data = await response.json().catch(() => null);
          throw new Error(data?.error || 'Print order could not be placed.');
        }

        orders = await (
          await fetch('/__campusmaas/user-orders?user_id=' + encodeURIComponent(userId), { cache: 'no-store' })
        ).json();

        closePrintPopup();
        renderOrders();
      } catch (error) {
        printPopupBusy = false;
        printPopupError.textContent = error.message || 'Print order could not be placed.';
        printPopupError.hidden = false;
        printPopupPlaceOrder.disabled = false;
        printPopupPlaceOrder.textContent = 'ORDER PRINT';
      }
    };

    const renderCatalogue = () => {
      vendorList.innerHTML = '';

      [...catalogue.vendors]
        .filter((vendor) => vendor.enabled !== false)
        .sort((a, b) => Number(a.order) - Number(b.order))
        .forEach((vendor) => {
          const section = document.createElement('section');
          section.className = 'user-vendor-card';

          section.innerHTML =
            '<div class="user-vendor-title"><div class="user-vendor-index"><span>' +
            String(vendor.order).padStart(2, '0') +
            '</span></div><div><span>VENDOR</span><strong>' +
            esc(vendor.name) +
            '</strong></div></div><div class="user-vendor-options"></div>';

          const wrap = section.querySelector('.user-vendor-options');

          [...(vendor.options || [])]
            .filter((service) => service.enabled !== false)
            .sort((a, b) => Number(a.order) - Number(b.order))
            .forEach((service) => {
              const button = document.createElement('button');
              const serviceStatus = normalizeVendorStatus(service);
              const serviceOffline = serviceStatus === 'offline';
              button.type = 'button';
              button.className = 'user-service-option' + (serviceOffline ? ' is-offline' : '') + (serviceStatus === 'busy' ? ' is-busy' : '');

              const secondary =
                Number(service.service_minutes) > 0
                  ? Number(service.service_minutes) + ' min · ' +
                    (Number(service.price) === 0 ? 'Free' : money(service.price))
                  : (Number(service.price) === 0 ? 'Free' : money(service.price));

              button.innerHTML =
                '<span class="user-service-main"><strong>' + esc(service.name) +
                '</strong><small>' + esc(secondary) +
                '</small></span><span class="user-service-tail">' + vendorStatusMarkup(service) +
                '<b>›</b></span>';

              if (serviceOffline) {
                button.disabled = true;
                button.title = vendorStatusMessage(service);
                button.setAttribute('aria-disabled', 'true');
              } else {
                button.onclick = () => {
                  if (vendor.id === 'food') {
                    openFoodPopup(vendor, service);
                  } else {
                    openPrintPopup(vendor, service);
                  }
                };
              }

              wrap.appendChild(button);
            });

          vendorList.appendChild(section);
        });
    };

    foodPopupClose?.addEventListener('click', closeFoodPopup);
    foodPopupBackdrop?.addEventListener('click', closeFoodPopup);
    foodPopupPlaceOrder?.addEventListener('click', placeFoodOrder);

    printPopupClose?.addEventListener('click', closePrintPopup);
    printPopupBackdrop?.addEventListener('click', closePrintPopup);
    printPopupPlaceOrder?.addEventListener('click', placePrintOrder);
    printClearFiles?.addEventListener('click', () => {
      printFiles = [];
      renderPrintFiles();
    });
    printSelectAll?.addEventListener('change', () => {
      const selected = printSelectAll.checked;
      printFiles.forEach((entry) => {
        entry.selected = selected;
      });
      renderPrintFiles();
    });
    printSelectFiles?.addEventListener('click', (event) => {
      event.stopPropagation();
      printFileInput?.click();
    });
    printFileInput?.addEventListener('change', () => {
      addPrintFiles(printFileInput.files);
      printFileInput.value = '';
    });
    printDropZone?.addEventListener('click', (event) => {
      if (
        event.target === printSelectFiles ||
        event.target?.closest?.('#printSelectFiles')
      ) return;
      printFileInput?.click();
    });
    printDropZone?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        printFileInput?.click();
      }
    });
    ['dragenter', 'dragover'].forEach((type) => {
      printDropZone?.addEventListener(type, (event) => {
        event.preventDefault();
        if (normalizeVendorStatus(printService) !== 'offline') {
          printDropZone.classList.add('is-dragover');
        }
      });
    });
    ['dragleave', 'drop'].forEach((type) => {
      printDropZone?.addEventListener(type, (event) => {
        event.preventDefault();
        printDropZone.classList.remove('is-dragover');
      });
    });
    printDropZone?.addEventListener('drop', (event) => {
      if (normalizeVendorStatus(printService) === 'offline') return;
      addPrintFiles(event.dataTransfer?.files);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && foodPopup && !foodPopup.hidden) {
        closeFoodPopup();
      }
      if (event.key === 'Escape' && printPopup && !printPopup.hidden) {
        closePrintPopup();
      }
    });

    try {
      const vendorResponse = await fetch('/maps/campus_vendors.json', { cache: 'no-store' });
      if (!vendorResponse.ok) throw new Error('Services could not be loaded.');

      const nextCatalogue = await vendorResponse.json();
      if (nextCatalogue?.version !== 1 || !Array.isArray(nextCatalogue?.vendors)) {
        throw new Error('Invalid services catalogue.');
      }

      catalogue = nextCatalogue;
      renderCatalogue();
    } catch (error) {
      console.error('Campus services failed to load:', error);
      vendorList.innerHTML = '<div class="user-services-empty">Services are unavailable.</div>';
    }

    try {
      const orderResponse = await fetch(
        '/__campusmaas/user-orders?user_id=' + encodeURIComponent(userId),
        { cache: 'no-store' }
      );

      if (!orderResponse.ok) throw new Error('Orders could not be loaded.');

      const nextOrders = await orderResponse.json();
      if (nextOrders?.version !== 1 || !Array.isArray(nextOrders?.orders)) {
        throw new Error('Invalid orders response.');
      }

      orders = nextOrders;
      renderOrders();
    } catch (error) {
      console.error('User orders failed to load:', error);
      orderList.innerHTML = '<div class="user-services-empty">Orders are temporarily unavailable.</div>';
    }

    startUserOrderSync();
    startPolicySync();
  };
  loadVendorOrders();

  let userOrderSyncTimer = null;
  let userOrderSyncBusy = false;

  const refreshUserOrders = async () => {
    if (userOrderSyncBusy) return;
    userOrderSyncBusy = true;

    try {
      let nextCatalogue = null;
      let nextOrders = null;

      try {
        const catalogueResponse = await fetch('/maps/campus_vendors.json', { cache: 'no-store' });
        if (catalogueResponse.ok) {
          const candidate = await catalogueResponse.json();
          if (candidate?.version === 1 && Array.isArray(candidate?.vendors)) {
            nextCatalogue = candidate;
          }
        }
      } catch (error) {
        console.error('Campus services sync failed:', error);
      }

      try {
        const ordersResponse = await fetch(
          '/__campusmaas/user-orders?user_id=' + encodeURIComponent(userId),
          { cache: 'no-store' }
        );
        if (ordersResponse.ok) {
          const candidate = await ordersResponse.json();
          if (candidate?.version === 1 && Array.isArray(candidate?.orders)) {
            nextOrders = candidate;
          }
        }
      } catch (error) {
        console.error('User orders sync failed:', error);
      }

      const catalogueChanged =
        nextCatalogue && JSON.stringify(nextCatalogue) !== JSON.stringify(catalogue);

      const ordersChanged =
        nextOrders && JSON.stringify(nextOrders) !== JSON.stringify(orders);

      if (!catalogueChanged && !ordersChanged) return;

      if (catalogueChanged) {
        catalogue = nextCatalogue;
        renderCatalogue();
      }

      if (ordersChanged) {
        orders = nextOrders;
        renderOrders();
      }
    } finally {
      userOrderSyncBusy = false;
    }
  };

  const startUserOrderSync = () => {
    if (userOrderSyncTimer) window.clearInterval(userOrderSyncTimer);
    userOrderSyncTimer = window.setInterval(() => {
      void refreshUserOrders();
    }, 3000);
  };

  let accessPolicySyncBusy = false;
  let accessPolicySyncTimer = null;

  const refreshAccessPolicy = async () => {
    if (accessPolicySyncBusy) return;
    accessPolicySyncBusy = true;

    try {
      const response = await fetch('/maps/campus_access_rules.json', { cache: 'no-store' });
      if (!response.ok) return;

      const nextPolicy = await response.json();
      if (
        nextPolicy?.version !== 1 ||
        !Array.isArray(nextPolicy?.policies)
      ) return;

      if (JSON.stringify(accessPolicy) === JSON.stringify(nextPolicy)) return;

      accessPolicy.policies = nextPolicy.policies;
      accessPolicy.timezone =
        nextPolicy.timezone || accessPolicy.timezone || 'Asia/Kolkata';

      if (pointA && pointB) {
        clearRouteRendering();
        renderEndpointMarkers();
        renderUserRoute();
      }
    } finally {
      accessPolicySyncBusy = false;
    }
  };

  const startAccessPolicySync = () => {
    if (accessPolicySyncTimer) window.clearInterval(accessPolicySyncTimer);
    accessPolicySyncTimer = window.setInterval(() => {
      void refreshAccessPolicy();
    }, 5000);
  };

  startAccessPolicySync();

  window.addEventListener('pagehide', () => {
    if (accessPolicySyncTimer) {
      window.clearInterval(accessPolicySyncTimer);
      accessPolicySyncTimer = null;
    }
  }, { once: true });

  const resetTripSummary = () => {
    if (userTripFrom) userTripFrom.textContent = 'Point A';
    if (userTripTo) userTripTo.textContent = 'Point B';
    if (userTripTime) userTripTime.textContent = '—';
    if (userTripDistance) userTripDistance.textContent = '—';
  };

  const renderUserRoute = () => {
    if (!pointA || !pointB) return;

    const summary = routeSummary(
      pathData,
      pointA,
      pointB,
      accessPolicy,
      selectedUserGroup,
      gates.features,
      hasRequestedEventDestination ? 120 : USER_ROUTE_CONNECT_RADIUS_M
    );

    if (!summary) {
      if (userTripFrom) userTripFrom.textContent = 'Point A selected';
      if (userTripTo) {
        userTripTo.textContent = eventDestinationName && pointB
          ? eventDestinationName + ' unreachable'
          : 'Point B unreachable';
      }
      if (userTripTime) userTripTime.textContent = 'No route';
      if (userTripDistance) userTripDistance.textContent = '—';
      return;
    }

    const latLngs = summary.coordinates.map(([lng, lat]) => [lat, lng]);

    routeCasing = L.polyline(latLngs, {
      color: '#ffffff',
      weight: 9,
      opacity: 0.96,
      lineCap: 'round',
      lineJoin: 'round',
      interactive: false
    }).addTo(map);

    routeLine = L.polyline(latLngs, {
      color: '#1687ff',
      weight: 6,
      opacity: 1,
      lineCap: 'round',
      lineJoin: 'round',
      interactive: false
    }).addTo(map);

    const minutes = Math.max(
      1,
      Math.ceil(summary.distance / summary.walkingSpeedMps / 60)
    );

    if (userTripFrom) userTripFrom.textContent = 'Point A selected';
    if (userTripTo) {
      userTripTo.textContent = eventDestinationName && pointB
        ? eventDestinationName
        : 'Point B selected';
    }
    if (userTripTime) userTripTime.textContent = minutes + ' min';
    if (userTripDistance) userTripDistance.textContent = formatDistance(summary.distance);
    map.fitBounds(routeLine.getBounds().pad(0.18), { maxZoom: 19, animate: true });
  };

    const minutesFromClock = (value) => {
    const [hours, minutes] = String(value || '00:00').split(':').map(Number);
    return hours * 60 + minutes;
  };

  const campusClock = () => {
    const parts = new Intl.DateTimeFormat('en-IN', {
      timeZone: accessPolicy?.timezone || 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    }).formatToParts(new Date());

    const read = (type) => parts.find((part) => part.type === type)?.value || '00';    return read('hour') + ':' + read('minute');
  };

  const gatePoliciesFor = (gateId, direction = '') =>
    (accessPolicy?.policies || []).filter(
      (policy) =>
        policy?.target?.type === 'gate' &&
        String(policy?.target?.id) === String(gateId) &&
        policyAppliesToGroup(policy, selectedUserGroup) &&
        policyDirectionAllows(policy, direction) &&
        policy?.enabled !== false
    );

  const evaluateStudentGate = (gate, time = campusClock(), direction = '') => {
    const policies = gatePoliciesFor(gate?.id, direction);

    if (!policies.length) {
      return {
        allowed: true,
        preferred: false,
        priority: null,
        policy: null
      };
    }

    const currentTemporal = policyTemporalState(
      accessPolicy?.timezone || 'Asia/Kolkata'
    );

    const temporal = {
      day: currentTemporal.day,
      time
    };

    const activePolicies = policies.filter((policy) =>
      policyMatchesNow(policy, temporal)
    );

    const denyActive = activePolicies.some(
      (policy) => policy.mode === 'deny' || policy.mode === 'deny_during'
    );

    if (denyActive) {
      return {
        allowed: false,
        preferred: false,
        priority: null,
        policy: activePolicies.find(
          (policy) =>
            policy.mode === 'deny' ||
            policy.mode === 'deny_during'
        ) || null
      };
    }

    const allowOnlyPolicies = policies.filter(
      (policy) => policy.mode === 'allow_only_during'
    );

    if (allowOnlyPolicies.length) {
      return {
        allowed: allowOnlyPolicies.some((policy) =>
          activePolicies.includes(policy)
        ),
        preferred: false,
        priority: null,
        policy: allowOnlyPolicies[0] || null
      };
    }

    const conditionalAllowPolicies = policies.filter(
      (policy) =>
        policy.mode === 'allow' &&
        policyHasCondition(policy)
    );

    if (conditionalAllowPolicies.length) {
      return {
        allowed: conditionalAllowPolicies.some((policy) =>
          activePolicies.includes(policy)
        ),
        preferred: false,
        priority: null,
        policy: conditionalAllowPolicies[0] || null
      };
    }

    const preferredPolicies = activePolicies.filter(
      (policy) => policy.mode === 'preferred'
    );

    const preferred = preferredPolicies.length > 0;
    const priority = preferred
      ? Math.max(
          ...preferredPolicies.map((policy) =>
            Number.isFinite(Number(policy?.priority))
              ? Number(policy.priority)
              : 0
          )
        )
      : null;

    return {
      allowed: true,
      preferred,
      priority,
      policy: preferredPolicies[0] || activePolicies[0] || policies[0]
    };
  };

  const nearestGateForPoint = (point) => {
    let best = null;

    for (const gate of gates?.features || []) {
      const coordinate =
        gate?.properties?.access_point ||
        gate?.properties?.center;

      if (!Array.isArray(coordinate) || coordinate.length < 2) continue;

      const gatePoint = L.latLng(
        Number(coordinate[1]),
        Number(coordinate[0])
      );
      const distance = point.distanceTo(gatePoint);

      if (!best || distance < best.distance) {
        best = {
          gate,
          point: gatePoint,
          distance
        };
      }
    }

    return best;
  };

  const validateUserGateClick = (point, direction = '') => {
    const nearest = nearestGateForPoint(point);

    if (!nearest || nearest.distance > USER_GATE_MATCH_RADIUS_M) {
      return {
        allowed: true,
        nearest: null
      };
    }

    const evaluation = evaluateStudentGate(nearest.gate, campusClock(), direction);

    if (!evaluation.allowed) {
      const gateName = nearest.gate?.properties?.name || 'This gate';
      if (userTripFrom) userTripFrom.textContent = gateName + ' is closed';
      if (userTripTo) userTripTo.textContent = 'You cannot use it now';
      if (userTripTime) userTripTime.textContent = 'Unavailable';
      if (userTripDistance) userTripDistance.textContent = 'Try Gate 06';

      return {
        allowed: false,
        nearest,
        evaluation
      };
    }

    return {
      allowed: true,
      nearest,
      evaluation
    };
  };

  // User location is opt-in. The browser controls permission and accuracy.
  const locateButton = document.getElementById('userLocateButton');
  const locationStatus = document.getElementById('userLocationStatus');
  const useLocationAsStartButton = document.getElementById('userUseLocationAsStart');
  let lastKnownUserLatLng = null;
  let locationWatchId = null;
  let hasCenteredOnUserLocation = false;
  let userLocationMarker = null;
  let userLocationAccuracy = null;
  let hasAutoSetLocationAsStart = false;

  // Keep the live location above the campus perimeter mask and all map layers.
  if (!map.getPane('userLocationPane')) {
    map.createPane('userLocationPane');
    map.getPane('userLocationPane').style.zIndex = '700';
    map.getPane('userLocationPane').style.pointerEvents = 'none';
  }

  const setLocationStatus = (message, visible = true) => {
    if (!locationStatus) return;
    locationStatus.textContent = message;
    locationStatus.hidden = !visible;
  };

  const stopLocationTracking = () => {
    if (locationWatchId !== null && 'geolocation' in navigator) {
      navigator.geolocation.clearWatch(locationWatchId);
    }
    locationWatchId = null;
    locateButton?.setAttribute('aria-pressed', 'false');
    locateButton?.classList.remove('is-locating');
    const label = locateButton?.querySelector('span');
    if (label) label.textContent = 'My location';
  };

  const renderCurrentLocation = (position) => {
    const latlng = L.latLng(position.coords.latitude, position.coords.longitude);
    const accuracy = Math.max(5, Number(position.coords.accuracy) || 25);
    lastKnownUserLatLng = latlng;
    if (useLocationAsStartButton) useLocationAsStartButton.disabled = false;

    // On the first successful fix, automatically use the user's real position
    // as Point A. Subsequent GPS updates move Point A only while it still
    // represents the live location, rather than overwriting a manually chosen start.
    if (!hasAutoSetLocationAsStart) {
      clearRouteRendering();
      pointA = latlng;
      if (!hasRequestedEventDestination) {
        pointB = null;
        resetTripSummary();
        if (userTripTo) userTripTo.textContent = 'Select Point B';
      }
      if (userTripFrom) userTripFrom.textContent = 'Your current location';
      renderEndpointMarkers();
      if (pointB) renderUserRoute();
      hasAutoSetLocationAsStart = true;
    } else if (userTripFrom?.textContent === 'Your current location' && pointA) {
      pointA = latlng;
      renderEndpointMarkers();
      if (pointB) renderUserRoute();
    }

    if (!userLocationAccuracy) {
      userLocationAccuracy = L.circle(latlng, {
        radius: accuracy,
        color: '#075de8',
        weight: 2,
        opacity: 0.9,
        fillColor: '#1687ff',
        fillOpacity: 0.16,
        interactive: false,
        bubblingMouseEvents: false,
        pane: 'userLocationPane'
      }).addTo(map);
    } else {
      userLocationAccuracy.setLatLng(latlng);
      userLocationAccuracy.setRadius(accuracy);
    }

    // Use a Leaflet circle marker rather than a CSS-dependent icon so the dot
    // remains visible even if page styles or marker pane styles change.
    if (!userLocationMarker) {
      userLocationMarker = L.circleMarker(latlng, {
        radius: 9,
        color: '#ffffff',
        weight: 4,
        fillColor: '#075de8',
        fillOpacity: 1,
        opacity: 1,
        interactive: true,
        bubblingMouseEvents: false,
        pane: 'userLocationPane'
      }).addTo(map);
      userLocationMarker.bindTooltip('You are here', { direction: 'top', offset: [0, -8] });
    } else {
      userLocationMarker.setLatLng(latlng);
      userLocationMarker.setStyle({ radius: 9, color: '#ffffff', weight: 4, fillColor: '#075de8', fillOpacity: 1, opacity: 1 });
      userLocationMarker.bringToFront();
    }

    // Center on the first fix only; later GPS updates move the dot without
    // repeatedly pulling the map away from a user's manual exploration.
    if (!hasCenteredOnUserLocation) {
      map.setView(latlng, Math.max(map.getZoom(), 19), { animate: true });
      hasCenteredOnUserLocation = true;
    }
    setLocationStatus('Location updated · reported accuracy about ' + Math.round(accuracy) + ' m');
  };

  useLocationAsStartButton?.addEventListener('click', () => {
    if (!lastKnownUserLatLng) {
      setLocationStatus('Get your location first, then set it as your starting point.');
      return;
    }

    clearRouteRendering();
    pointA = L.latLng(lastKnownUserLatLng.lat, lastKnownUserLatLng.lng);
    if (!pointB) {
      resetTripSummary();
      if (userTripTo) userTripTo.textContent = 'Select Point B';
    }
    if (userTripFrom) userTripFrom.textContent = 'Your current location';
    renderEndpointMarkers();
    if (pointB) {
      renderUserRoute();
      setLocationStatus('Your current location is set as Point A. The selected destination has been kept.');
    } else {
      setLocationStatus('Your current location is set as Point A. Select a destination on the map.');
    }
  });

  const locationErrorMessage = (error) => {
    if (error?.code === 1) {
      return 'Location permission was denied. Allow location access in your browser settings and try again.';
    }
    if (error?.code === 2) {
      return 'Your location is unavailable. Check device location services and try again.';
    }
    if (error?.code === 3) {
      return 'Location request timed out. Try again in a place with a clearer GPS signal.';
    }
    return 'Could not get your location. Please try again.';
  };

  locateButton?.addEventListener('click', () => {
    if (locationWatchId !== null) {
      stopLocationTracking();
      setLocationStatus('Live location tracking stopped. Your last location remains the starting point.');
      return;
    }

    if (!('geolocation' in navigator)) {
      setLocationStatus('This browser does not support location services.');
      return;
    }

    if (!window.isSecureContext) {
      setLocationStatus('Location access requires HTTPS or localhost. Open CampusMaaS through a secure URL and try again.');
      return;
    }

    // User may be outside the campus map bounds; allow navigation to their real location.
    map.setMaxBounds(null);
    map.setMinZoom(5);

    setLocationStatus('Requesting location permission…');
    locateButton.setAttribute('aria-pressed', 'true');
    locateButton.classList.add('is-locating');
    const label = locateButton.querySelector('span');
    if (label) label.textContent = 'Stop tracking';

    locationWatchId = navigator.geolocation.watchPosition(
      renderCurrentLocation,
      (error) => {
        stopLocationTracking();
        setLocationStatus(locationErrorMessage(error));
      },
      {
        enableHighAccuracy: true,
        maximumAge: 5000,
        timeout: 15000
      }
    );
  });

  // Event pages arrive with Point B already selected. Request the user's
  // location immediately so the walking route is calculated without a second click.
  if (eventDestinationPreset && pointB) {
    locateButton?.click();
  }

  const handleUserMapClick = (event) => {
    const clicked = event.latlng;
    const isSelectingEventOrigin = Boolean(eventDestinationPreset && pointB && !pointA);
    const direction = isSelectingEventOrigin
      ? 'out'
      : ((!pointA || pointB) ? 'in' : 'out');
    const gateCheck = validateUserGateClick(clicked, direction);

    if (!gateCheck.allowed) return;

    if (isSelectingEventOrigin) {
      clearRouteRendering();
      pointA = clicked;
      const gateName = gateCheck.nearest?.gate?.properties?.name;
      if (userTripFrom) {
        userTripFrom.textContent = gateName
          ? gateName + ' selected'
          : 'Point A selected';
      }
      if (userTripTo) userTripTo.textContent = eventDestinationName || 'Event venue';
      eventDestinationPreset = false;
      renderEndpointMarkers();
      renderUserRoute();
      return;
    }

    /*
     * User endpoints are the exact coordinates of the click.
     * Developer snapping is never used here.
     */
    if (!pointA || pointB) {
      clearRouteRendering();
      pointA = clicked;
      pointB = null;
      eventDestinationName = '';
      eventDestinationPreset = false;
      resetTripSummary();

      const gateName = gateCheck.nearest?.gate?.properties?.name;
      if (userTripFrom) {
        userTripFrom.textContent = gateName
          ? gateName + ' selected'
          : 'Point A selected';
      }
      if (userTripTo) userTripTo.textContent = 'Select Point B';
      renderEndpointMarkers();
      return;
    }

    pointB = clicked;
    eventDestinationName = '';
    eventDestinationPreset = false;
    if (userTripTo) {
      const gateName = gateCheck.nearest?.gate?.properties?.name;
      userTripTo.textContent = gateName
        ? gateName + ' selected'
        : 'Point B selected';
    }
    renderEndpointMarkers();
    renderUserRoute();
  };

  resetTripSummary();
  if (eventDestinationPreset && pointB) {
    if (userTripFrom) userTripFrom.textContent = 'Choose Point A on map';
    if (userTripTo) userTripTo.textContent = eventDestinationName;
    if (userTripTime) userTripTime.textContent = 'Select Point A';
    if (userTripDistance) userTripDistance.textContent = 'Event venue';
    renderEndpointMarkers();
  }
  map.on('click', handleUserMapClick);

  const colors = {
    building: '#dedbd4',
    buildingEdge: '#bdb8af',
    water: '#b9dce7',
    green: '#d9e6d2',
    park: '#d3e4cc',
    land: '#eef0ee'
  };

  const baseLayer = L.geoJSON(places, {
    filter: (feature) => !isRoad(feature),
    style: (feature) => {
      const p = feature?.properties || {};

      if (p.natural === 'water' || p.waterway) {
        return {
          color: '#9ac6d3',
          weight: 1,
          fillColor: colors.water,
          fillOpacity: 0.95
        };
      }

      if (p.leisure || p.landuse) {
        return {
          color: '#b7c7b0',
          weight: 0.7,
          fillColor: p.leisure === 'park' ? colors.park : colors.green,
          fillOpacity: 0.9
        };
      }

      if (p.amenity === 'parking') {
        return {
          color: '#c4c1bb',
          weight: 0.7,
          fillColor: '#dfe0dd',
          fillOpacity: 0.9
        };
      }

      if (p.building) {
        return {
          color: colors.buildingEdge,
          weight: 0.7,
          fillColor: colors.building,
          fillOpacity: 1
        };
      }

      return {
        color: '#d1cec8',
        weight: 0.7,
        fillColor: colors.land,
        fillOpacity: 0.85
      };
    },
    interactive: false
  }).addTo(map);

  const roadCasing = L.geoJSON(places, {
    filter: isRoad,
    style: (feature) => roadStyle(feature, true),
    interactive: false
  }).addTo(map);

  const roads = L.geoJSON(places, {
    filter: isRoad,
    style: (feature) => roadStyle(feature),
    interactive: false
  }).addTo(map);

  const pedestrianCasing = L.geoJSON(pathData, {
    style: (feature) => ({
      color: '#ffffff',
      weight: (PATH_WIDTHS[normalizeCategory(feature)] || 3.8) + 3.2,
      opacity: 0.96,
      lineCap: 'round',
      lineJoin: 'round'
    }),
    interactive: false
  }).addTo(map);

  const pedestrianPaths = L.geoJSON(pathData, {
    style: (feature) => {
      const category = normalizeCategory(feature);

      return {
        color: PATH_COLORS[category],
        weight: PATH_WIDTHS[category],
        opacity: 1,
        lineCap: 'round',
        lineJoin: 'round'
      };
    },
    interactive: false
  }).addTo(map);

  const gateLayer = L.geoJSON(gates, {
    style: {
      color: '#475569',
      weight: 2,
      opacity: 0.95,
      fillColor: '#ffffff',
      fillOpacity: 0.18
    },
    interactive: false
  }).addTo(map);

  const buildingLabels = [];

  for (const feature of places?.features || []) {
    const name = feature?.properties?.name;
    const building = feature?.properties?.building;
    const geometry = feature?.geometry;

    if (!name || !building || !geometry?.coordinates) continue;

    const tempLayer = L.geoJSON(feature);
    const bounds = tempLayer.getBounds();

    if (!bounds.isValid()) continue;

    const marker = L.marker(bounds.getCenter(), {
      icon: L.divIcon({
        className: 'building-label',
        html:
          '<span style="--building-label-size:8px;--building-label-width:20px">' +
          escapeHtml(name) +
          '</span>',
        iconSize: [0, 0],
        iconAnchor: [0, 0]
      }),
      interactive: false,
      keyboard: false
    }).addTo(map);

    const label = marker.getElement()?.querySelector('span');

    if (label) {
      buildingLabels.push({
        name: String(name),
        bounds,
        label
      });
    }
  }

  const outer = [
    [center.lat - 1, center.lng - 1],
    [center.lat - 1, center.lng + 1],
    [center.lat + 1, center.lng + 1],
    [center.lat + 1, center.lng - 1]
  ];

  const inner = perimeterCoordinates
    .map(([lng, lat]) => [Number(lat), Number(lng)])
    .reverse();

  L.polygon([outer, inner], {
    stroke: false,
    fillColor: '#eef1f3',
    fillOpacity: 0.9,
    interactive: false
  }).addTo(map);

  /*
   * Keep all final map datasets in a deterministic stack:
   * places → roads → pedestrian casing → 4-color pedestrian network → gates
   * → perimeter mask.
   */
  void baseLayer;
  void roadCasing;
  void roads;
  void pedestrianCasing;
  void pedestrianPaths;
  const updateLabels = buildingLabelSizing(map, buildingLabels);

  map.on('zoomend', updateLabels);
  map.whenReady(() => {
    requestAnimationFrame(() => {
      map.invalidateSize({ pan: false, debounceMoveend: true });
      requestAnimationFrame(updateLabels);
    });
  });
};

void start().catch((error) => {
  console.error(error);
});
    </script>
  </main>
</MainLayout>

