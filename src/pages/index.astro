---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import 'leaflet/dist/leaflet.css';

---

<MainLayout title="CampusMaaS · Map">
  <main class="map-screen">
    <header class="floating-header">
      <a class="brand" href="/" aria-label="CampusMaaS home">
        <span class="brand-mark">M</span>
        <strong>CampusMaaS</strong>
      </a>

      <div class="top-actions">
        <button class="ghost-btn" type="button" id="locateBtn">◎ My location</button>
        <button class="map-mode-toggle" type="button" id="mapModeToggle" aria-label="Switch map view" title="Switch to terrain map">⇄</button>
        <button class="profile" type="button" aria-label="Profile">AR</button>
      </div>
    </header>

    <div id="map" class="map map-local" aria-label="Local campus map"></div>
    <div id="terrainMap" class="map map-terrain is-hidden" aria-label="Campus terrain map"></div>

    <div class="map-controls" aria-label="Map controls">
      <button type="button" data-map-action="zoom-in" aria-label="Zoom in">+</button>
      <button type="button" data-map-action="zoom-out" aria-label="Zoom out">−</button>
    </div>

    <div class="map-note" id="mapNote">Local map · 1 km boundary</div>

    <section class="dev-panel" id="devPanel" aria-hidden="true">
      <div class="dev-panel-shell">
        <header class="dev-panel-header">
          <div>
            <span class="dev-panel-kicker">DEVELOPER</span>
            <strong>Map settings</strong>
          </div>
          <button type="button" class="dev-panel-close" id="devPanelClose" aria-label="Close settings">×</button>
        </header>

        <div class="dev-panel-grid">
          <section class="dev-card">
            <div class="dev-card-title">
              <strong>Maps</strong>
              <span id="mapFileCount">0</span>
            </div>
            <div class="map-file-list" id="mapFileList">
              <div class="map-file-empty">Loading map files…</div>
            </div>
          </section>

          <section class="dev-card">
            <div class="dev-card-title">
              <strong>Zoom settings</strong>
            </div>

            <div class="zoom-setting">
              <span>Normal zoom-out limit</span>
              <strong>18</strong>
            </div>

            <div class="zoom-setting">
              <span>Maximum zoom</span>
              <strong>23</strong>
            </div>

            <div class="zoom-setting">
              <span>Override</span>
              <strong>Shift + wheel</strong>
            </div>

            <button type="button" class="dev-action" id="resetMapView">Reset map view</button>
          </section>
        </div>

        <div class="dev-panel-hint">Ctrl + Shift + U</div>
      </div>
    </section>
  </main>

  <script>
    import('leaflet').then(async ({ default: L }) => {
      const [campusResponse, perimeterResponse] = await Promise.all([
        fetch('/maps/export.geojson'),
        fetch('/maps/perimeter.geojson')
      ]);

      if (!campusResponse.ok || !perimeterResponse.ok) {
        throw new Error('Campus map data could not be loaded.');
      }

      const [campusData, perimeterData] = await Promise.all([
        campusResponse.json(),
        perimeterResponse.json()
      ]);

      const perimeterFeature = perimeterData.features[0];
      const ring = perimeterFeature.geometry.coordinates[0];
      const center = L.latLng(
        Number(perimeterFeature.properties.center[1]),
        Number(perimeterFeature.properties.center[0])
      );
      const radius = Number(perimeterFeature.properties.radius_m);

      const latRadius = radius / 111320;
      const lonRadius =
        radius / (111320 * Math.cos(center.lat * Math.PI / 180));

      const circleBounds = L.latLngBounds(
        [center.lat - latRadius, center.lng - lonRadius],
        [center.lat + latRadius, center.lng + lonRadius]
      );

      const map = L.map('map', {
        zoomControl: false,
        minZoom: 1,
        maxZoom: 23,
        scrollWheelZoom: false,
        maxBounds: circleBounds,
        maxBoundsViscosity: 1
      }).setView(center, 18);

      const colors = {
        background: '#f1f3f5',
        land: '#eef0ee',
        building: '#dedbd4',
        buildingEdge: '#bdb8af',
        water: '#b9dce7',
        green: '#d9e6d2',
        park: '#d3e4cc',
        roadCasing: '#c7c5c0',
        road: '#ffffff',
        majorRoad: '#e9c67b',
        footway: '#d1cec7'
      };

      const roadWidth = {
        motorway: 7,
        trunk: 6.5,
        primary: 6,
        secondary: 5.5,
        tertiary: 5,
        residential: 4.4,
        unclassified: 4,
        service: 3.4,
        footway: 2.7,
        path: 2.4
      };

      const isRoad = (feature) =>
        Boolean(feature?.properties?.highway || feature?.properties?.route);

      const roadStyle = (feature, casing = false) => {
        const kind = feature?.properties?.highway;
        const width = roadWidth[kind] || 3.5;
        const major = ['motorway', 'trunk', 'primary', 'secondary', 'tertiary'].includes(kind);

        return {
          color: casing
            ? colors.roadCasing
            : (major ? colors.majorRoad : colors.road),
          weight: casing ? width + 2.2 : width,
          opacity: 0.96,
          lineCap: 'round',
          lineJoin: 'round'
        };
      };

      const baseLayer = L.geoJSON(campusData, {
        filter: (feature) => !isRoad(feature),
        style: (feature) => {
          const p = feature?.properties || {};

          if (p.natural === 'water' || p.waterway) {
            return {
              color: '#9ac6d3',
              weight: 1,
              fillColor: colors.water,
              fillOpacity: 0.95
            };
          }

          if (p.leisure || p.landuse) {
            return {
              color: '#b7c7b0',
              weight: 0.7,
              fillColor: p.leisure === 'park' ? colors.park : colors.green,
              fillOpacity: 0.9
            };
          }

          if (p.amenity === 'parking') {
            return {
              color: '#c4c1bb',
              weight: 0.7,
              fillColor: '#dfe0dd',
              fillOpacity: 0.9
            };
          }

          if (p.building) {
            return {
              color: colors.buildingEdge,
              weight: 0.7,
              fillColor: colors.building,
              fillOpacity: 1
            };
          }

          return {
            color: '#d1cec8',
            weight: 0.7,
            fillColor: colors.land,
            fillOpacity: 0.85
          };
        }
      });

      const roadCasing = L.geoJSON(campusData, {
        filter: isRoad,
        style: (feature) => roadStyle(feature, true),
        interactive: false
      });

      const roads = L.geoJSON(campusData, {
        filter: isRoad,
        style: (feature) => roadStyle(feature),
        interactive: false
      });

      baseLayer.addTo(map);
      roadCasing.addTo(map);
      roads.addTo(map);

      /*
       * Building labels scale with the actual on-screen building bounds.
       * Every label is hard-limited to 8px–18px.
       */
      const buildingLabels = [];

      const clampLabelSize = (value) =>
        Math.max(8, Math.min(16, value));

      const measureTextAtOnePx = (text) => {
        const canvas = document.createElement('canvas');
        const context = canvas.getContext('2d');

        if (!context) return Math.max(1, text.length * 0.55);

        context.font = "500 1px 'DM Sans', sans-serif";
        return Math.max(1, context.measureText(text).width);
      };

      const updateBuildingLabels = () => {
        const zoom = map.getZoom();

        for (const item of buildingLabels) {
          const northWest = map.project(item.bounds.getNorthWest(), zoom);
          const southEast = map.project(item.bounds.getSouthEast(), zoom);

          const buildingWidth = Math.max(1, Math.abs(southEast.x - northWest.x));
          const buildingHeight = Math.max(1, Math.abs(southEast.y - northWest.y));

          // Keep text comfortably inside the building footprint.
          const availableWidth = buildingWidth * 0.82;
          const availableHeight = buildingHeight * 0.48;

          // Estimate the largest one-line size that fits the building width.
          const textWidthAtOnePx = measureTextAtOnePx(item.name);
          const widthBasedSize = availableWidth / textWidthAtOnePx;

          // Also limit by the building height so text never dominates a small building.
          const heightBasedSize = availableHeight;

          item.fontSize = clampLabelSize(
            Math.min(widthBasedSize, heightBasedSize)
          );

          item.label.style.setProperty(
            '--building-label-size',
            item.fontSize + 'px'
          );
          item.label.style.setProperty(
            '--building-label-width',
            availableWidth + 'px'
          );
        }
      };

      for (const feature of campusData.features || []) {
        const name = feature?.properties?.name;
        const building = feature?.properties?.building;
        const geometry = feature?.geometry;

        if (!name || !building || !geometry?.coordinates) continue;

        const tempLayer = L.geoJSON(feature);
        const bounds = tempLayer.getBounds();

        if (!bounds.isValid()) continue;

        const safeName = String(name)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');

        const marker = L.marker(bounds.getCenter(), {
          icon: L.divIcon({
            className: 'building-label',
            html:
              '<span style="--building-label-size:8px;--building-label-width:20px">' +
              safeName +
              '</span>',
            iconSize: [0, 0],
            iconAnchor: [0, 0]
          }),
          interactive: false,
          keyboard: false
        }).addTo(map);

        const label = marker.getElement()?.querySelector('span');

        if (!label) continue;

        buildingLabels.push({
          name: String(name),
          bounds,
          marker,
          label,
          fontSize: 8
        });
      }

      /*
       * Keep the source geometry as-is, but hide anything outside the
       * 1 km circular viewing area.
       */
      const outer = [
        [center.lat - 1, center.lng - 1],
        [center.lat - 1, center.lng + 1],
        [center.lat + 1, center.lng + 1],
        [center.lat + 1, center.lng - 1]
      ];

      const inner = ring
        .map(([lon, lat]) => [lat, lon])
        .reverse();

      const perimeterMask = L.polygon([outer, inner], {
        stroke: false,
        fillColor: '#eef1f3',
        fillOpacity: 0.9,
        interactive: false
      }).addTo(map);

      // Normal zoom-out stops at the 1 km view.
      const perimeterZoom = 18;
      const maxZoom = 23;

      // Leaflet's real minimum is low enough for intentional overrides.
      // The 1 km level is enforced by our normal interaction handlers.
      map.setMinZoom(1);
      map.setMaxZoom(maxZoom);
      map.setView(center, perimeterZoom, { animate: false });

      // Normal wheel scrolling respects the minimum zoom.
      // Shift + wheel is the intentional override and may zoom farther out.
      const mapElement = map.getContainer();

      mapElement.addEventListener('wheel', (event) => {
        event.preventDefault();

        const direction = event.deltaY > 0 ? -1 : 1;
        const allowBeyondLimit = event.shiftKey;
        const currentZoom = map.getZoom();

        if (direction < 0 && currentZoom <= perimeterZoom && !allowBeyondLimit) {
          return;
        }

        const nextZoom = allowBeyondLimit
          ? currentZoom + direction
          : Math.max(perimeterZoom, currentZoom + direction);

        map.setZoom(
          Math.max(1, Math.min(maxZoom, nextZoom)),
          { animate: false }
        );
      }, { passive: false });

      function constrainToPerimeter() {
        const current = map.getCenter();
        const distance = center.distanceTo(current);

        if (distance <= radius) return;

        const bearing = Math.atan2(
          (current.lng - center.lng) * Math.cos(center.lat * Math.PI / 180),
          current.lat - center.lat
        );

        const latOffset = Math.cos(bearing) * radius / 111320;
        const lonOffset =
          Math.sin(bearing) * radius /
          (111320 * Math.cos(center.lat * Math.PI / 180));

        map.setView(
          [center.lat + latOffset, center.lng + lonOffset],
          Math.max(map.getZoom(), perimeterZoom),
          { animate: false }
        );
      }

      map.on('drag', constrainToPerimeter);
      map.on('moveend', constrainToPerimeter);

      // Do not snap zoom back to the 1 km minimum after an intentional override.
      map.on('zoomend', () => {
        if (map.getZoom() >= perimeterZoom) {
          constrainToPerimeter();
        }

        updateBuildingLabels();
      });

      setTimeout(() => {
        map.invalidateSize();
        updateBuildingLabels();
      }, 100);

      const genericStyle = (feature) => {
        const p = feature?.properties || {};

        if (p.highway || p.route) {
          return roadStyle(feature);
        }

        if (p.natural === 'water' || p.waterway) {
          return {
            color: '#9ac6d3',
            weight: 1,
            fillColor: colors.water,
            fillOpacity: 0.95
          };
        }

        if (p.leisure || p.landuse) {
          return {
            color: '#b7c7b0',
            weight: 0.7,
            fillColor: p.leisure === 'park' ? colors.park : colors.green,
            fillOpacity: 0.9
          };
        }

        if (p.building) {
          return {
            color: colors.buildingEdge,
            weight: 0.7,
            fillColor: colors.building,
            fillOpacity: 1
          };
        }

        return {
          color: '#d1cec8',
          weight: 0.7,
          fillColor: colors.land,
          fillOpacity: 0.85
        };
      };

      const campusLayers = [
        baseLayer,
        roadCasing,
        roads,
        ...buildingLabels.map((item) => item.marker)
      ];

      const layerRegistry = new Map([
        ['campus.geojson', campusLayers],
        ['perimeter.geojson', [perimeterMask]]
      ]);

      const renderGenericMapFile = (name) => {
        const url = '/maps/' + encodeURIComponent(name);

        return fetch(url)
          .then((response) => {
            if (!response.ok) throw new Error('Failed to load ' + name);
            return response.json();
          })
          .then((data) => {
            const layer = L.geoJSON(data, {
              style: genericStyle,
              interactive: false
            }).addTo(map);

            layerRegistry.set(name, [layer]);
            return layer;
          });
      };

      const setLayerVisibility = async (name, enabled) => {
        if (!layerRegistry.has(name)) {
          if (!enabled) return;
          try {
            await renderGenericMapFile(name);
          } catch {
            return;
          }
        }

        for (const layer of layerRegistry.get(name) || []) {
          if (enabled) {
            if (!map.hasLayer(layer)) layer.addTo(map);
          } else if (map.hasLayer(layer)) {
            map.removeLayer(layer);
          }
        }
      };

      const manifestResponse = await fetch('/maps/manifest.json');

      if (manifestResponse.ok) {
        const manifest = await manifestResponse.json();
        const files = Array.isArray(manifest.files) ? manifest.files : [];
        const list = document.getElementById('mapFileList');
        const count = document.getElementById('mapFileCount');

        if (count) count.textContent = String(files.length);

        if (list) {
          list.innerHTML = '';

          for (const name of files) {
            const row = document.createElement('label');
            row.className = 'map-file-row';

            const info = document.createElement('span');
            const title = document.createElement('strong');
            const path = document.createElement('small');

            title.textContent = name;
            path.textContent = 'maps/' + name;

            info.append(title, path);

            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.checked =
              name === 'campus.geojson' ||
              name === 'perimeter.geojson';
            checkbox.setAttribute('data-map-file', name);

            row.append(info, checkbox);
            list.appendChild(row);

            checkbox.addEventListener('change', () => {
              void setLayerVisibility(name, checkbox.checked);
            });
          }
        }
      }

      const localMapElement = document.getElementById('map');
      const terrainMapElement = document.getElementById('terrainMap');
      const mapModeToggle = document.getElementById('mapModeToggle');
      const mapNote = document.getElementById('mapNote');

      let terrainMap = null;
      let terrainMode = false;
      let terrainLayers = [];

      const terrainStyle = (feature) => {
        const p = feature?.properties || {};
        const highway = p.highway;

        if (p.natural === 'water' || p.waterway) {
          return {
            color: '#8fbfce',
            weight: 0.8,
            fillColor: '#b9dbe4',
            fillOpacity: 0.9
          };
        }

        if (
          p.leisure ||
          ['grass', 'forest', 'recreation_ground', 'meadow', 'farmland'].includes(p.landuse)
        ) {
          return {
            color: '#aebda5',
            weight: 0.6,
            fillColor: p.leisure === 'park' ? '#cfe0c5' : '#dbe6d3',
            fillOpacity: 0.88
          };
        }

        if (p.amenity === 'parking') {
          return {
            color: '#c6c4bf',
            weight: 0.6,
            fillColor: '#dededb',
            fillOpacity: 0.9
          };
        }

        if (p.building) {
          return {
            color: '#a9a195',
            weight: 0.8,
            fillColor: '#e2d9c9',
            fillOpacity: 1
          };
        }

        if (highway) {
          const major = [
            'motorway',
            'trunk',
            'primary',
            'secondary',
            'tertiary'
          ].includes(highway);

          if (['footway', 'path', 'pedestrian', 'steps'].includes(highway)) {
            return {
              color: '#c4baa9',
              weight: 1.8,
              opacity: 0.95
            };
          }

          return {
            color: major ? '#d7ab5c' : '#ffffff',
            weight: major ? 4.6 : 3.2,
            opacity: 0.98,
            lineCap: 'round',
            lineJoin: 'round'
          };
        }

        return {
          color: '#c7c2b8',
          weight: 0.6,
          fillColor: '#ebe8df',
          fillOpacity: 0.82
        };
      };

      const createTerrainLayers = () => {
        if (terrainLayers.length) return terrainLayers;

        const outer = [
          [center.lat - 1, center.lng - 1],
          [center.lat - 1, center.lng + 1],
          [center.lat + 1, center.lng + 1],
          [center.lat + 1, center.lng - 1]
        ];

        const inner = ring
          .map(([lon, lat]) => [lat, lon])
          .reverse();

        const mask = L.polygon([outer, inner], {
          stroke: false,
          fillColor: '#eef1f3',
          fillOpacity: 0.9,
          interactive: false
        });

        const vector = L.geoJSON(campusData, {
          style: terrainStyle,
          pointToLayer: () => L.circleMarker([0, 0], { radius: 0 })
        });

        const labels = L.geoJSON(campusData, {
          filter: (feature) =>
            Boolean(feature?.properties?.building && feature?.properties?.name),
          style: {
            stroke: false,
            fill: false
          },
          onEachFeature: (feature, layer) => {
            const name = String(feature.properties.name);
            layer.bindTooltip(name, {
              permanent: true,
              direction: 'center',
              className: 'terrain-label',
              opacity: 0.9
            });
          }
        });

        terrainLayers = [vector, labels, mask];
        return terrainLayers;
      };

      const showTerrainMap = () => {
        if (!terrainMap) {
          terrainMap = L.map('terrainMap', {
            zoomControl: false,
            minZoom: 1,
            maxZoom,
            scrollWheelZoom: false,
            maxBounds: circleBounds,
            maxBoundsViscosity: 1,
            doubleClickZoom: true,
            dragging: true
          }).setView(center, perimeterZoom);

          for (const layer of createTerrainLayers()) {
            layer.addTo(terrainMap);
          }

          const terrainElement = terrainMap.getContainer();

          terrainElement.addEventListener('wheel', (event) => {
            event.preventDefault();

            const direction = event.deltaY > 0 ? -1 : 1;
            const allowBeyondLimit = event.shiftKey;
            const currentZoom = terrainMap.getZoom();

            if (
              direction < 0 &&
              currentZoom <= perimeterZoom &&
              !allowBeyondLimit
            ) {
              return;
            }

            const nextZoom = allowBeyondLimit
              ? currentZoom + direction
              : Math.max(perimeterZoom, currentZoom + direction);

            terrainMap.setZoom(
              Math.max(1, Math.min(maxZoom, nextZoom)),
              { animate: false }
            );
          }, { passive: false });

          const clampTerrainView = () => {
            const current = terrainMap.getCenter();
            const distance = center.distanceTo(current);

            if (distance <= radius) return;

            const bearing = Math.atan2(
              (current.lng - center.lng) * Math.cos(center.lat * Math.PI / 180),
              current.lat - center.lat
            );

            const latOffset = Math.cos(bearing) * radius / 111320;
            const lonOffset =
              Math.sin(bearing) * radius /
              (111320 * Math.cos(center.lat * Math.PI / 180));

            terrainMap.setView(
              [center.lat + latOffset, center.lng + lonOffset],
              Math.max(terrainMap.getZoom(), perimeterZoom),
              { animate: false }
            );
          };

          terrainMap.on('drag', clampTerrainView);
          terrainMap.on('moveend', clampTerrainView);
          terrainMap.on('zoomend', () => {
            if (terrainMap.getZoom() >= perimeterZoom) {
              clampTerrainView();
            }
          });
        }

        terrainMode = true;
        localMapElement?.classList.add('is-hidden');
        terrainMapElement?.classList.remove('is-hidden');
        terrainMap.invalidateSize();

        const localCenter = map.getCenter();
        terrainMap.setView(
          [localCenter.lat, localCenter.lng],
          map.getZoom(),
          { animate: false }
        );

        terrainMap.invalidateSize();
        mapNote && (mapNote.textContent = 'Terrain vector map · 1 km boundary');
        mapModeToggle?.setAttribute('title', 'Switch to local map');
      };

      const showLocalMap = () => {
        if (!terrainMode) return;

        terrainMode = false;
        terrainMapElement?.classList.add('is-hidden');
        localMapElement?.classList.remove('is-hidden');

        if (terrainMap) {
          const terrainCenter = terrainMap.getCenter();
          map.setView(
            [terrainCenter.lat, terrainCenter.lng],
            terrainMap.getZoom(),
            { animate: false }
          );
        }

        mapNote && (mapNote.textContent = 'Local map · 1 km boundary');
        mapModeToggle?.setAttribute('title', 'Switch to terrain map');

        setTimeout(() => map.invalidateSize(), 50);
      };

      mapModeToggle?.addEventListener('click', () => {
        if (terrainMode) {
          showLocalMap();
        } else {
          showTerrainMap();
        }
      });

      const devPanel = document.getElementById('devPanel');

      const closeDevPanel = () => {
        devPanel?.classList.remove('is-open');
        devPanel?.setAttribute('aria-hidden', 'true');
      };

      const toggleDevPanel = () => {
        const open = !devPanel?.classList.contains('is-open');
        devPanel?.classList.toggle('is-open', open);
        devPanel?.setAttribute('aria-hidden', String(!open));
      };

      window.addEventListener('keydown', (event) => {
        if (event.ctrlKey && event.shiftKey && event.key.toLowerCase() === 'u') {
          event.preventDefault();
          event.stopPropagation();
          toggleDevPanel();
        }

        if (event.key === 'Escape') {
          closeDevPanel();
        }
      }, true);

      document.getElementById('devPanelClose')?.addEventListener('click', closeDevPanel);

      document.getElementById('resetMapView')?.addEventListener('click', () => {
        map.setView(center, perimeterZoom, { animate: true });
      });

      document.querySelectorAll('[data-map-action]').forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.getAttribute('data-map-action');

          if (terrainMode && terrainMap) {
            const current = terrainMap.getZoom();

            if (action === 'zoom-in') {
              terrainMap.setZoom(Math.min(maxZoom, current + 1));
              return;
            }

            if (action === 'zoom-out') {
              terrainMap.setZoom(Math.max(1, current - 1));
              return;
            }
          }

          if (action === 'zoom-in') {
            map.setZoom(Math.min(maxZoom, map.getZoom() + 1), { animate: true });
            return;
          }

          if (action === 'zoom-out') {
            // The +/- control is an explicit override of the normal 1 km limit.
            map.setZoom(Math.max(1, map.getZoom() - 1), { animate: true });
          }
        });
      });

      document.getElementById('locateBtn')?.addEventListener('click', () => {
        if (!navigator.geolocation) return;

        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            const location = L.latLng(coords.latitude, coords.longitude);

            if (center.distanceTo(location) > radius) return;

            if (terrainMode && terrainMap) {
              terrainMap.setCenter({
                lat: coords.latitude,
                lng: coords.longitude
              });
              terrainMap.setZoom(Math.max(terrainMap.getZoom(), perimeterZoom));
              return;
            }

            map.setView(location, Math.max(map.getZoom(), perimeterZoom));
          },
          () => alert('Location permission was not granted.')
        );
      });

      void buildingLabels;
    });
  </script>
</MainLayout>
