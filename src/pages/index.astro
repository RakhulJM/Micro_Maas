---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import perimeterRaw from '../../maps/perimeter.geojson?raw';

const perimeterData = JSON.parse(perimeterRaw);
---

<MainLayout title="CampusMaaS · Map">
  <main class="map-screen">
    <header class="floating-header">
      <a class="brand" href="/" aria-label="CampusMaaS home">
        <span class="brand-mark">M</span>
        <strong>CampusMaaS</strong>
      </a>

      <div class="top-actions">
        <button class="ghost-btn" type="button" id="locateBtn">◎ My location</button>
        <button class="profile" type="button" aria-label="Profile">AR</button>
      </div>
    </header>

    <div id="map" class="map" aria-label="Interactive campus map"></div>

    <div class="map-controls" aria-label="Map controls">
      <button type="button" data-map-action="zoom-in" aria-label="Zoom in">+</button>
      <button type="button" data-map-action="zoom-out" aria-label="Zoom out">−</button>
    </div>
  </main>

  <script define:vars={{ perimeterData }}>
    import('leaflet').then(({ default: L }) => {
      const feature = perimeterData.features[0];
      const ring = feature.geometry.coordinates[0];

      const center = L.latLng(
        ring.reduce((sum, point) => sum + point[1], 0) / ring.length,
        ring.reduce((sum, point) => sum + point[0], 0) / ring.length
      );

      const radius = Number(feature.properties.radius_m);

      const map = L.map('map', {
        zoomControl: false,
        minZoom: 16,
        maxZoom: 20,
        maxBoundsViscosity: 1
      }).setView(center, 17);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 20,
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      const perimeter = L.polygon(
        ring.map(([lon, lat]) => [lat, lon]),
        {
          color: '#2563eb',
          weight: 2,
          opacity: 0.7,
          fill: false,
          interactive: false
        }
      ).addTo(map);

      const bounds = perimeter.getBounds();
      map.setMaxBounds(bounds.pad(0.015));
      map.fitBounds(bounds.pad(0.04));

      const circleCenter = center;

      function clampToPerimeter() {
        const current = map.getCenter();
        const distance = circleCenter.distanceTo(current);

        if (distance <= radius) return;

        const bearing = Math.atan2(
          (current.lng - circleCenter.lng) *
            Math.cos(circleCenter.lat * Math.PI / 180),
          current.lat - circleCenter.lat
        );

        const latOffset = Math.cos(bearing) * radius / 111320;
        const lonOffset =
          Math.sin(bearing) *
          radius /
          (111320 * Math.cos(circleCenter.lat * Math.PI / 180));

        map.setView(
          [
            circleCenter.lat + latOffset,
            circleCenter.lng + lonOffset
          ],
          map.getZoom(),
          { animate: false }
        );
      }

      map.on('moveend', clampToPerimeter);

      setTimeout(() => map.invalidateSize(), 100);

      document.querySelectorAll('[data-map-action]').forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.getAttribute('data-map-action');
          if (action === 'zoom-in') map.zoomIn();
          if (action === 'zoom-out') map.zoomOut();
        });
      });

      document.getElementById('locateBtn')?.addEventListener('click', () => {
        if (!navigator.geolocation) return;

        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            map.setView([coords.latitude, coords.longitude], 18);
            setTimeout(clampToPerimeter, 0);
          },
          () => alert('Location permission was not granted.')
        );
      });
    });
  </script>
</MainLayout>
