---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import 'leaflet/dist/leaflet.css';
import FloatingHeader from '../components/campusmaas/FloatingHeader.astro';
import MapControls from '../components/campusmaas/MapControls.astro';
import RouteCard from '../components/campusmaas/RouteCard.astro';
import PedestrianEditorCard from '../components/campusmaas/PedestrianEditorCard.astro';
import GateEditorCard from '../components/campusmaas/GateEditorCard.astro';
import MapNote from '../components/campusmaas/MapNote.astro';
import GateNameModal from '../components/campusmaas/GateNameModal.astro';
import DeletePointModal from '../components/campusmaas/DeletePointModal.astro';
import DeletePathModal from '../components/campusmaas/DeletePathModal.astro';
import DeveloperPanel from '../components/campusmaas/DeveloperPanel.astro';
---

<MainLayout title="CampusMaaS · Map">
  <main class="map-screen">
    <FloatingHeader />
    <div id="map" class="map map-local" aria-label="Local campus map"></div>
    <MapControls />
    <RouteCard />
    <PedestrianEditorCard />
    <GateEditorCard />
    <MapNote />
    <GateNameModal />
    <DeletePointModal />
    <DeletePathModal />
    <DeveloperPanel />

    <script src="../scripts/campusmaas/app.js"></script>
  </main>
</MainLayout>
