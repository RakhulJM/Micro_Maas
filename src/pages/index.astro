---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import 'leaflet/dist/leaflet.css';
import FloatingHeader from '../components/campusmaas/FloatingHeader.astro';
import MapControls from '../components/campusmaas/MapControls.astro';
import RouteCard from '../components/campusmaas/RouteCard.astro';
import PedestrianEditorCard from '../components/campusmaas/PedestrianEditorCard.astro';
import PathTypePalette from '../components/campusmaas/PathTypePalette.astro';
import GateEditorCard from '../components/campusmaas/GateEditorCard.astro';
import MapNote from '../components/campusmaas/MapNote.astro';
import GateNameModal from '../components/campusmaas/GateNameModal.astro';
import DeletePointModal from '../components/campusmaas/DeletePointModal.astro';
import DeletePathModal from '../components/campusmaas/DeletePathModal.astro';
import DeveloperPanel from '../components/campusmaas/DeveloperPanel.astro';
import AccessRulesCard from '../components/campusmaas/AccessRulesCard.astro';
import VendorManagerCard from '../components/campusmaas/VendorManagerCard.astro';
---

<MainLayout title="KEC Campus · Map">
  <main class="map-screen">
    <FloatingHeader />
    <div id="map" class="map map-local" aria-label="Local campus map"></div>
    <MapControls />
    <RouteCard />
    <PedestrianEditorCard />
    <PathTypePalette />
    <GateEditorCard />
    <MapNote />
    <GateNameModal />
    <DeletePointModal />
    <DeletePathModal />
    <DeveloperPanel />
    <div class="developer-side-workspace" aria-label="Developer workspace">
      <div class="developer-vendor-column">
        <VendorManagerCard />
      </div>
      <AccessRulesCard />
    </div>

    <script src="../scripts/campusmaas/app.js"></script>
  </main>
</MainLayout>

<style>
  .developer-side-workspace {
    position: absolute;
    z-index: 1800;
    top: 58px;
    left: 14px;
    right: 14px;
    display: grid;
    grid-template-columns: minmax(360px, 410px) minmax(430px, 470px);
    justify-content: space-between;
    align-items: start;
    gap: 16px;
    pointer-events: none;
  }

  .developer-vendor-column,
  .developer-side-workspace > .access-rules-card {
    min-width: 0;
    width: 100%;
    max-width: none;
    overflow: auto;
    box-sizing: border-box;
    pointer-events: auto;
    scrollbar-width: thin;
  }

  /* Reserve the lower-right map-control stack so the vendor panel never covers its icons. */
  .developer-vendor-column {
    max-height: calc(100dvh - 330px);
    min-height: 220px;
  }

  .developer-vendor-column .vendor-manager {
    max-height: none;
  }

  .developer-side-workspace > .access-rules-card {
    max-height: calc(100dvh - 100px);
  }

  :global(.developer-side-workspace .vendor-manager) {
    position: relative;
    inset: auto;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    width: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    box-sizing: border-box;
    box-shadow: 0 18px 52px rgba(0, 0, 0, .30);
  }

  :global(.developer-side-workspace .access-rules-card) {
    pointer-events: auto;
    position: relative;
    inset: auto;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    width: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    box-sizing: border-box;
    box-shadow: 0 18px 52px rgba(0, 0, 0, .30);
    order: -1;
  }

  @media (max-width: 1050px) {
    .developer-side-workspace {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  @media (max-width: 820px) {
    .developer-side-workspace {
      top: 50px;
      left: 10px;
      right: 10px;
      grid-template-columns: 1fr;
      gap: 10px;
      max-height: calc(100dvh - 60px);
      overflow: auto;
    }

    .developer-vendor-column {
      max-height: calc(100dvh - 250px);
      min-height: 220px;
      overflow: auto;
    }

    .developer-side-workspace > .access-rules-card {
      max-height: none;
      overflow: visible;
    }
  }

/* Developer map workspace: clearer panels and predictable responsive spacing. */
:global(.developer-side-workspace) {
  gap: 16px;
  padding: 14px;
}
:global(.developer-vendor-column) {
  border-radius: 18px;
  scrollbar-width: thin;
}
:global(.developer-side-workspace .access-rules-card) {
  border-radius: 18px;
  border-color: rgba(255,255,255,.14);
}
:global(.developer-side-workspace :where(button, input, select, textarea, a):focus-visible) {
  outline: 3px solid #78b8a0;
  outline-offset: 3px;
}
@media (max-width: 820px) {
  :global(.developer-side-workspace) {
    padding: 10px;
    border-radius: 16px;
  }
}

</style>
