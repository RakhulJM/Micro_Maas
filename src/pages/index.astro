---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
---

<MainLayout title="CampusMaaS · Map">
  <main class="map-screen">
    <header class="floating-header">
      <a class="brand" href="/" aria-label="CampusMaaS home">
        <span class="brand-mark">M</span>
        <strong>CampusMaaS</strong>
      </a>

      <div class="top-actions">
        <button class="ghost-btn" type="button" id="locateBtn">◎ My location</button>
        <button class="profile" type="button" aria-label="Profile">AR</button>
      </div>
    </header>

    <div id="map" class="map" aria-label="Interactive campus map"></div>

    <div class="map-controls" aria-label="Map controls">
      <button type="button" data-map-action="zoom-in" aria-label="Zoom in">+</button>
      <button type="button" data-map-action="zoom-out" aria-label="Zoom out">−</button>
    </div>
  </main>

  <script>
    import('leaflet').then(({ default: L }) => {
      const map = L.map('map', { zoomControl: false }).setView([11.2741, 77.6075], 16);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 20,
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      const locations = [
        { name: 'Campus Gate', coords: [11.2741, 77.6075], type: 'mobility' },
        { name: 'Hostel', coords: [11.2730, 77.6080], type: 'destination' },
        { name: 'Print Center', coords: [11.2750, 77.6060], type: 'service' },
        { name: 'Canteen', coords: [11.2800, 77.6100], type: 'service' },
        { name: 'Academic Block A', coords: [11.2768, 77.6110], type: 'destination' }
      ];

      const iconFor = (type) => L.divIcon({
        className: 'campus-pin-wrap',
        html: '<div class="campus-pin ' + type + '"></div>',
        iconSize: [18, 18],
        iconAnchor: [9, 9]
      });

      locations.forEach((place) => {
        L.marker(place.coords, { icon: iconFor(place.type) })
          .addTo(map)
          .bindTooltip(place.name, { direction: 'top', offset: [0, -8] });
      });

      const route = [
        locations[1].coords,
        locations[2].coords,
        locations[3].coords,
        locations[4].coords
      ];

      const line = L.polyline(route, {
        color: '#3b82f6',
        weight: 4,
        opacity: 0.9,
        lineCap: 'round',
        lineJoin: 'round'
      }).addTo(map);

      map.fitBounds(line.getBounds().pad(0.18));
      setTimeout(() => map.invalidateSize(), 150);

      document.querySelectorAll('[data-map-action]').forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.getAttribute('data-map-action');
          if (action === 'zoom-in') map.zoomIn();
          if (action === 'zoom-out') map.zoomOut();
        });
      });

      document.getElementById('locateBtn')?.addEventListener('click', () => {
        if (!navigator.geolocation) return;

        navigator.geolocation.getCurrentPosition(
          ({ coords }) => map.setView([coords.latitude, coords.longitude], 18),
          () => alert('Location permission was not granted.')
        );
      });
    });
  </script>
</MainLayout>
