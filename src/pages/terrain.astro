---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import 'leaflet/dist/leaflet.css';
---

<MainLayout title="CampusMaaS · Terrain">
  <main class="map-screen">
    <header class="floating-header">
      <a class="brand" href="/" aria-label="CampusMaaS home">
        <span class="brand-mark">M</span>
        <strong>CampusMaaS</strong>
      </a>

      <div class="top-actions">
        <a class="map-switch map-switch-terrain" href="/" aria-label="Switch to local map">
          <span class="map-switch-label">Map</span>
          <span class="map-switch-track" aria-hidden="true">
            <span class="map-switch-thumb"></span>
          </span>
          <span class="map-switch-label">Terrain</span>
        </a>
        <button class="profile" type="button" aria-label="Profile">AR</button>
      </div>
    </header>

    <div id="terrainMap" class="map" aria-label="Interactive campus terrain map"></div>

    <div class="map-controls" aria-label="Map controls">
      <button type="button" data-map-action="zoom-in" aria-label="Zoom in">+</button>
      <button type="button" data-map-action="zoom-out" aria-label="Zoom out">−</button>
    </div>

    <div class="map-note" id="terrainNote">Terrain · COP30 GeoTIFF · 1 km boundary</div>
  </main>

  <script>
    import('leaflet').then(async ({ default: L }) => {
      const note = document.getElementById('terrainNote');

      try {
        const perimeterResponse = await fetch('/maps/perimeter.geojson');

        if (!perimeterResponse.ok) {
          throw new Error('Campus perimeter could not be loaded.');
        }

        const perimeterData = await perimeterResponse.json();
        const perimeterFeature = perimeterData.features?.[0];

        if (!perimeterFeature) {
          throw new Error('Campus perimeter is empty.');
        }

        const ring = perimeterFeature.geometry.coordinates[0];

        const center = L.latLng(
          Number(perimeterFeature.properties.center[1]),
          Number(perimeterFeature.properties.center[0])
        );

        const radius = Number(perimeterFeature.properties.radius_m);
        const perimeterZoom = 18;
        const maxZoom = 23;

        const latRadius = radius / 111320;
        const lonRadius =
          radius / (111320 * Math.cos(center.lat * Math.PI / 180));

        const circleBounds = L.latLngBounds(
          [center.lat - latRadius, center.lng - lonRadius],
          [center.lat + latRadius, center.lng + lonRadius]
        );

        const map = L.map('terrainMap', {
          zoomControl: false,
          minZoom: 1,
          maxZoom,
          scrollWheelZoom: false,
          maxBounds: circleBounds,
          maxBoundsViscosity: 1,
          preferCanvas: true
        }).setView(center, perimeterZoom);

        // Read the real local COP30 GeoTIFF as the terrain map source.
        const GeoTIFFModule = await import(
          /* @vite-ignore */
          'https://cdn.jsdelivr.net/npm/geotiff@2.1.3/+esm'
        );

        const GeoTIFF = GeoTIFFModule.default || GeoTIFFModule;
        const tifResponse = await fetch('/maps/terrain/output_hh.tif');

        if (!tifResponse.ok) {
          throw new Error('Local COP30 GeoTIFF could not be loaded.');
        }

        const tif = await GeoTIFF.fromArrayBuffer(
          await tifResponse.arrayBuffer()
        );

        const image = await tif.getImage();
        const width = image.getWidth();
        const height = image.getHeight();
        const samplesPerPixel = image.getSamplesPerPixel();

        let bbox;
        try {
          bbox = image.getBoundingBox();
        } catch {
          bbox = [
            center.lng - lonRadius,
            center.lat - latRadius,
            center.lng + lonRadius,
            center.lat + latRadius
          ];
        }

        const terrainBounds = {
          west: Number(bbox[0]),
          south: Number(bbox[1]),
          east: Number(bbox[2]),
          north: Number(bbox[3])
        };

        if (
          !Number.isFinite(terrainBounds.west) ||
          !Number.isFinite(terrainBounds.south) ||
          !Number.isFinite(terrainBounds.east) ||
          !Number.isFinite(terrainBounds.north) ||
          terrainBounds.east <= terrainBounds.west ||
          terrainBounds.north <= terrainBounds.south
        ) {
          throw new Error('COP30 GeoTIFF has invalid geographic bounds.');
        }

        // COP30 may be stored as either a single-band elevation raster
        // or a visual multi-band raster. Support both without converting
        // the GeoTIFF into PNG/JPG tiles.
        let raster = null;
        let rgb = null;

        if (samplesPerPixel >= 3) {
          rgb = await image.readRGB({
            interleave: true,
            enableAlpha: true
          });
        } else {
          raster = await image.readRasters({
            interleave: true
          });
        }

        let minElevation = 0;
        let maxElevation = 1;
        let elevationRange = 1;

        if (raster) {
          minElevation = Infinity;
          maxElevation = -Infinity;

          for (let index = 0; index < raster.length; index += 1) {
            const value = Number(raster[index]);

            if (!Number.isFinite(value)) continue;

            minElevation = Math.min(minElevation, value);
            maxElevation = Math.max(maxElevation, value);
          }

          if (
            !Number.isFinite(minElevation) ||
            !Number.isFinite(maxElevation)
          ) {
            throw new Error('COP30 GeoTIFF contains no valid elevation values.');
          }

          elevationRange =
            Math.max(maxElevation - minElevation, 1);
        }

        const sampleElevation = (x, y) => {
          const clampedX = Math.max(0, Math.min(width - 1, x));
          const clampedY = Math.max(0, Math.min(height - 1, y));

          return Number(raster[clampedY * width + clampedX]);
        };

        const sampleRgb = (x, y) => {
          const clampedX = Math.max(0, Math.min(width - 1, x));
          const clampedY = Math.max(0, Math.min(height - 1, y));
          const offset = (clampedY * width + clampedX) * 4;

          return [
            Number(rgb[offset]),
            Number(rgb[offset + 1]),
            Number(rgb[offset + 2]),
            Number(rgb[offset + 3] ?? 255)
          ];
        };

        const getTerrainColor = (elevation, shade) => {
          const normalized = Math.max(
            0,
            Math.min(1, (elevation - minElevation) / elevationRange)
          );

          let r;
          let g;
          let b;

          if (normalized < 0.25) {
            const q = normalized / 0.25;
            r = 224 - q * 28;
            g = 233 - q * 7;
            b = 211 - q * 22;
          } else if (normalized < 0.55) {
            const q = (normalized - 0.25) / 0.30;
            r = 196 + q * 17;
            g = 226 - q * 16;
            b = 189 - q * 29;
          } else if (normalized < 0.80) {
            const q = (normalized - 0.55) / 0.25;
            r = 213 + q * 17;
            g = 210 - q * 19;
            b = 161 - q * 18;
          } else {
            const q = (normalized - 0.80) / 0.20;
            r = 230 - q * 14;
            g = 191 - q * 18;
            b = 143 - q * 8;
          }

          const light = Math.max(
            0.70,
            Math.min(1.18, shade)
          );

          return [
            Math.round(r * light),
            Math.round(g * light),
            Math.round(b * light)
          ];
        };

        const TerrainGridLayer = L.GridLayer.extend({
          createTile(coords, done) {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;

            const context = canvas.getContext('2d', {
              alpha: false
            });

            if (!context) {
              done(new Error('Terrain canvas could not be created.'), canvas);
              return canvas;
            }

            const pixels = context.createImageData(256, 256);
            const output = pixels.data;

            const tileScale = 2 ** coords.z;
            const tileWest =
              coords.x / tileScale * 360 - 180;
            const tileEast =
              (coords.x + 1) / tileScale * 360 - 180;

            const tileNorth =
              180 / Math.PI *
              Math.atan(
                Math.sinh(
                  Math.PI *
                  (1 - 2 * coords.y / tileScale)
                )
              );

            const tileSouth =
              180 / Math.PI *
              Math.atan(
                Math.sinh(
                  Math.PI *
                  (1 - 2 * (coords.y + 1) / tileScale)
                )
              );

            const tileLonSpan = tileEast - tileWest;
            const tileLatSpan = tileNorth - tileSouth;

            for (let py = 0; py < 256; py += 1) {
              const lat =
                tileNorth - (py / 255) * tileLatSpan;

              for (let px = 0; px < 256; px += 1) {
                const lon =
                  tileWest + (px / 255) * tileLonSpan;

                const rasterX =
                  (lon - terrainBounds.west) /
                  (terrainBounds.east - terrainBounds.west) *
                  (width - 1);

                const rasterY =
                  (terrainBounds.north - lat) /
                  (terrainBounds.north - terrainBounds.south) *
                  (height - 1);

                const outIndex = (py * 256 + px) * 4;

                if (
                  rasterX < 0 ||
                  rasterY < 0 ||
                  rasterX > width - 1 ||
                  rasterY > height - 1
                ) {
                  output[outIndex] = 238;
                  output[outIndex + 1] = 241;
                  output[outIndex + 2] = 243;
                  output[outIndex + 3] = 255;
                  continue;
                }

                const x0 = Math.floor(rasterX);
                const y0 = Math.floor(rasterY);
                const x1 = Math.min(width - 1, x0 + 1);
                const y1 = Math.min(height - 1, y0 + 1);

                if (rgb) {
                  const [red, green, blue, alpha] =
                    sampleRgb(x0, y0);

                  output[outIndex] = red;
                  output[outIndex + 1] = green;
                  output[outIndex + 2] = blue;
                  output[outIndex + 3] = alpha;
                  continue;
                }

                const fx = rasterX - x0;
                const fy = rasterY - y0;

                const e00 = sampleElevation(x0, y0);
                const e10 = sampleElevation(x1, y0);
                const e01 = sampleElevation(x0, y1);
                const e11 = sampleElevation(x1, y1);

                const elevation =
                  e00 * (1 - fx) * (1 - fy) +
                  e10 * fx * (1 - fy) +
                  e01 * (1 - fx) * fy +
                  e11 * fx * fy;

                const left =
                  sampleElevation(Math.max(0, x0 - 1), Math.round(rasterY));
                const right =
                  sampleElevation(Math.min(width - 1, x1 + 1), Math.round(rasterY));
                const up =
                  sampleElevation(Math.round(rasterX), Math.max(0, y0 - 1));
                const down =
                  sampleElevation(Math.round(rasterX), Math.min(height - 1, y1 + 1));

                const dx = right - left;
                const dy = down - up;

                const slope =
                  Math.sqrt(dx * dx + dy * dy);

                const shade =
                  1.0 -
                  dx * 0.015 -
                  dy * 0.010 -
                  Math.min(0.16, slope * 0.0025);

                const [red, green, blue] =
                  getTerrainColor(elevation, shade);

                output[outIndex] = red;
                output[outIndex + 1] = green;
                output[outIndex + 2] = blue;
                output[outIndex + 3] = 255;
              }
            }

            context.putImageData(pixels, 0, 0);
            done(null, canvas);

            return canvas;
          }
        });

        const terrainMapLayer = new TerrainGridLayer({
          tileSize: 256,
          updateWhenZooming: false,
          keepBuffer: 2,
          noWrap: true,
          opacity: 1
        });

        terrainMapLayer.addTo(map);

        // Mask only outside the existing exact perimeter.
        const outer = [
          [center.lat - 1, center.lng - 1],
          [center.lat - 1, center.lng + 1],
          [center.lat + 1, center.lng + 1],
          [center.lat + 1, center.lng - 1],
          [center.lat - 1, center.lng - 1]
        ];

        const inner = ring
          .map(([lon, lat]) => [lat, lon])
          .reverse();

        L.polygon([outer, inner], {
          stroke: false,
          fillColor: '#eef1f3',
          fillOpacity: 0.94,
          interactive: false
        }).addTo(map);

        const clampToPerimeter = () => {
          const current = map.getCenter();
          const distance = center.distanceTo(current);

          if (distance <= radius) return;

          const bearing = Math.atan2(
            (current.lng - center.lng) *
              Math.cos(center.lat * Math.PI / 180),
            current.lat - center.lat
          );

          const latOffset =
            Math.cos(bearing) * radius / 111320;

          const lonOffset =
            Math.sin(bearing) * radius /
            (111320 * Math.cos(center.lat * Math.PI / 180));

          map.setView(
            [
              center.lat + latOffset,
              center.lng + lonOffset
            ],
            Math.max(map.getZoom(), perimeterZoom),
            { animate: false }
          );
        };

        map.on('drag', clampToPerimeter);
        map.on('moveend', clampToPerimeter);

        map.on('zoomend', () => {
          if (map.getZoom() >= perimeterZoom) {
            clampToPerimeter();
          }
        });

        const mapElement = map.getContainer();

        mapElement.addEventListener('wheel', (event) => {
          event.preventDefault();

          const direction = event.deltaY > 0 ? -1 : 1;
          const overrideLimit = event.shiftKey;
          const currentZoom = map.getZoom();

          if (
            direction < 0 &&
            currentZoom <= perimeterZoom &&
            !overrideLimit
          ) {
            return;
          }

          const nextZoom = overrideLimit
            ? currentZoom + direction
            : Math.max(perimeterZoom, currentZoom + direction);

          map.setZoom(
            Math.max(1, Math.min(maxZoom, nextZoom)),
            { animate: false }
          );
        }, { passive: false });

        document
          .querySelectorAll('[data-map-action]')
          .forEach((button) => {
            button.addEventListener('click', () => {
              const action =
                button.getAttribute('data-map-action');

              if (action === 'zoom-in') {
                map.setZoom(
                  Math.min(maxZoom, map.getZoom() + 1),
                  { animate: true }
                );
              }

              if (action === 'zoom-out') {
                map.setZoom(
                  Math.max(1, map.getZoom() - 1),
                  { animate: true }
                );
              }
            });
          });

        note?.setAttribute(
          'data-ready',
          'true'
        );

        setTimeout(() => map.invalidateSize(), 100);
      } catch (error) {
        console.error('CampusMaaS terrain error:', error);

        if (note) {
          const message =
            error instanceof Error ? error.message : String(error);

          note.textContent =
            `Terrain failed to load · ${message}`;
        }
      }
    });
  </script>
</MainLayout>
