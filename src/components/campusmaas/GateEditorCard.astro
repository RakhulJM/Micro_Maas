---

<section class="gate-card" id="gateCard" aria-live="polite" aria-hidden="true">
  <div class="edit-card-top">
    <div>
      <span class="edit-card-kicker">GATE EDITOR</span>
      <strong id="gateStatus">Drag on the map to create a gate</strong>
    </div>
    <button type="button" class="route-card-close" id="gateCancel" aria-label="Close gate editor">×</button>
  </div>
  <div class="edit-actions">
    <button type="button" class="edit-action edit-action-primary" id="gateNew">New gate</button>
    <button type="button" class="edit-action" id="gateRename" hidden>Rename</button>
    <button type="button" class="edit-action" id="gateRotateLeft" hidden>−1°</button>
    <button type="button" class="edit-action" id="gateRotateRight" hidden>+1°</button>
    <button type="button" class="edit-action edit-delete-action" id="gateDelete" hidden>Delete gate</button>
  </div>
</section>
