---
---

<section class="path-type-palette" id="pathTypePalette" aria-hidden="true">
  <div class="path-type-palette-title">PATH TYPE</div>
  <div class="path-type-palette-options">
    <button type="button" class="path-type-option path-type-main-road" data-path-type="Main Road" aria-pressed="false">
      <span class="path-type-swatch" aria-hidden="true"></span>
      <span>Main Road</span>
    </button>
    <button type="button" class="path-type-option path-type-road" data-path-type="Road" aria-pressed="false">
      <span class="path-type-swatch" aria-hidden="true"></span>
      <span>Road</span>
    </button>
    <button type="button" class="path-type-option path-type-ground" data-path-type="Ground" aria-pressed="false">
      <span class="path-type-swatch" aria-hidden="true"></span>
      <span>Ground</span>
    </button>
    <button type="button" class="path-type-option path-type-pedestrian" data-path-type="Pedestrian Path" aria-pressed="false">
      <span class="path-type-swatch" aria-hidden="true"></span>
      <span>Pedestrian Path</span>
    </button>
  </div>
</section>

<section class="ground-shape-palette" id="groundShapePalette" aria-hidden="true">
  <div class="path-type-palette-title">GROUND SHAPE</div>
  <div class="path-type-palette-options">
    <button type="button" class="ground-shape-option" data-ground-shape="square" aria-pressed="false">
      <span class="ground-shape-icon" aria-hidden="true">□</span>
      <span>Square</span>
    </button>
    <button type="button" class="ground-shape-option" data-ground-shape="circle" aria-pressed="false">
      <span class="ground-shape-icon" aria-hidden="true">○</span>
      <span>Circle</span>
    </button>
    <button type="button" class="ground-shape-option" data-ground-shape="freehand" aria-pressed="false">
      <span class="ground-shape-icon" aria-hidden="true">✎</span>
      <span>Free line</span>
    </button>
    <button type="button" class="ground-shape-option" data-ground-shape="polygon" aria-pressed="false">
      <span class="ground-shape-icon" aria-hidden="true">⬡</span>
      <span>Polygon</span>
    </button>
  </div>
</section>
