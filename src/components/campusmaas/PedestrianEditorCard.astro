---

<section class="edit-card" id="editCard" aria-live="polite" aria-hidden="true">
  <div class="edit-card-top">
    <div>
      <span class="edit-card-kicker">PATH EDITOR</span>
      <strong id="editStatus">Click the map to add points</strong>
    </div>
    <button type="button" class="route-card-close" id="editCancel" aria-label="Cancel path">×</button>
  </div>
  <div class="edit-actions">
    <button type="button" class="edit-action edit-action-primary" id="editNewPath">New path</button>
    <button type="button" class="edit-action edit-action-primary" id="editFinish" hidden>Finish</button>
    <button type="button" class="edit-action" id="editUndo" hidden>Undo</button>
    <button type="button" class="edit-action edit-delete-action" id="editDeletePoint" hidden>Delete point</button>
    <button type="button" class="edit-action edit-delete-action" id="editDelete" hidden>Delete path</button>
  </div>
</section>
