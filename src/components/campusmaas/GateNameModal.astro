---
---

<section class="gate-name-modal" id="gateNameModal" aria-hidden="true">
  <div class="gate-name-dialog" role="dialog" aria-modal="true" aria-labelledby="gateNameTitle">
    <div class="delete-point-header">
      <div>
        <span class="delete-point-kicker">CAMPUS GATE</span>
        <strong id="gateNameTitle">Name this gate</strong>
      </div>
      <button type="button" class="route-card-close" id="gateNameCancel" aria-label="Cancel gate">×</button>
    </div>
    <label class="gate-name-field">
      <span>Gate name</span>
      <input id="gateNameInput" type="text" maxlength="80" autocomplete="off" placeholder="Main Gate" />
    </label>
    <div class="gate-name-actions">
      <button type="button" class="edit-action" id="gateNameCancelButton">Cancel</button>
      <button type="button" class="edit-action edit-action-primary" id="gateNameConfirm">Create gate</button>
    </div>
  </div>
</section>
