---
---

<section class="dev-panel" id="devPanel" aria-hidden="true">
  <div class="dev-panel-shell">
    <header class="dev-panel-header">
      <div>
        <span class="dev-panel-kicker">DEVELOPER</span>
        <strong>Map settings</strong>
      </div>
      <button type="button" class="dev-panel-close" id="devPanelClose" aria-label="Close settings">×</button>
    </header>

    <div class="dev-panel-grid">
      <section class="dev-card">
        <div class="dev-card-title">
          <strong>Maps</strong>
          <span id="mapFileCount">0</span>
        </div>
        <div class="map-file-list" id="mapFileList">
          <div class="map-file-empty">Loading map files…</div>
        </div>
      </section>

      <section class="dev-card">
        <div class="dev-card-title">
          <strong>Zoom settings</strong>
        </div>

        <div class="zoom-setting">
          <span>Normal zoom-out limit</span>
          <strong>18</strong>
        </div>

        <div class="zoom-setting">
          <span>Maximum zoom</span>
          <strong>25</strong>
        </div>

        <label class="edit-mode-setting">
          <span>
            <strong>Edit mode</strong>
            <small>Enable campus map editing tools</small>
          </span>
          <input type="checkbox" id="editModeToggle" />
        </label>

        <div class="zoom-setting">
          <span>Pedestrian edit file</span>
          <strong id="pathEditFileStatus">Loaded</strong>
        </div>

        <button type="button" class="dev-action" id="savePathEdits">Save pedestrian GeoJSON</button>

        <div class="zoom-setting">
          <span>Gate edit file</span>
          <strong id="gateEditFileStatus">Loaded</strong>
        </div>

        <button type="button" class="dev-action" id="saveGateEdits">Save gates GeoJSON</button>

        <label class="edit-mode-setting">
          <span>
            <strong>Show original network</strong>
            <small>Developer comparison only</small>
          </span>
          <input type="checkbox" id="showBasePedestrianToggle" />
        </label>

        <button type="button" class="dev-action" id="resetMapView">Reset map view</button>
      </section>

      <section class="dev-card access-rules-card">
        <div class="dev-card-title">
          <strong>Access rules</strong>
          <span id="accessRulesVersion">v1</span>
        </div>

        <div class="access-rule-live">
          <span>Campus time</span>
          <strong id="accessRuleClock">—</strong>
        </div>

        <div class="access-rule-row">
          <div>
            <strong>Students · Gate 06</strong>
            <small>Entry + exit · college preferred gate</small>
          </div>
          <span class="access-rule-priority">85</span>
        </div>

        <div class="access-rule-row access-rule-row-gate09">
          <div>
            <strong>Students · Gate 09</strong>
            <small id="gate09RuleStatus">Loading rule status…</small>
          </div>
          <span class="access-rule-state" id="gate09RuleState">—</span>
        </div>

        <div class="access-rule-windows" aria-label="Gate 09 allowed times">
          <span>Gate 09 windows</span>
          <div id="gate09RuleWindows">07:00–08:45 · 12:25–13:25 · 16:15–18:00</div>
        </div>

        <p class="access-rule-note">
          Gate 06 is a preference, not an exclusive restriction. Gate 09 is unavailable to students outside its listed windows.
        </p>
      </section>
    </div>

    <div class="dev-panel-hint">Ctrl + Shift + U</div>
  </div>
</section>

<script>
  const accessRuleClock = document.getElementById('accessRuleClock');
  const gate09RuleStatus = document.getElementById('gate09RuleStatus');
  const gate09RuleState = document.getElementById('gate09RuleState');
  const gate09RuleWindows = document.getElementById('gate09RuleWindows');
  const accessRulesVersion = document.getElementById('accessRulesVersion');

  const minutesFromClock = (value) => {
    const [hours, minutes] = String(value || '00:00').split(':').map(Number);
    return hours * 60 + minutes;
  };

  const isWindowActive = (windows, time) => {
    const current = minutesFromClock(time);
    return (Array.isArray(windows) ? windows : []).some((window) => {
      const start = minutesFromClock(window?.start);
      const end = minutesFromClock(window?.end);
      return current >= start && current <= end;
    });
  };

  const getCampusClock = () => {
    const parts = new Intl.DateTimeFormat('en-IN', {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    }).formatToParts(new Date());

    const read = (type) => parts.find((part) => part.type === type)?.value || '00';
    return read('hour') + ':' + read('minute');
  };

  const refreshAccessRuleUi = async () => {
    try {
      const response = await fetch('/maps/campus_access_rules.json', { cache: 'no-store' });
      if (!response.ok) throw new Error('Access rules unavailable.');

      const rules = await response.json();
      const gate09Policy = (rules?.policies || []).find(
        (policy) => policy?.id === 'students-gate-09-time'
      );

      const clock = getCampusClock();
      const active = isWindowActive(gate09Policy?.windows, clock);
      const windows = Array.isArray(gate09Policy?.windows)
        ? gate09Policy.windows.map((window) => window.start + '–' + window.end)
        : [];

      if (accessRulesVersion) {
        accessRulesVersion.textContent = 'v' + String(rules?.version || 1);
      }

      if (accessRuleClock) accessRuleClock.textContent = clock + ' IST';

      if (gate09RuleStatus) {
        gate09RuleStatus.textContent = active
          ? 'Open for students now · in + out'
          : 'Closed for students now · time restricted';
      }

      if (gate09RuleState) {
        gate09RuleState.textContent = active ? 'OPEN' : 'CLOSED';
        gate09RuleState.classList.toggle('is-open', active);
        gate09RuleState.classList.toggle('is-closed', !active);
      }

      if (gate09RuleWindows && windows.length) {
        gate09RuleWindows.textContent = windows.join(' · ');
      }
    } catch {
      if (accessRuleClock) accessRuleClock.textContent = 'Unavailable';
      if (gate09RuleStatus) gate09RuleStatus.textContent = 'Could not load policy';
      if (gate09RuleState) {
        gate09RuleState.textContent = '—';
        gate09RuleState.classList.remove('is-open', 'is-closed');
      }
    }
  };

  void refreshAccessRuleUi();
  window.setInterval(() => {
    void refreshAccessRuleUi();
  }, 30000);
</script>
