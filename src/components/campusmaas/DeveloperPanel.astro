---
---

<section class="dev-panel" id="devPanel" aria-hidden="true">
  <div class="dev-panel-shell">
    <header class="dev-panel-header">
      <div>
        <span class="dev-panel-kicker">DEVELOPER</span>
        <strong>Map settings</strong>
      </div>
      <button type="button" class="dev-panel-close" id="devPanelClose" aria-label="Close settings">×</button>
    </header>

    <div class="dev-panel-grid">
      <section class="dev-card">
        <div class="dev-card-title">
          <strong>Maps</strong>
          <span id="mapFileCount">0</span>
        </div>
        <div class="map-file-list" id="mapFileList">
          <div class="map-file-empty">Loading map files…</div>
        </div>
      </section>

      <section class="dev-card">
        <div class="dev-card-title">
          <strong>Zoom settings</strong>
        </div>

        <div class="zoom-setting">
          <span>Normal zoom-out limit</span>
          <strong>18</strong>
        </div>

        <div class="zoom-setting">
          <span>Maximum zoom</span>
          <strong>25</strong>
        </div>

        <label class="edit-mode-setting">
          <span>
            <strong>Edit mode</strong>
            <small>Enable campus map editing tools</small>
          </span>
          <input type="checkbox" id="editModeToggle" />
        </label>

        <div class="zoom-setting">
          <span>Pedestrian edit file</span>
          <strong id="pathEditFileStatus">Loaded</strong>
        </div>

        <button type="button" class="dev-action" id="savePathEdits">Save pedestrian GeoJSON</button>

        <div class="zoom-setting">
          <span>Gate edit file</span>
          <strong id="gateEditFileStatus">Loaded</strong>
        </div>

        <button type="button" class="dev-action" id="saveGateEdits">Save gates GeoJSON</button>

        <label class="edit-mode-setting">
          <span>
            <strong>Show original network</strong>
            <small>Developer comparison only</small>
          </span>
          <input type="checkbox" id="showBasePedestrianToggle" />
        </label>

        <button type="button" class="dev-action" id="resetMapView">Reset map view</button>
      </section>

      <section class="dev-card access-rules-card">
        <div class="dev-card-title">
          <div>
            <strong>Access rules</strong>
            <small class="access-rules-subtitle">Independent of Edit Mode</small>
          </div>
          <span id="accessRulesStatus" class="access-rules-status">Loading</span>
        </div>

        <div class="access-rule-editor">
          <div class="access-rule-editor-head">
            <div>
              <span class="access-rule-kicker">STUDENTS</span>
              <strong>Gate 06</strong>
              <small>Entry + exit · preferred gate</small>
            </div>

            <label class="access-rule-priority-field">
              <span>Priority</span>
              <input id="studentGate06Priority" type="number" min="0" max="100" step="1" value="85" inputmode="numeric" />
            </label>
          </div>
        </div>

        <div class="access-rule-editor">
          <div class="access-rule-editor-head">
            <div>
              <span class="access-rule-kicker">STUDENTS</span>
              <strong>Gate 09</strong>
              <small>Entry + exit · available only in listed windows</small>
            </div>
          </div>

          <div class="access-rule-window-list" id="studentGate09WindowsEditor"></div>

          <button type="button" class="access-rule-add" id="addGate09Window">+ Add time window</button>
        </div>

        <div class="access-rule-live">
          <span>Campus time</span>
          <strong id="accessRuleClock">—</strong>
        </div>

        <p class="access-rule-note">
          Changes here affect the campus access policy. Edit Mode controls map geometry only.
        </p>

        <div class="access-rule-actions">
          <button type="button" class="dev-action access-rule-save" id="saveAccessRules">Save access rules</button>
        </div>
      </section>
    </div>

    <div class="dev-panel-hint">Ctrl + Shift + U</div>
  </div>
</section>

<script>
  const initAccessRulesEditor = () => {
    const clock = document.getElementById('accessRuleClock');
    const status = document.getElementById('accessRulesStatus');
    const priority = document.getElementById('studentGate06Priority');
    const windowsEditor = document.getElementById('studentGate09WindowsEditor');
    const addWindowButton = document.getElementById('addGate09Window');
    const saveButton = document.getElementById('saveAccessRules');

    let rules = null;
    let saving = false;

    const getClock = () => {
      const parts = new Intl.DateTimeFormat('en-IN', {
        timeZone: 'Asia/Kolkata',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      }).formatToParts(new Date());

      const read = (type) =>
        parts.find((part) => part.type === type)?.value || '00';

      return read('hour') + ':' + read('minute');
    };

    const renderWindow = (windowData = { start: '07:00', end: '08:45' }) => {
      if (!windowsEditor) return;

      const row = document.createElement('div');
      row.className = 'access-rule-window-row';

      const startLabel = document.createElement('label');
      const startCaption = document.createElement('span');
      startCaption.textContent = 'From';
      const startInput = document.createElement('input');
      startInput.type = 'time';
      startInput.value = String(windowData.start || '07:00');
      startInput.setAttribute('data-rule-window', 'start');
      startLabel.append(startCaption, startInput);

      const arrow = document.createElement('span');
      arrow.className = 'access-rule-arrow';
      arrow.textContent = '→';

      const endLabel = document.createElement('label');
      const endCaption = document.createElement('span');
      endCaption.textContent = 'To';
      const endInput = document.createElement('input');
      endInput.type = 'time';
      endInput.value = String(windowData.end || '08:45');
      endInput.setAttribute('data-rule-window', 'end');
      endLabel.append(endCaption, endInput);

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'access-rule-remove';
      remove.textContent = '×';
      remove.setAttribute('aria-label', 'Remove time window');
      remove.addEventListener('click', () => {
        row.remove();
      });

      row.append(startLabel, arrow, endLabel, remove);
      windowsEditor.appendChild(row);
    };

    const renderRules = () => {
      if (!rules?.policies) return;

      const gate06 = rules.policies.find(
        (policy) => policy?.id === 'students-gate-06-preferred'
      );

      const gate09 = rules.policies.find(
        (policy) => policy?.id === 'students-gate-09-time'
      );

      if (priority) {
        priority.value = String(Number(gate06?.priority) || 85);
      }

      if (windowsEditor) {
        windowsEditor.innerHTML = '';
        for (const windowData of gate09?.windows || []) {
          renderWindow(windowData);
        }
      }
    };

    const updateClock = () => {
      if (clock) clock.textContent = getClock() + ' IST';
    };

    const loadRules = async () => {
      try {
        const response = await fetch('/maps/campus_access_rules.json', { cache: 'no-store' });
        if (!response.ok) throw new Error('Access rules unavailable.');

        rules = await response.json();
        renderRules();
        updateClock();

        if (status) {
          status.textContent = 'Loaded';
          status.classList.remove('is-error', 'is-saving');
        }
      } catch (error) {
        if (status) {
          status.textContent = 'Load failed';
          status.classList.add('is-error');
        }
      }
    };

    const collectRules = () => {
      if (!rules?.policies) return null;

      const next = JSON.parse(JSON.stringify(rules));

      const gate06 = next.policies.find(
        (policy) => policy?.id === 'students-gate-06-preferred'
      );

      const gate09 = next.policies.find(
        (policy) => policy?.id === 'students-gate-09-time'
      );

      if (!gate06 || !gate09) return null;

      const parsedPriority = Number(priority?.value);
      if (!Number.isInteger(parsedPriority) || parsedPriority < 0 || parsedPriority > 100) {
        throw new Error('Gate 06 priority must be between 0 and 100.');
      }

      const windowRows = Array.from(
        windowsEditor?.querySelectorAll('.access-rule-window-row') || []
      );

      if (!windowRows.length) {
        throw new Error('Gate 09 needs at least one time window.');
      }

      const timePattern = /^([01]\d|2[0-3]):[0-5]\d$/;

      const windows = windowRows.map((row) => {
        const start = row.querySelector('[data-rule-window="start"]')?.value || '';
        const end = row.querySelector('[data-rule-window="end"]')?.value || '';

        if (!timePattern.test(start) || !timePattern.test(end)) {
          throw new Error('Every Gate 09 window needs a valid start and end time.');
        }

        const toMinutes = (value) => {
          const [hour, minute] = value.split(':').map(Number);
          return hour * 60 + minute;
        };

        if (toMinutes(start) >= toMinutes(end)) {
          throw new Error('Each Gate 09 window must end after it starts.');
        }

        return { start, end };
      });

      gate06.priority = parsedPriority;
      gate09.windows = windows;

      return next;
    };

    const saveRules = async () => {
      if (saving) return;

      try {
        const next = collectRules();
        if (!next) throw new Error('Required student gate policies are missing.');

        saving = true;
        if (saveButton) saveButton.disabled = true;
        if (status) {
          status.textContent = 'Saving…';
          status.classList.remove('is-error');
          status.classList.add('is-saving');
        }

        const response = await fetch('/__campusmaas/save-access-rules', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(next)
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          throw new Error(result?.error || 'Access rules could not be saved.');
        }

        rules = next;

        if (status) {
          status.textContent = 'Saved';
          status.classList.remove('is-error', 'is-saving');
          status.classList.add('is-saved');
        }

        window.setTimeout(() => {
          if (status) {
            status.textContent = 'Loaded';
            status.classList.remove('is-saved');
          }
        }, 1600);
      } catch (error) {
        if (status) {
          status.textContent = error instanceof Error ? error.message : 'Save failed';
          status.classList.remove('is-saving', 'is-saved');
          status.classList.add('is-error');
        }
      } finally {
        saving = false;
        if (saveButton) saveButton.disabled = false;
      }
    };

    addWindowButton?.addEventListener('click', () => {
      renderWindow({ start: '07:00', end: '08:45' });
    });

    saveButton?.addEventListener('click', () => {
      void saveRules();
    });

    updateClock();
    window.setInterval(updateClock, 30000);
    void loadRules();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAccessRulesEditor, { once: true });
  } else {
    initAccessRulesEditor();
  }
</script>

<style>
  .access-rules-card {
    grid-column: 1 / -1;
  }

  .access-rules-subtitle {
    display: block;
    margin-top: 3px;
    color: #6d839b;
    font-size: 8px;
    font-weight: 500;
  }

  .access-rules-status {
    padding: 5px 7px;
    border-radius: 7px;
    background: rgba(31, 136, 242, .12);
    color: #7fc6ff;
    font: 700 8px/1 'Space Grotesk', sans-serif;
    white-space: nowrap;
  }

  .access-rules-status.is-saving {
    background: rgba(234, 177, 58, .12);
    color: #f1c76c;
  }

  .access-rules-status.is-saved {
    background: rgba(22, 163, 74, .14);
    color: #61dc8a;
  }

  .access-rules-status.is-error {
    max-width: 190px;
    background: rgba(220, 38, 38, .14);
    color: #ff8b8f;
    line-height: 1.3;
    white-space: normal;
    text-align: right;
  }

  .access-rule-editor {
    margin-top: 8px;
    padding: 10px;
    border: 1px solid rgba(114, 158, 203, .1);
    border-radius: 10px;
    background: rgba(255, 255, 255, .025);
  }

  .access-rule-editor-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .access-rule-editor-head > div {
    min-width: 0;
  }

  .access-rule-kicker {
    display: block;
    margin-bottom: 3px;
    color: #27bfff;
    font-size: 7px;
    font-weight: 800;
    letter-spacing: .14em;
  }

  .access-rule-editor-head strong {
    display: block;
    color: #e4eefb;
    font-size: 11px;
    font-weight: 700;
  }

  .access-rule-editor-head small {
    display: block;
    margin-top: 3px;
    color: #7188a1;
    font-size: 8.5px;
    line-height: 1.35;
  }

  .access-rule-priority-field {
    flex: 0 0 auto;
  }

  .access-rule-priority-field > span,
  .access-rule-window-row label > span {
    display: block;
    margin-bottom: 4px;
    color: #7188a1;
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
  }

  .access-rule-priority-field input,
  .access-rule-window-row input {
    width: 78px;
    box-sizing: border-box;
    border: 1px solid rgba(83, 168, 255, .18);
    border-radius: 7px;
    padding: 7px 8px;
    background: #0b1d31;
    color: #edf6ff;
    outline: none;
    font: 600 10px 'Space Grotesk', sans-serif;
  }

  .access-rule-window-row input {
    width: 100%;
    min-width: 90px;
  }

  .access-rule-priority-field input:focus,
  .access-rule-window-row input:focus {
    border-color: rgba(52, 160, 255, .62);
    box-shadow: 0 0 0 3px rgba(36, 145, 255, .1);
  }

  .access-rule-window-list {
    display: grid;
    gap: 6px;
    margin-top: 10px;
  }

  .access-rule-window-row {
    display: grid;
    grid-template-columns: 1fr 18px 1fr 30px;
    align-items: end;
    gap: 6px;
  }

  .access-rule-window-row label {
    min-width: 0;
  }

  .access-rule-arrow {
    padding-bottom: 8px;
    color: #7188a1;
    font-size: 11px;
    text-align: center;
  }

  .access-rule-remove {
    width: 30px;
    height: 31px;
    border: 1px solid rgba(255, 92, 98, .2);
    border-radius: 7px;
    background: rgba(108, 25, 34, .22);
    color: #ff7b7f;
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
  }

  .access-rule-remove:hover {
    background: rgba(140, 32, 43, .36);
  }

  .access-rule-add {
    width: 100%;
    margin-top: 8px;
    border: 1px dashed rgba(83, 168, 255, .22);
    border-radius: 8px;
    padding: 8px 10px;
    background: rgba(31, 136, 242, .06);
    color: #72beff;
    font-size: 9px;
    font-weight: 700;
    cursor: pointer;
  }

  .access-rule-add:hover {
    background: rgba(31, 136, 242, .12);
  }

  .access-rule-live {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 10px;
    margin-top: 8px;
    border: 1px solid rgba(83, 168, 255, .1);
    border-radius: 9px;
    background: rgba(255, 255, 255, .025);
  }

  .access-rule-live span {
    color: #7188a1;
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .access-rule-live strong {
    color: #cfe5fa;
    font: 600 10px 'Space Grotesk', sans-serif;
  }

  .access-rule-note {
    margin: 8px 1px 0;
    color: #627990;
    font-size: 8.5px;
    line-height: 1.45;
  }

  .access-rule-save {
    margin-top: 9px;
  }

  @media (max-width: 700px) {
    .access-rules-card {
      grid-column: auto;
    }

    .access-rule-editor-head {
      flex-direction: column;
    }

    .access-rule-priority-field input {
      width: 100%;
    }

    .access-rule-window-row {
      grid-template-columns: 1fr;
      gap: 5px;
    }

    .access-rule-arrow {
      display: none;
    }

    .access-rule-remove {
      width: 100%;
      height: 28px;
    }
  }
</style>
