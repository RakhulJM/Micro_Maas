---
---
<aside class="vendor-manager" id="vendorManager" aria-label="Campus vendors and orders">
<header class="vendor-manager-header"><div><span class="vendor-kicker">VENDORS · ORDERS</span><strong>Campus services</strong><small>Developer-controlled catalogue and live order list</small></div><span class="vendor-status" id="vendorManagerStatus">Loading</span></header>
<section class="vendor-section"><div class="vendor-section-head"><span>Vendor catalogue</span><button type="button" class="vendor-add-button" id="addVendor">+ Add vendor</button></div><div id="vendorList" class="vendor-list"></div></section>
<section class="vendor-section"><div class="vendor-section-head"><span>Orders</span><span class="vendor-order-count" id="vendorOrderCount">0</span></div><div id="vendorOrderList" class="vendor-order-list"></div></section>
</aside>
<div class="vendor-modal" id="vendorModal" hidden><div class="vendor-dialog">
<div class="vendor-dialog-head"><div><span class="vendor-kicker">VENDOR EDITOR</span><strong id="vendorModalTitle">Add vendor</strong></div><button type="button" class="vendor-close" id="closeVendorModal">×</button></div>
<div class="vendor-form-grid">
<label><span>Name</span><input id="vendorName" maxlength="60"></label><label><span>Order</span><input id="vendorOrder" type="number" min="1" step="1"></label>
<label class="vendor-full"><span>Vendor ID</span><input id="vendorId" maxlength="50" placeholder="food"></label>
<label class="vendor-toggle vendor-full"><span><strong>Enabled</strong><small>Visible on /user</small></span><input id="vendorEnabled" type="checkbox" checked></label>
</div>
<div class="vendor-options-head"><span>Options</span><button type="button" class="vendor-add-button" id="addVendorOption">+ Add option</button></div>
<div id="vendorOptionEditor" class="vendor-option-editor"></div>
<div class="vendor-dialog-actions"><button type="button" class="vendor-secondary" id="cancelVendor">Cancel</button><button type="button" class="vendor-danger" id="deleteVendor" hidden>Delete vendor</button><button type="button" class="vendor-primary" id="saveVendor">Save vendor</button></div>
</div></div>
<script>
const initVendorManager=()=>{
const vendorList=document.getElementById('vendorList'),orderList=document.getElementById('vendorOrderList'),orderCount=document.getElementById('vendorOrderCount'),status=document.getElementById('vendorManagerStatus'),modal=document.getElementById('vendorModal'),modalTitle=document.getElementById('vendorModalTitle'),nameInput=document.getElementById('vendorName'),orderInput=document.getElementById('vendorOrder'),idInput=document.getElementById('vendorId'),enabledInput=document.getElementById('vendorEnabled'),optionEditor=document.getElementById('vendorOptionEditor'),deleteButton=document.getElementById('deleteVendor');
let catalogue={version:1,vendors:[]},orders={version:1,orders:[]},editingVendorIndex=-1;
const esc=v=>String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const slug=v=>String(v||'').trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
const addOption=(option={})=>{const row=document.createElement('div');row.className='vendor-option-row';row.dataset.status=String(option.status||'online').toLowerCase();row.dataset.statusMessage=String(option.status_message||'');row.innerHTML=`<div class="vendor-option-main"><input class="vendor-option-name" value="${esc(option.name||'')}" maxlength="60" placeholder="Option name"><input class="vendor-option-id" value="${esc(option.id||'')}" maxlength="50" placeholder="option-id"></div><div class="vendor-option-meta"><label><span>Order</span><input class="vendor-option-order" type="number" min="1" value="${Number(option.order)||1}"></label><label><span>Service min</span><input class="vendor-option-service" type="number" min="0" value="${Number(option.service_minutes)||0}"></label><label><span>Price ₹</span><input class="vendor-option-price" type="number" min="0" step=".01" value="${Number(option.price)||0}"></label><label class="vendor-option-enabled"><span>Enabled</span><input class="vendor-option-enabled-input" type="checkbox" ${option.enabled!==false?'checked':''}></label><button type="button" class="vendor-remove-option">×</button></div>`;row.querySelector('.vendor-remove-option').onclick=()=>row.remove();optionEditor.appendChild(row)};
const collectOptions=()=>Array.from(optionEditor.querySelectorAll('.vendor-option-row')).map((row,i)=>({status:['online','busy','offline'].includes(row.dataset.status)?row.dataset.status:'online',status_message:row.dataset.statusMessage||'Accepting new orders',id:row.querySelector('.vendor-option-id').value.trim()||slug(row.querySelector('.vendor-option-name').value)||'option-'+(i+1),name:row.querySelector('.vendor-option-name').value.trim()||'Option '+(i+1),order:Math.max(1,Number(row.querySelector('.vendor-option-order').value)||i+1),enabled:row.querySelector('.vendor-option-enabled-input').checked,service_minutes:Math.max(0,Number(row.querySelector('.vendor-option-service').value)||0),price:Math.max(0,Number(row.querySelector('.vendor-option-price').value)||0)})).sort((a,b)=>a.order-b.order);
const renderCatalogue=()=>{
  const vs=[...catalogue.vendors].sort((a,b)=>Number(a.order)-Number(b.order));
  vendorList.innerHTML=vs.length?'':'<div class="vendor-empty">No vendors configured.</div>';
  vs.forEach(v=>{
    const opts=[...(v.options||[])].sort((a,b)=>Number(a.order)-Number(b.order));
    const basePath=v.id === 'food' ? '/vendor/food' : v.id === 'printer' ? '/vendor/print' : '/vendor';
    const optionMarkup=opts.map((o,i)=>{
      const optionPath=v.id === 'printer'
        ? String(o.id).replace(/^printer-/, '')
        : String(o.id);
      const optionLink=v.id === 'food' || v.id === 'printer'
        ? `<a class="vendor-option-open-link" href="${basePath}/${encodeURIComponent(optionPath)}" aria-label="Open ${esc(o.name)} dashboard" title="Open service dashboard">↗</a>`
        : '<span class="vendor-option-open-spacer" aria-hidden="true"></span>';
      return `<div class="vendor-option-item ${o.enabled===false?'is-disabled':''}"><span>${String(i+1).padStart(2,'0')}</span><strong>${esc(o.name)}</strong><small>${o.service_minutes||0} min · ₹${Number(o.price||0).toFixed(2)}</small>${optionLink}</div>`;
    }).join('');
    const card=document.createElement('article');
    card.className='vendor-card';
    card.innerHTML=`<div class="vendor-card-head"><div><span class="vendor-index">0${Number(v.order)||1}</span><strong>${esc(v.name)}</strong><small>${esc(v.id)} · ${v.enabled===false?'Disabled':'Enabled'}</small></div><div class="vendor-card-actions"><a class="vendor-open-link" href="${basePath}" aria-label="Open ${esc(v.name)} vendor page" title="Open vendor page">↗</a><button type="button" data-edit>⋯</button></div></div><div class="vendor-option-list">${optionMarkup}</div>`;
    card.querySelector('[data-edit]').onclick=()=>openEditor(catalogue.vendors.indexOf(v));
    vendorList.appendChild(card);
  });
};
const renderOrders=()=>{const list=[...orders.orders].sort((a,b)=>String(b.created_at).localeCompare(String(a.created_at)));orderCount.textContent=String(list.length);orderList.innerHTML=list.length?'':'<div class="vendor-empty">No orders yet.</div>';list.forEach(o=>{const row=document.createElement('div');row.className='vendor-order-row';row.innerHTML=`<div><strong>#${esc(o.id)}</strong><span>${esc(o.vendor_name)} · ${esc(o.option_name)} · Qty ${Number(o.quantity)||1}</span><small>${new Date(o.created_at).toLocaleString('en-IN',{hour:'2-digit',minute:'2-digit',day:'2-digit',month:'short'})}</small></div><label class="vendor-order-status"><span>Status</span><select data-status>${['placed','accepted','preparing','ready','completed','cancelled'].map(s=>`<option value="${s}" ${o.status===s?'selected':''}>${s}</option>`).join('')}</select></label>`;row.querySelector('[data-status]').onchange=e=>updateOrder(o.id,e.target.value);orderList.appendChild(row)})};
const load=async()=>{try{const [a,b]=await Promise.all([fetch('/maps/campus_vendors.json',{cache:'no-store'}),fetch('/maps/campus_orders.json',{cache:'no-store'})]);if(!a.ok||!b.ok)throw 0;catalogue=await a.json();orders=await b.json();renderCatalogue();renderOrders();status.textContent='Ready'}catch{status.textContent='Offline';vendorList.innerHTML='<div class="vendor-empty">Vendor configuration could not be loaded.</div>';orderList.innerHTML='<div class="vendor-empty">Orders could not be loaded.</div>'}};
const saveCatalogue=async()=>{status.textContent='Saving…';const r=await fetch('/__campusmaas/save-vendors',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(catalogue)});if(!r.ok)throw Error('Vendor save failed.');status.textContent='Saved';renderCatalogue()};
const openEditor=index=>{editingVendorIndex=index;const v=index>=0?catalogue.vendors[index]:null;modalTitle.textContent=v?'Edit vendor':'Add vendor';nameInput.value=v?.name||'';orderInput.value=v?.order||catalogue.vendors.length+1;idInput.value=v?.id||'';enabledInput.checked=v?.enabled!==false;optionEditor.innerHTML='';(v?.options||[]).sort((a,b)=>Number(a.order)-Number(b.order)).forEach(addOption);deleteButton.hidden=!v;modal.hidden=false;setTimeout(()=>nameInput.focus(),0)};
const closeEditor=()=>modal.hidden=true;
const saveEditor=async()=>{const name=nameInput.value.trim(),id=idInput.value.trim()||slug(name);if(!name||!id)return;const v={id,name,order:Math.max(1,Number(orderInput.value)||catalogue.vendors.length+1),enabled:enabledInput.checked,options:collectOptions()};if(editingVendorIndex>=0)catalogue.vendors[editingVendorIndex]=v;else catalogue.vendors.push(v);try{await saveCatalogue();closeEditor()}catch(e){status.textContent=e.message}};
const updateOrder=async(id,value)=>{status.textContent='Saving order…';const r=await fetch('/__campusmaas/update-order',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,status:value})});if(!r.ok){status.textContent='Order update failed';return}orders.orders=orders.orders.map(o=>o.id===id?{...o,status:value}:o);renderOrders();status.textContent='Ready'};
document.getElementById('addVendor').onclick=()=>openEditor(-1);document.getElementById('addVendorOption').onclick=()=>addOption();document.getElementById('saveVendor').onclick=saveEditor;document.getElementById('cancelVendor').onclick=closeEditor;document.getElementById('closeVendorModal').onclick=closeEditor;document.getElementById('deleteVendor').onclick=async()=>{if(editingVendorIndex<0)return;catalogue.vendors.splice(editingVendorIndex,1);try{await saveCatalogue();closeEditor()}catch(e){status.textContent=e.message}};modal.onclick=e=>{if(e.target===modal)closeEditor()};load()
};initVendorManager();
</script>
<style is:global>
.vendor-manager{position:absolute;z-index:1900;right:14px;top:58px;width:min(470px,calc(100vw - 28px));max-height:min(80vh,760px);overflow:auto;padding:14px;border:1px solid rgba(83,168,255,.18);border-radius:17px;background:linear-gradient(180deg,rgba(8,20,35,.98),rgba(6,17,29,.96));color:#e8eef8;box-shadow:0 22px 60px rgba(0,0,0,.32);backdrop-filter:blur(16px)}
.vendor-manager-header,.vendor-section-head,.vendor-card-head,.vendor-dialog-head,.vendor-options-head,.vendor-dialog-actions{display:flex;align-items:center;justify-content:space-between;gap:10px}
.vendor-card-actions{display:flex;align-items:center;gap:5px}.vendor-open-link{display:grid;place-items:center;width:28px;height:28px;border:1px solid rgba(83,168,255,.12);border-radius:7px;background:#0d2742;color:#67c6ff;text-decoration:none;font-size:14px}.vendor-open-link:hover{background:#123757;color:#dff3ff}.vendor-option-open-link{display:inline-block;margin-left:6px;color:#67c6ff;text-decoration:none;font-weight:800}
.vendor-manager-header{padding:2px 2px 12px;border-bottom:1px solid rgba(117,162,206,.12)}.vendor-manager-header strong{display:block;margin-top:4px;font:600 16px/1 'Space Grotesk',sans-serif}.vendor-manager-header small{display:block;margin-top:3px;color:#71849a;font-size:9px}
.vendor-kicker,.vendor-section-head>span:first-child{color:#67c6ff;font-size:8px;font-weight:800;letter-spacing:.14em}.vendor-status,.vendor-order-count{color:#7e93aa;font-size:9px}.vendor-section{margin-top:11px}.vendor-section-head{margin-bottom:7px}
.vendor-add-button,.vendor-primary,.vendor-secondary,.vendor-danger{border:1px solid rgba(83,168,255,.2);border-radius:8px;padding:6px 9px;background:#0d2742;color:#bfe8ff;font:600 9px 'DM Sans',sans-serif;cursor:pointer}.vendor-primary{background:#1687ff;border-color:#1687ff;color:#fff}.vendor-danger{color:#ff8f97;border-color:rgba(255,91,99,.2);background:rgba(255,91,99,.07)}.vendor-secondary{color:#aab9ca;background:#0d1d30;border-color:rgba(148,163,184,.13)}
.vendor-list,.vendor-order-list{display:grid;gap:8px}.vendor-card,.vendor-order-row{border:1px solid rgba(83,168,255,.09);border-radius:12px;background:rgba(12,29,48,.72);padding:10px}.vendor-index{display:inline-grid;place-items:center;width:22px;height:22px;margin-right:7px;border-radius:6px;background:#0d2742;color:#67c6ff;font-size:8px;vertical-align:middle}.vendor-card-head strong{color:#eef7ff;font:600 12px/1 'Space Grotesk',sans-serif}.vendor-card-head small{display:block;margin:3px 0 0 30px;color:#71849a;font-size:8px}.vendor-card-head>button,.vendor-close{width:28px;height:28px;border:1px solid rgba(148,163,184,.12);border-radius:7px;background:#0e2339;color:#9fb1c5;cursor:pointer;font-size:16px}
.vendor-option-list{display:grid;gap:4px;margin-top:8px;padding-left:29px}.vendor-option-item{display:grid;grid-template-columns:24px minmax(0,1fr) minmax(95px,auto) 28px;gap:8px;align-items:center;padding:8px 9px;border:1px solid rgba(83,168,255,.05);border-radius:8px;background:rgba(255,255,255,.026)}.vendor-option-item>span:first-child{color:#63819e;font-size:8px}.vendor-option-item strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:9px;font-weight:650}.vendor-option-item small{color:#74899f;font-size:8px;white-space:nowrap}.vendor-option-open-link,.vendor-option-open-spacer{display:grid;place-items:center;width:26px;height:26px;border-radius:7px}.vendor-option-open-link{border:1px solid rgba(83,168,255,.14);background:#0d2742;color:#67c6ff;text-decoration:none;font-size:13px}.vendor-option-open-link:hover{background:#123757;color:#dff3ff}.vendor-option-open-spacer{visibility:hidden}.vendor-option-item.is-disabled{opacity:.42}.vendor-empty{padding:14px;border:1px dashed rgba(148,163,184,.13);border-radius:10px;color:#6f8398;font-size:9px;text-align:center}
.vendor-order-row{display:grid;grid-template-columns:1fr 116px;gap:12px;align-items:center}.vendor-order-row>div>*{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.vendor-order-row strong{color:#e6f3ff;font-size:10px}.vendor-order-row span{margin-top:2px;color:#9fb1c5;font-size:9px}.vendor-order-row small{margin-top:3px;color:#62788f;font-size:8px}.vendor-order-status span{display:block;margin-bottom:4px;color:#657c94;font-size:7px;text-transform:uppercase;letter-spacing:.08em}.vendor-order-status select{width:100%;padding:7px 6px;border:1px solid rgba(83,168,255,.13);border-radius:8px;background:#0d2035;color:#dbe9f8;font-size:8px}
.vendor-modal{position:absolute;inset:0;z-index:3200;display:flex;align-items:flex-start;justify-content:center;padding:72px 16px 16px;background:rgba(4,10,18,.28);backdrop-filter:blur(5px)}.vendor-modal[hidden]{display:none}.vendor-dialog{width:min(680px,100%);max-height:calc(100vh - 90px);overflow:auto;padding:16px;border:1px solid rgba(83,168,255,.18);border-radius:17px;background:#081423;color:#e8eef8;box-shadow:0 24px 90px rgba(0,0,0,.42)}.vendor-dialog-head strong{display:block;margin-top:2px;font:600 14px 'Space Grotesk',sans-serif}
.vendor-form-grid{display:grid;grid-template-columns:1fr 110px;gap:8px;margin-top:12px}.vendor-form-grid label,.vendor-option-main,.vendor-option-meta label{display:grid;gap:4px}.vendor-form-grid label>span,.vendor-option-meta label>span{color:#70869e;font-size:8px}.vendor-form-grid input,.vendor-option-main input,.vendor-option-meta input{width:100%;box-sizing:border-box;padding:7px 8px;border:1px solid rgba(148,163,184,.14);border-radius:7px;background:#0d1f33;color:#e8eef8;outline:none;font:inherit;font-size:9px}.vendor-full{grid-column:1/-1}.vendor-toggle{display:flex!important;align-items:center;justify-content:space-between}.vendor-toggle strong,.vendor-toggle small{display:block}.vendor-toggle small{color:#657a91;font-size:7px}.vendor-options-head{margin:13px 0 7px;color:#b4c7d9;font-size:9px;font-weight:700}.vendor-option-editor{display:grid;gap:6px}.vendor-option-row{padding:8px;border:1px solid rgba(148,163,184,.1);border-radius:9px;background:rgba(12,29,48,.72)}.vendor-option-main{grid-template-columns:1fr 150px}.vendor-option-meta{display:grid;grid-template-columns:70px 85px 80px 1fr 28px;gap:7px;align-items:end;margin-top:6px}.vendor-option-enabled{display:flex!important;align-items:center;justify-content:space-between}.vendor-remove-option{width:28px;height:28px;border:1px solid rgba(255,91,99,.15);border-radius:7px;background:rgba(255,91,99,.05);color:#ff8f97;cursor:pointer}
.vendor-dialog-actions{margin-top:12px}@media(max-width:760px){.vendor-manager{top:50px;right:10px;max-height:56vh}.vendor-form-grid{grid-template-columns:1fr}.vendor-full{grid-column:auto}.vendor-option-main,.vendor-option-meta{grid-template-columns:1fr}}
</style>