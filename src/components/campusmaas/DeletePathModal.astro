---

<section class="delete-point-modal" id="deletePathModal" aria-hidden="true">
  <div class="delete-point-dialog" role="dialog" aria-modal="true" aria-labelledby="deletePathTitle">
    <div class="delete-point-header">
      <div>
        <span class="delete-point-kicker">DELETE PATH</span>
        <strong id="deletePathTitle">What should be removed?</strong>
      </div>
      <button type="button" class="route-card-close" id="deletePathCancel" aria-label="Cancel delete">×</button>
    </div>
    <div class="delete-point-options">
      <button type="button" class="delete-point-option" id="deletePathEntire">
        <strong>Delete entire path</strong>
        <span>Remove the complete selected pedestrian path.</span>
      </button>
      <button type="button" class="delete-point-option" id="deletePathSegment">
        <strong>Delete selected segment</strong>
        <span>Remove only the selected point-to-point section.</span>
      </button>
    </div>
  </div>
</section>
