---
---

<section class="route-card" id="routeCard" aria-live="polite" aria-hidden="true">
  <div class="route-card-top">
    <div>
      <span class="route-card-kicker">WALKING TEST</span>
      <strong id="routeStatus">Select a start point</strong>
    </div>
    <button type="button" class="route-card-close" id="routeClear" aria-label="Clear route">×</button>
  </div>
  <div class="route-result" id="routeResult">
    <span>Distance</span>
    <strong id="routeDistance">—</strong>
    <span>Time</span>
    <strong id="routeTime">—</strong>
  </div>
</section>
