---
const { pageKind = 'root', vendorId = '', optionId = '', initialData = null } = Astro.props;
---

<main class="vendor-portal" data-page-kind={pageKind} data-vendor-id={vendorId} data-option-id={optionId}>
  <script type="application/json" id="vendorPortalInitialData" set:html={JSON.stringify(initialData || { catalogue: { version: 1, vendors: [] }, orders: { version: 1, orders: [] }, pageCards: { version: 1, root: {}, categories: {} } })}></script>
  <div class="vendor-portal-glow vendor-portal-glow-a" aria-hidden="true"></div>
  <div class="vendor-portal-glow vendor-portal-glow-b" aria-hidden="true"></div>

  <header class="vendor-portal-header">
    <div class="vendor-brand">
      <a class="vendor-back" id="vendorBack" href="/vendor" aria-label="Back to vendors">←</a>
      <div class="vendor-brand-mark">M</div>
      <div>
        <span class="vendor-brand-kicker">CAMPUSMAAS</span>
        <strong id="portalHeaderTitle">Vendors</strong>
      </div>
    </div>
    <div class="vendor-header-actions">
      <button class="vendor-print-queue-button" id="vendorPrintQueueButton" type="button" hidden aria-label="Open Order's" title="Order's">
        <span class="vendor-print-queue-icon" aria-hidden="true">🖨</span>
        <span>Order's</span>
      </button>
      <div class="vendor-header-service-control" id="vendorHeaderServiceControl" hidden>
        <div class="vendor-header-status-toggle" id="vendorHeaderStatusToggle" role="group" aria-label="Service status">
          <button type="button" class="vendor-header-status-choice status-online" data-status="online">Online</button>
          <button type="button" class="vendor-header-status-choice status-busy" data-status="busy">Busy</button>
          <button type="button" class="vendor-header-status-choice status-offline" data-status="offline">Offline</button>
        </div>
        <span class="vendor-header-status-message" id="vendorHeaderStatusMessage">Accepting new orders</span>
      </div>
      <div class="vendor-header-status">
        <span class="vendor-live-dot"></span>
        <span>Live workspace</span>
      </div>
    </div>
  </header>

  <section class="vendor-hero">
    <span class="vendor-hero-kicker" id="portalKicker">CAMPUS SERVICES</span>
    <h1 id="portalTitle">Vendors</h1>
    <p id="portalSubtitle">Campus service dashboards</p>
  </section>

  <aside class="vendor-print-queue" id="vendorPrintQueue" hidden aria-hidden="true">
    <div class="vendor-print-queue-backdrop" id="vendorPrintQueueBackdrop"></div>
    <section class="vendor-print-queue-dialog" role="dialog" aria-modal="true" aria-labelledby="vendorPrintQueueTitle">
      <header class="vendor-print-queue-header">
        <div>
          <span class="vendor-print-queue-kicker">ORDERS</span>
          <strong id="vendorPrintQueueTitle">Print orders</strong>
          <small id="vendorPrintQueueSummary">0 active orders</small>
        </div>
        <div class="vendor-print-queue-header-actions">
          <button type="button" class="vendor-print-queue-all" id="vendorPrintQueueAll" disabled>Print all</button>
          <button type="button" class="vendor-print-queue-close" id="vendorPrintQueueClose" aria-label="Close print queue">×</button>
        </div>
      </header>
      <div class="vendor-print-queue-list" id="vendorPrintQueueList"></div>
      <footer class="vendor-print-queue-footer">
        <span id="vendorPrintQueueFooterText">Orders are grouped by customer.</span>
      </footer>
    </section>
  </aside>

  <section class="vendor-content" aria-live="polite">
    <div id="portalContent" class="vendor-content-grid">
      <div class="vendor-loading-card">
        <span class="vendor-loading-line wide"></span>
        <span class="vendor-loading-line"></span>
        <span class="vendor-loading-line short"></span>
      </div>
    </div>
  </section>
</main>

<script>
  const initVendorPortal = () => {
    const root = document.querySelector('.vendor-portal');
    const content = document.getElementById('portalContent');
    const title = document.getElementById('portalTitle');
    const headerTitle = document.getElementById('portalHeaderTitle');
    const subtitle = document.getElementById('portalSubtitle');
    const kicker = document.getElementById('portalKicker');
    const back = document.getElementById('vendorBack');
    const headerServiceControl = document.getElementById('vendorHeaderServiceControl');
    const headerStatusToggle = document.getElementById('vendorHeaderStatusToggle');
    const headerStatusMessage = document.getElementById('vendorHeaderStatusMessage');
    const headerStatusChoices = Array.from(document.querySelectorAll('.vendor-header-status-choice'));
    const printQueueButton = document.getElementById('vendorPrintQueueButton');
    const printQueue = document.getElementById('vendorPrintQueue');
    const printQueueBackdrop = document.getElementById('vendorPrintQueueBackdrop');
    const printQueueClose = document.getElementById('vendorPrintQueueClose');
    const printQueueList = document.getElementById('vendorPrintQueueList');
    const printQueueSummary = document.getElementById('vendorPrintQueueSummary');
    const printQueueAll = document.getElementById('vendorPrintQueueAll');
    const printQueueFooterText = document.getElementById('vendorPrintQueueFooterText');

    if (!root || !content) return;

    const pageKind = root.dataset.pageKind || 'root';
    const vendorId = root.dataset.vendorId || '';
    const optionId = root.dataset.optionId || '';

    const state = {
      catalogue: { version: 1, vendors: [] },
      orders: { version: 1, orders: [] },
      pageCards: { version: 1, root: {}, categories: {} }
    };
    let ordersVendorId = '';
    let ordersVendorName = '';
    let ordersOptionId = '';

    const create = (tag, className, text) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    };

    const append = (parent, ...children) => {
      children.forEach((child) => child && parent.appendChild(child));
      return parent;
    };

    const vendor = (id) =>
      state.catalogue.vendors.find((item) => String(item.id) === String(id));

    const option = (item, id) =>
      item && item.options
        ? item.options.find((child) => String(child.id) === String(id))
        : null;

    const routeParent = (parentId) =>
      String(parentId) === 'printer' ? 'print' : String(parentId);

    const route = (parentId, childId) => {
      const parent = routeParent(parentId);
      const child = String(parentId) === 'printer'
        ? String(childId || '').replace(/^printer-/, '')
        : String(childId || '');
      return child
        ? '/vendor/' + encodeURIComponent(parent) + '/' + encodeURIComponent(child)
        : '/vendor/' + encodeURIComponent(parent);
    };

    const iconLetter = (id) =>
      String(id).toLowerCase() === 'food' ? 'F' :
      String(id).toLowerCase() === 'printer' ? 'P' : 'S';

    const formatPrice = (value) => {
      const price = Number(value) || 0;
      return price === 0 ? 'Free' : '₹' + price.toFixed(2);
    };

    const orderStatusClass = (value) =>
      'vendor-status-chip status-' +
      String(value || 'placed').replace(/[^a-z]/gi, '').toLowerCase();

    const orderStatusLabel = (value) =>
      String(value || 'placed')
        .replace(/_/g, ' ')
        .replace(/^./, (char) => char.toUpperCase());

    const makeHeader = (small, heading, parent) => {
      const wrapper = create('div', 'vendor-section-heading');
      const left = create('div');
      append(left, create('span', '', small), create('strong', '', heading));
      append(wrapper, left, create('b', '', parent));
      return wrapper;
    };

    const loadData = async () => {
      let catalogue = null;
      let orders = null;
      let pageCards = null;

      try {
        const embedded = JSON.parse(
          document.getElementById('vendorPortalInitialData')?.textContent || '{}'
        );
        catalogue = embedded?.catalogue;
        orders = embedded?.orders;
        pageCards = embedded?.pageCards;
      } catch {
        // Embedded route data will be validated below.
      }

      const valid = (nextCatalogue, nextOrders) =>
        nextCatalogue?.version === 1 &&
        Array.isArray(nextCatalogue?.vendors) &&
        nextOrders?.version === 1 &&
        Array.isArray(nextOrders?.orders);

      if (!valid(catalogue, orders)) {
        throw new Error('Vendor data could not be loaded.');
      }

      state.catalogue = catalogue;
      state.orders = orders;
      state.pageCards = pageCards?.version === 1 ? pageCards : { version: 1, root: {}, categories: {} };

      // Refresh when the public JSON files are available, but never blank the page
      // when a dev-server/static-file refresh is unavailable.
      try {
        const responses = await Promise.all([
          fetch('/maps/campus_vendors.json', { cache: 'no-store' }),
          fetch('/maps/campus_orders.json', { cache: 'no-store' })
        ]);

        if (responses[0].ok && responses[1].ok) {
          const refreshed = await Promise.all([
            responses[0].json(),
            responses[1].json()
          ]);

          if (valid(refreshed[0], refreshed[1])) {
            state.catalogue = refreshed[0];
            state.orders = refreshed[1];
          }
        }
      } catch {
        // Keep the working route snapshot.
      }
    };

    const vendorOrders = (id, optionId = '', requireFiles = false) =>
      state.orders.orders.filter((order) => {
        if (String(order.vendor_id) !== String(id)) return false;
        if (optionId && String(order.option_id) !== String(optionId)) return false;
        const status = String(order.status || '').toLowerCase();
        if (!['placed', 'accepted', 'preparing'].includes(status)) return false;
        return !requireFiles || (Array.isArray(order.files) && order.files.length);
      });

    const scopedOrders = (id, requireFiles = false) =>
      vendorOrders(id, ordersOptionId, requireFiles);

    const orderButtonLevels = ['order-level-idle', 'order-level-green', 'order-level-blue', 'order-level-yellow', 'order-level-orange', 'order-level-red', 'order-level-critical'];

    const updateOrdersButton = () => {
      if (!ordersVendorId) {
        printQueueButton.hidden = true;
        return;
      }

      const count = scopedOrders(ordersVendorId).length;
      const level =
        count <= 0 ? 'order-level-idle' :
        count === 1 ? 'order-level-green' :
        count === 2 ? 'order-level-blue' :
        count === 3 ? 'order-level-yellow' :
        count === 4 ? 'order-level-orange' :
        count === 5 ? 'order-level-red' :
        'order-level-critical';

      printQueueButton.classList.remove(...orderButtonLevels);
      printQueueButton.classList.add(level);
      printQueueButton.dataset.orderCount = String(count);

      const label = count === 1 ? '1 active order' : count + ' active orders';
      printQueueButton.setAttribute('aria-label', "Open Order's · " + label);
      printQueueButton.setAttribute('title', "Order's · " + label);
    };

    const printableOrders = () => scopedOrders('printer', true);

    const printGroupKey = (file) =>
      String(file?.color || 'bw').toLowerCase() + '-' +
      String(file?.sides || 'single').toLowerCase();

    const printGroupLabel = (key) => {
      const [color, sides] = String(key).split('-');
      const colourLabel = color === 'color' ? 'Colour' : 'Black & White';
      const sidesLabel = sides === 'double' ? 'Both sides' : 'One side';
      return colourLabel + ' · ' + sidesLabel;
    };

    const openPrintFile = (order, file, index) => {
      const url =
        '/__campusmaas/print-file?order_id=' +
        encodeURIComponent(order.id) +
        '&file_index=' +
        encodeURIComponent(String(index));
      window.open(url, '_blank', 'noopener,noreferrer');
    };

    const openPrintBatch = (order, entries, label) => {
      const indexes = entries.map((entry) => String(entry.index)).join(',');
      const url =
        '/__campusmaas/print-batch?order_id=' +
        encodeURIComponent(order.id) +
        '&indexes=' +
        encodeURIComponent(indexes) +
        '&label=' +
        encodeURIComponent(label);
      window.open(url, '_blank', 'noopener,noreferrer');
    };

    const renderVendorOrderList = () => {
      const isPrinter = String(ordersVendorId) === 'printer';
      if (isPrinter) {
        renderPrintQueue();
        return;
      }

      const orders = scopedOrders(ordersVendorId);
      printQueueList.innerHTML = '';
      printQueueSummary.textContent =
        orders.length + (orders.length === 1 ? ' active order' : ' active orders');

      printQueueAll.hidden = true;

      if (!orders.length) {
        printQueueList.appendChild(
          create('div', 'vendor-empty-card', 'No active orders for ' + (ordersVendorName || 'this vendor') + '.')
        );
        printQueueFooterText.textContent = 'New orders for this vendor will appear here automatically.';
        return;
      }

      const grouped = new Map();
      orders.forEach((order) => {
        const key = String(order.option_name || 'Service');
        if (!grouped.has(key)) grouped.set(key, []);
        grouped.get(key).push(order);
      });

      let totalQuantity = 0;

      grouped.forEach((serviceOrders, serviceName) => {
        const serviceSection = create('section', 'vendor-print-order-section');
        const serviceHeader = create('header', 'vendor-print-order-header');
        const heading = create('div');

        append(
          heading,
          create('span', 'vendor-print-order-kicker', ordersVendorName.toUpperCase()),
          create('strong', '', serviceName),
          create('small', '', serviceOrders.length + (serviceOrders.length === 1 ? ' active order' : ' active orders'))
        );

        append(serviceHeader, heading);
        serviceSection.appendChild(serviceHeader);

        const list = create('div', 'vendor-orders-grid');
        serviceOrders.forEach((order) => {
          totalQuantity += Number(order.quantity) || 1;
          const service = option(vendor(ordersVendorId), order.option_id);
          const status = String(service?.status || 'online').toLowerCase();
          list.appendChild(
            String(ordersVendorId) === 'food'
              ? makeFoodOrderCard(order, status)
              : makeOrderCard(order, status)
          );
        });

        serviceSection.appendChild(list);
        printQueueList.appendChild(serviceSection);
      });

      printQueueFooterText.textContent =
        orders.length + (orders.length === 1 ? ' order · ' : ' orders · ') +
        totalQuantity + (totalQuantity === 1 ? ' item' : ' items') +
        ' waiting.';
    };

    const renderPrintQueue = () => {
      const orders = printableOrders();
      printQueueAll.hidden = false;

      printQueueList.innerHTML = '';
      printQueueSummary.textContent =
        orders.length + (orders.length === 1 ? ' active order' : ' active orders');

      const enabled = orders.length > 0;
      printQueueAll.disabled = !enabled;

      if (!orders.length) {
        printQueueList.appendChild(
          create('div', 'vendor-empty-card', 'No active print orders for this service.')
        );
        printQueueFooterText.textContent = 'New print orders for this service will appear here automatically.';
        return;
      }

      let totalFiles = 0;
      let totalCopies = 0;

      orders.forEach((order) => {
        const files = Array.isArray(order.files) ? order.files : [];
        totalFiles += files.length;
        totalCopies += files.reduce((sum, file) => sum + (Number(file.copies) || 1), 0);

        const orderCard = create('section', 'vendor-print-order-section');
        const orderHeader = create('header', 'vendor-print-order-header');

        const orderHeading = create('div');
        append(
          orderHeading,
          create('span', 'vendor-print-order-kicker', '#' + order.id),
          create('strong', '', String(order.option_name || 'Print service')),
          create('small', '', String(order.status || 'placed').replace(/^./, (char) => char.toUpperCase()) + ' · ' +
            new Date(order.created_at).toLocaleString('en-IN', {
              hour: '2-digit',
              minute: '2-digit',
              day: '2-digit',
              month: 'short'
            }))
        );

        const orderPrint = create('button', 'vendor-print-order-all', 'PRINT THIS ORDER');
        orderPrint.type = 'button';

        const orderEntries = files.map((file, index) => ({ file, index }));
        orderPrint.addEventListener('click', () => {
          openPrintBatch(order, orderEntries, 'Order #' + order.id);
        });

        append(orderHeader, orderHeading, orderPrint);
        orderCard.appendChild(orderHeader);

        const groups = new Map();
        orderEntries.forEach((entry) => {
          const key = printGroupKey(entry.file);
          if (!groups.has(key)) groups.set(key, []);
          groups.get(key).push(entry);
        });

        const showGroupHeadings = groups.size > 1;

        groups.forEach((entries, key) => {
          if (showGroupHeadings) {
            const groupHeader = create('div', 'vendor-print-group-header');
            append(
              groupHeader,
              create('strong', '', printGroupLabel(key))
            );
            const groupPrint = create('button', 'vendor-print-group-all', 'PRINT ALL');
            groupPrint.type = 'button';
            groupPrint.addEventListener('click', () => {
              openPrintBatch(order, entries, printGroupLabel(key));
            });
            groupHeader.appendChild(groupPrint);
            orderCard.appendChild(groupHeader);
          } else {
            const groupTools = create('div', 'vendor-print-group-tools');
            const groupPrint = create('button', 'vendor-print-group-all', 'PRINT ALL');
            groupPrint.type = 'button';
            groupPrint.addEventListener('click', () => {
              openPrintBatch(order, entries, printGroupLabel(key));
            });
            groupTools.appendChild(groupPrint);
            orderCard.appendChild(groupTools);
          }

          entries.forEach(({ file, index }) => {
            const fileCard = create('article', 'vendor-print-file-card');

            const fileMain = create('div', 'vendor-print-file-main');
            append(
              fileMain,
              create('strong', '', file.name || ('File ' + (index + 1))),
              create('span', '', (file.type || 'Unknown file') + ' · ' +
                (Number(file.copies) || 1) + ((Number(file.copies) || 1) === 1 ? ' copy' : ' copies'))
            );

            const fileSettings = create('div', 'vendor-print-file-settings');
            append(
              fileSettings,
              create('span', '', file.color === 'color' ? 'COLOUR' : 'B&W'),
              create('span', '', file.sides === 'double' ? 'BOTH SIDES' : 'ONE SIDE')
            );

            const filePrint = create('button', 'vendor-print-file-button', 'PRINT');
            filePrint.type = 'button';
            filePrint.addEventListener('click', () => openPrintFile(order, file, index));

            append(fileCard, fileMain, fileSettings, filePrint);
            orderCard.appendChild(fileCard);
          });
        });

        printQueueList.appendChild(orderCard);
      });

      printQueueFooterText.textContent =
        totalFiles + (totalFiles === 1 ? ' file · ' : ' files · ') +
        totalCopies + (totalCopies === 1 ? ' copy' : ' copies') +
        ' waiting to print.';
    };

    const openPrintQueue = () => {
      const scopeName = ordersOptionId
        ? String(option(vendor(ordersVendorId), ordersOptionId)?.name || ordersVendorName)
        : ordersVendorName;
      printQueue.querySelector('.vendor-print-queue-kicker').textContent = scopeName.toUpperCase() + ' ORDERS';
      document.getElementById('vendorPrintQueueTitle').textContent = scopeName + ' orders';
      renderVendorOrderList();
      printQueue.hidden = false;
      printQueue.setAttribute('aria-hidden', 'false');
      document.body.classList.add('vendor-print-queue-open');
    };

    const closePrintQueue = () => {
      printQueue.hidden = true;
      printQueue.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('vendor-print-queue-open');
    };

    const renderRoot = () => {
      const vendors = state.catalogue.vendors
        .filter((item) => item.enabled !== false)
        .sort((a, b) => Number(a.order) - Number(b.order));

      kicker.textContent = 'VENDORS';
      title.textContent = 'Campus vendors';
      headerTitle.textContent = 'Vendors';
      subtitle.textContent = 'Choose a service workspace';
      back.href = '/';
      back.setAttribute('aria-label', 'Back to map');
      headerServiceControl.hidden = true;
      printQueueButton.hidden = true;
      ordersVendorId = '';
      ordersVendorName = '';
      ordersOptionId = '';
      closePrintQueue();

      content.className = 'vendor-content-grid vendor-root-grid';
      content.innerHTML = '';

      vendors.forEach((item) => {
        const card = create('a', 'vendor-large-card');
        card.href = route(item.id);

        const cardData = state.pageCards.root[String(item.id)] || {};
        const top = create('div', 'vendor-large-card-top');
        append(
          top,
          create('span', 'vendor-card-number', String(cardData.number || item.order || 1).padStart(2, '0')),
          create('span', 'vendor-open-icon', '↗')
        );

        const largeIcon = create('div', 'vendor-large-icon', cardData.icon || iconLetter(item.id));

        const visibleOptions = (item.options || [])
          .filter((child) => child.enabled !== false);

        const activeOrders = state.orders.orders.filter(
          (order) =>
            String(order.vendor_id) === String(item.id) &&
            !['completed', 'cancelled'].includes(order.status)
        ).length;

        append(
          card,
          top,
          largeIcon,
          create('div', 'vendor-large-title', cardData.title || item.name),
          create('p', '', visibleOptions.length + (visibleOptions.length === 1 ? ' service available' : ' services available'))
        );

        const footer = create('div', 'vendor-large-footer');
        append(
          footer,
          create('span', '', activeOrders + (activeOrders === 1 ? ' active order' : ' active orders')),
          create('span', '', cardData.action || 'Open dashboard →')
        );
        append(card, footer);
        content.appendChild(card);
      });

      if (!vendors.length) {
        content.appendChild(create('div', 'vendor-empty-card', 'No enabled vendors are configured.'));
      }
    };

    const renderCategory = (item) => {
      const pageData = state.pageCards.categories[String(item.id)] || {};
      const options = (item.options || [])
        .filter((child) => child.enabled !== false)
        .sort((a, b) => Number(a.order) - Number(b.order));

      kicker.textContent = 'VENDOR';
      title.textContent = pageData.title || item.name;
      headerTitle.textContent = pageData.title || item.name;
      subtitle.textContent = pageData.subtitle || 'Service list and dedicated dashboards';
      back.href = '/vendor';
      headerServiceControl.hidden = true;
      ordersVendorId = '';
      ordersVendorName = '';
      ordersOptionId = '';
      printQueueButton.hidden = true;

      content.className = 'vendor-content-grid vendor-category-grid';
      content.innerHTML = '';

      options.forEach((child) => {
        const serviceData = pageData.services?.[String(child.id)] || {};
        const card = create('a', 'vendor-service-card');
        card.href = route(item.id, child.id);

        const top = create('div', 'vendor-service-card-head');
        append(
          top,
          create('div', 'vendor-service-icon', iconLetter(item.id)),
          create('span', 'vendor-open-icon', '↗')
        );

        const activeOrders = state.orders.orders.filter(
          (order) =>
            String(order.vendor_id) === String(item.id) &&
            String(order.option_id) === String(child.id) &&
            !['completed', 'cancelled'].includes(order.status)
        ).length;

        append(
          card,
          top,
          create('div', 'vendor-service-number', String(serviceData.number || child.order || 1).padStart(2, '0')),
          create('h2', '', serviceData.title || child.name),
          create('p', '', serviceData.description || 'Dedicated vendor dashboard')
        );

        const serviceStatus = String(child.status || 'online').toLowerCase();
        const statusLabel = serviceStatus === 'offline' ? 'OFFLINE' : serviceStatus === 'busy' ? 'BUSY' : 'ONLINE';
        const statusText = child.status_message || (
          serviceStatus === 'offline' ? 'Currently unavailable' :
          serviceStatus === 'busy' ? 'Currently serving customers' : 'Accepting new orders'
        );
        const statusBadge = create('div', 'vendor-service-status status-' + serviceStatus);
        append(statusBadge, create('span', 'vendor-service-status-dot'), create('strong', statusLabel), create('small', '', statusText));
        const info = create('div', 'vendor-service-info');
        card.appendChild(statusBadge);
        append(
          info,
          create('span', '', (Number(child.service_minutes) || 0) + ' min service'),
          create('span', '', formatPrice(child.price))
        );
        append(card, info);

        const footer = create('div', 'vendor-large-footer');
        append(
          footer,
          create('span', '', activeOrders + (activeOrders === 1 ? ' active order' : ' active orders')),
          create('span', '', 'Open dashboard →')
        );
        append(card, footer);
        content.appendChild(card);
      });

      if (!options.length) {
        content.appendChild(create('div', 'vendor-empty-card', 'No enabled services are configured.'));
      }
    };

    const makeOrderCard = (order, currentServiceStatus = 'online') => {
      const card = create('article', 'vendor-order-card');
      const main = create('div', 'vendor-order-card-main');

      const top = create('div', 'vendor-order-top');
      const id = create('strong', '', '#' + order.id);
      const chip = create('span', orderStatusClass(order.status), orderStatusLabel(order.status));
      const dot = create('i');
      chip.prepend(dot);
      append(top, id, chip);

      const service = create('div', 'vendor-order-service');
      service.textContent = order.vendor_name + ' · ' + order.option_name;

      const meta = create('div', 'vendor-order-meta');
      append(
        meta,
        create('span', '', 'Qty ' + (Number(order.quantity) || 1)),
        create('span', '', formatPrice(order.total_price)),
        create('span', '', new Date(order.created_at).toLocaleString('en-IN', {
          hour: '2-digit',
          minute: '2-digit',
          day: '2-digit',
          month: 'short'
        }))
      );

      append(main, top, service, meta);
      append(card, main);

      const actions = {
        placed: ['Accept', 'preparing'],
        accepted: ['Mark ready', 'ready'],
        preparing: ['Mark ready', 'ready']
      };

      const next = actions[order.status];
      if (next && currentServiceStatus !== 'offline') {
        const action = create('button', 'vendor-order-action', next[0]);
        action.type = 'button';
        action.dataset.orderId = order.id;
        action.dataset.nextStatus = next[1];
        action.addEventListener('click', async () => {
          action.disabled = true;
          action.textContent = 'Saving…';

          try {
            const response = await fetch('/__campusmaas/update-order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: order.id, status: next[1] })
            });

            if (!response.ok) throw new Error('Order update failed.');

            order.status = next[1];
            render();
          } catch {
            action.disabled = false;
            action.textContent = next[0];
          }
        });
        append(card, action);
      }

      return card;
    };

    const makeFoodOrderCard = (order, currentServiceStatus = 'online') => {
      const card = create('article', 'vendor-order-card vendor-food-order-card');

      const top = create('div', 'vendor-order-top');
      const id = create('strong', '', '#' + order.id);
      const chip = create('span', orderStatusClass(order.status), orderStatusLabel(order.status));
      const dot = create('i');
      chip.prepend(dot);
      append(top, id, chip);

      const items = create('div', 'vendor-food-order-items');
      const foodItems = Array.isArray(order.items) ? order.items : [];

      foodItems.forEach((item) => {
        const row = create('div', 'vendor-food-order-item');
        append(
          row,
          create('span', 'vendor-food-order-item-name', item.menu_item_name || item.name || 'Food item'),
          create('span', 'vendor-food-order-item-count', '× ' + (Number(item.quantity) || 1))
        );
        items.appendChild(row);
      });

      if (!foodItems.length) {
        items.appendChild(
          create('div', 'vendor-food-order-empty', 'No food items listed.')
        );
      }

      append(card, top, items);

      const actions = {
        placed: ['Accept', 'preparing'],
        accepted: ['Mark ready', 'ready'],
        preparing: ['Mark ready', 'ready']
      };

      const next = actions[order.status];
      if (next && currentServiceStatus !== 'offline') {
        const action = create('button', 'vendor-order-action', next[0]);
        action.type = 'button';
        action.dataset.orderId = order.id;
        action.dataset.nextStatus = next[1];
        action.addEventListener('click', async () => {
          action.disabled = true;
          action.textContent = 'Saving…';

          try {
            const response = await fetch('/__campusmaas/update-order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: order.id, status: next[1] })
            });

            if (!response.ok) throw new Error('Order update failed.');

            order.status = next[1];
            render();
          } catch {
            action.disabled = false;
            action.textContent = next[0];
          }
        });
        append(card, action);
      }

      return card;
    };

    const saveServiceStatus = async (item, child, value) => {
      const nextCatalogue = structuredClone(state.catalogue);
      const targetVendor = nextCatalogue.vendors.find((v) => String(v.id) === String(item.id));
      const target = targetVendor?.options?.find((o) => String(o.id) === String(child.id));
      if (!target) throw new Error('Service not found.');
      target.status = value;
      target.status_message = value === 'offline' ? 'Currently unavailable' : value === 'busy' ? 'Currently serving customers' : 'Accepting new orders';
      const response = await fetch('/__campusmaas/save-vendors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(nextCatalogue)
      });
      if (!response.ok) throw new Error('Status update failed.');
      state.catalogue = nextCatalogue;
    };

    const renderDetail = (item, child) => {
      const allOrders = state.orders.orders.filter(
        (order) =>
          String(order.vendor_id) === String(item.id) &&
          String(order.option_id) === String(child.id)
      );

      const active = allOrders.filter((order) =>
        ['placed', 'accepted', 'preparing'].includes(String(order.status || '').toLowerCase())
      );

      const stats = {
        active: active.length,
        placed: active.filter((order) => order.status === 'placed').length,
        preparing: active.filter((order) => ['accepted', 'preparing'].includes(order.status)).length,
        ready: active.filter((order) => order.status === 'ready').length
      };
      const serviceStatus = String(child.status || 'online').toLowerCase();
      const serviceStatusMessage = child.status_message || (
        serviceStatus === 'offline' ? 'Currently unavailable' :
        serviceStatus === 'busy' ? 'Currently serving customers' : 'Accepting new orders'
      );

      kicker.textContent = String(item.name).toUpperCase();
      title.textContent = child.name;
      headerTitle.textContent = child.name;
      subtitle.textContent = 'Vendor dashboard';
      back.href = route(item.id);
      ordersVendorId = String(item.id);
      ordersVendorName = String(item.name || 'Vendor');
      ordersOptionId = String(child.id);
      printQueueButton.hidden = false;
      updateOrdersButton();
      closePrintQueue();

      headerServiceControl.hidden = false;
      headerStatusMessage.textContent = serviceStatusMessage;
      headerStatusChoices.forEach((button) => {
        button.classList.toggle('is-active', String(button.dataset.status) === serviceStatus);
        button.disabled = false;
      });

      content.className = 'vendor-content-grid vendor-dashboard-grid';
      content.innerHTML = '';

      const overview = create('section', 'vendor-dashboard-overview');
      const dashboardTitle = create('div', 'vendor-dashboard-title');
      append(
        dashboardTitle,
        create('div', 'vendor-service-icon', iconLetter(item.id)),
        create('div')
      );
      const titleBox = dashboardTitle.lastChild;
      append(
        titleBox,
        create('span', '', 'VENDOR SERVICE'),
        create('strong', item.name + ' · ' + child.name)
      );

      const statGrid = create('div', 'vendor-stat-grid');
      [
        ['Active', stats.active],
        ['Placed', stats.placed],
        ['Preparing', stats.preparing],
        ['Ready', stats.ready]
      ].forEach((entry) => {
        const box = create('div');
        append(box, create('span', '', entry[0]), create('strong', '', String(entry[1])));
        statGrid.appendChild(box);
      });

      const facts = create('div', 'vendor-service-facts');
      append(
        facts,
        create('span', '', 'Service time ' + (Number(child.service_minutes) || 0) + ' min'),
        create('span', '', 'Price ' + formatPrice(child.price))
      );

      append(overview, dashboardTitle, statGrid, facts);
      content.appendChild(overview);

      const live = create('section', 'vendor-dashboard-orders');
      append(
        live,
        makeHeader('LIVE QUEUE', 'Orders', active.length + ' active')
      );

      const ordersGrid = create('div', 'vendor-orders-grid');
      active.forEach((order) => ordersGrid.appendChild(makeOrderCard(order, serviceStatus)));
      if (!active.length) {
        ordersGrid.appendChild(create('div', 'vendor-empty-card', 'No active orders for this service.'));
      }
      live.appendChild(ordersGrid);
      content.appendChild(live);

      const rightColumn = create('div', 'vendor-dashboard-side-column');

      const waiting = create('section', 'vendor-history-card vendor-waiting-card');
      const readyOrders = allOrders.filter(
        (order) => String(order.status || '').toLowerCase() === 'ready'
      );

      append(
        waiting,
        makeHeader('WAITING', 'Waiting for confirmation', String(readyOrders.length))
      );

      const waitingList = create('div', 'vendor-history-list');
      readyOrders.forEach((order) => {
        const row = create('div', 'vendor-history-row vendor-waiting-row');
        append(
          row,
          create('span', '', '#' + order.id),
          create('span', '', order.vendor_name + ' · ' + order.option_name),
          create('span', '', 'Ready · ' + new Date(order.created_at).toLocaleTimeString('en-IN', {
            hour: '2-digit',
            minute: '2-digit'
          }))
        );
        const chip = create('span', 'vendor-status-chip status-ready', 'Waiting');
        chip.prepend(create('i'));
        row.appendChild(chip);
        waitingList.appendChild(row);
      });

      if (!readyOrders.length) {
        waitingList.appendChild(
          create('div', 'vendor-empty-card', 'No orders are waiting for user confirmation.')
        );
      }

      waiting.appendChild(waitingList);
      rightColumn.appendChild(waiting);

      const history = create('section', 'vendor-history-card');
      const completed = allOrders.filter((order) => order.status === 'completed').slice(0, 8);
      append(
        history,
        makeHeader('RECENT', 'Completed orders', String(completed.length))
      );

      const historyList = create('div', 'vendor-history-list');
      completed.forEach((order) => {
        const row = create('div', 'vendor-history-row');
        append(
          row,
          create('span', '', '#' + order.id),
          create('span', '', 'Qty ' + (Number(order.quantity) || 1)),
          create('span', '', new Date(order.created_at).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }))
        );
        const chip = create('span', 'vendor-status-chip status-completed', 'Completed');
        chip.prepend(create('i'));
        row.appendChild(chip);
        historyList.appendChild(row);
      });

      if (!completed.length) {
        historyList.appendChild(create('div', 'vendor-empty-card', 'No completed orders yet.'));
      }

      history.appendChild(historyList);
      rightColumn.appendChild(history);
      content.appendChild(rightColumn);
    };

    headerStatusChoices.forEach((button) => {
      button.addEventListener('click', async (event) => {
        event.preventDefault();
        if (headerServiceControl.hidden || button.classList.contains('is-active')) return;
        const value = String(button.dataset.status || '').toLowerCase();
        const item = vendor(vendorId);
        const child = option(item, optionId);
        if (!item || !child) return;
        headerStatusChoices.forEach((choice) => { choice.disabled = true; });
        try {
          await saveServiceStatus(item, child, value);
          render();
        } catch {
          headerStatusChoices.forEach((choice) => { choice.disabled = false; });
        }
      });
    });

    const render = () => {
      if (pageKind === 'root') {
        renderRoot();
        return;
      }

      const item = vendor(vendorId);
      if (!item) {
        title.textContent = 'Vendor not found';
        subtitle.textContent = 'The configured vendor does not exist.';
        content.className = 'vendor-content-grid';
        content.innerHTML = '';
        content.appendChild(create('div', 'vendor-empty-card', 'Vendor not found.'));
        return;
      }

      if (pageKind === 'category') {
        renderCategory(item);
        return;
      }

      const child = option(item, optionId);
      if (!child) {
        title.textContent = 'Service not found';
        subtitle.textContent = 'The configured vendor service does not exist.';
        content.className = 'vendor-content-grid';
        content.innerHTML = '';
        content.appendChild(create('div', 'vendor-empty-card', 'Service not found.'));
        return;
      }

      renderDetail(item, child);
    };

    printQueueButton?.addEventListener('click', openPrintQueue);
    printQueueClose?.addEventListener('click', closePrintQueue);
    printQueueBackdrop?.addEventListener('click', closePrintQueue);

    const printAllOrders = () => {
      const orders = printableOrders();
      if (!orders.length) return;
      orders.forEach((order) => {
        const entries = (order.files || []).map((file, index) => ({ file, index }));
        openPrintBatch(order, entries, 'All pending print jobs');
      });
    };

    printQueueAll?.addEventListener('click', printAllOrders);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && printQueue && !printQueue.hidden) {
        closePrintQueue();
      }
    });

    const start = async () => {
      try {
        await loadData();
        render();
      } catch {
        title.textContent = 'Vendor portal unavailable';
        subtitle.textContent = 'Check the CampusMaaS vendor data.';
        content.className = 'vendor-content-grid';
        content.innerHTML = '';
        content.appendChild(create('div', 'vendor-empty-card', 'Vendor data could not be loaded.'));
      }
    };

    void start();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVendorPortal, { once: true });
  } else {
    initVendorPortal();
  }
</script>

