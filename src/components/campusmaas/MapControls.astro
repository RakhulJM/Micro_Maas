---
---

<div class="map-controls" aria-label="Map controls">
  <button type="button" data-map-action="zoom-in" aria-label="Zoom in">+</button>
  <button type="button" data-map-action="zoom-out" aria-label="Zoom out">−</button>
</div>
<button
  class="path-toggle"
  id="pathToggle"
  type="button"
  aria-label="Highlight pedestrian paths"
  aria-pressed="false"
  title="Highlight pedestrian paths"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M7 4v4c0 3 10 2 10 6v6" />
    <circle cx="7" cy="4" r="1.7" />
    <circle cx="17" cy="20" r="1.7" />
  </svg>
</button>
<button
  class="route-toggle"
  id="routeToggle"
  type="button"
  aria-label="Test walking route"
  aria-pressed="false"
  title="Test walking route"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="6" cy="18" r="2.2" />
    <circle cx="18" cy="6" r="2.2" />
    <path d="M8 16c2.5-2 3-6 4.5-7.5C14 7 15.5 8 18 6" />
  </svg>
</button>
<button
  class="gate-toggle"
  id="gateToggle"
  type="button"
  aria-label="Edit campus gates"
  aria-pressed="false"
  title="Edit campus gates"
  aria-hidden="true"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <rect x="5" y="4" width="14" height="16" rx="1.5" />
    <path d="M9 4v16M15 4v16M5 9h4M15 9h4M5 15h4M15 15h4" />
  </svg>
</button>
<button
  class="edit-toggle"
  id="editToggle"
  type="button"
  aria-label="Edit pedestrian paths"
  aria-pressed="false"
  title="Edit pedestrian paths"
  aria-hidden="true"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 20l4.5-1 10.2-10.2a2.1 2.1 0 0 0-3-3L5.5 16 4 20z" />
    <path d="M13.8 7.2l3 3" />
  </svg>
</button>
